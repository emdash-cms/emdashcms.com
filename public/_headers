# Fingerprinted assets emitted by Astro (JS, CSS, fonts, images, etc.)
# Filenames include a content hash, so they're safe to cache forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Agent discovery files. They hold public, read-only metadata, so agents
# running in a browser on any origin may read them. Agent skills keep the
# default revalidating Cache-Control, so the index's digests always match
# the skill files served next to it.
/.well-known/*
  Access-Control-Allow-Origin: *

# AI Catalog: https://github.com/Agent-Card/ai-catalog
/.well-known/ai-catalog.json
  Content-Type: application/ai-catalog+json
  Cache-Control: public, max-age=3600

# MCP Server Card for the docs MCP server, listed in the AI Catalog.
# https://github.com/modelcontextprotocol/experimental-ext-server-card
/.well-known/mcp/server-card.json
  Content-Type: application/mcp-server-card+json
  Cache-Control: public, max-age=3600
