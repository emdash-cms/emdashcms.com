---
interface Props {
	prompt: string;
}

const { prompt } = Astro.props;
---

<div class="copy-prompt">
	<button
		type="button"
		class="copy-prompt-button"
		aria-label="Copy a prompt to build an EmDash site with your agent"
		data-copy-prompt-button
		data-prompt={prompt}
	>
		<span class="copy-prompt-logos" aria-hidden="true">
			<svg viewBox="0 0 256 257">
				<path fill="#D97757" d="m50.228 170.321 50.357-28.257.843-2.463-.843-1.361h-2.462l-8.426-.518-28.775-.778-24.952-1.037-24.175-1.296-6.092-1.297L0 125.796l.583-3.759 5.12-3.434 7.324.648 16.202 1.101 24.304 1.685 17.629 1.037 26.118 2.722h4.148l.583-1.685-1.426-1.037-1.101-1.037-25.147-17.045-27.22-18.017-14.258-10.37-7.713-5.25-3.888-4.925-1.685-10.758 7-7.713 9.397.649 2.398.648 9.527 7.323 20.35 15.75L94.817 91.9l3.889 3.24 1.555-1.102.195-.777-1.75-2.917-14.453-26.118-15.425-26.572-6.87-11.018-1.814-6.61c-.648-2.723-1.102-4.991-1.102-7.778l7.972-10.823L71.42 0 82.05 1.426l4.472 3.888 6.61 15.101 10.694 23.786 16.591 32.34 4.861 9.592 2.592 8.879.973 2.722h1.685v-1.556l1.36-18.211 2.528-22.36 2.463-28.776.843-8.1 4.018-9.722 7.971-5.25 6.222 2.981 5.12 7.324-.713 4.73-3.046 19.768-5.962 30.98-3.889 20.739h2.268l2.593-2.593 10.499-13.934 17.628-22.036 7.778-8.749 9.073-9.657 5.833-4.601h11.018l8.1 12.055-3.628 12.443-11.342 14.388-9.398 12.184-13.48 18.147-8.426 14.518.778 1.166 2.01-.194 30.46-6.481 16.462-2.982 19.637-3.37 8.88 4.148.971 4.213-3.5 8.62-20.998 5.184-24.628 4.926-36.682 8.685-.454.324.519.648 16.526 1.555 7.065.389h17.304l32.21 2.398 8.426 5.574 5.055 6.805-.843 5.184-12.962 6.611-17.498-4.148-40.83-9.721-14-3.5h-1.944v1.167l11.666 11.406 21.387 19.314 26.767 24.887 1.36 6.157-3.434 4.86-3.63-.518-23.526-17.693-9.073-7.972-20.545-17.304h-1.36v1.814l4.73 6.935 25.017 37.59 1.296 11.536-1.814 3.76-6.481 2.268-7.13-1.297-14.647-20.544-15.1-23.138-12.185-20.739-1.49.843-7.194 77.448-3.37 3.953-7.778 2.981-6.48-4.925-3.436-7.972 3.435-15.749 4.148-20.544 3.37-16.333 3.046-20.285 1.815-6.74-.13-.454-1.49.194-15.295 20.999-23.267 31.433-18.406 19.702-4.407 1.75-7.648-3.954.713-7.064 4.277-6.286 25.47-32.405 15.36-20.092 9.917-11.6-.065-1.686h-.583L44.07 198.125l-12.055 1.555-5.185-4.86.648-7.972 2.463-2.593 20.35-13.999-.064.065Z"></path>
			</svg>
			<svg viewBox="0 0 24 24" fill="currentColor" fill-rule="evenodd">
				<path clip-rule="evenodd" d="M8.086.457a6.105 6.105 0 013.046-.415c1.333.153 2.521.72 3.564 1.7a.117.117 0 00.107.029c1.408-.346 2.762-.224 4.061.366l.063.03.154.076c1.357.703 2.33 1.77 2.918 3.198.278.679.418 1.388.421 2.126a5.655 5.655 0 01-.18 1.631.167.167 0 00.04.155 5.982 5.982 0 011.578 2.891c.385 1.901-.01 3.615-1.183 5.14l-.182.22a6.063 6.063 0 01-2.934 1.851.162.162 0 00-.108.102c-.255.736-.511 1.364-.987 1.992-1.199 1.582-2.962 2.462-4.948 2.451-1.583-.008-2.986-.587-4.21-1.736a.145.145 0 00-.14-.032c-.518.167-1.04.191-1.604.185a5.924 5.924 0 01-2.595-.622 6.058 6.058 0 01-2.146-1.781c-.203-.269-.404-.522-.551-.821a7.74 7.74 0 01-.495-1.283 6.11 6.11 0 01-.017-3.064.166.166 0 00.008-.074.115.115 0 00-.037-.064 5.958 5.958 0 01-1.38-2.202 5.196 5.196 0 01-.333-1.589 6.915 6.915 0 01.188-2.132c.45-1.484 1.309-2.648 2.577-3.493.282-.188.55-.334.802-.438.286-.12.573-.22.861-.304a.129.129 0 00.087-.087A6.016 6.016 0 015.635 2.31C6.315 1.464 7.132.846 8.086.457zm-.804 7.85a.848.848 0 00-1.473.842l1.694 2.965-1.688 2.848a.849.849 0 001.46.864l1.94-3.272a.849.849 0 00.007-.854l-1.94-3.393zm5.446 6.24a.849.849 0 000 1.695h4.848a.849.849 0 000-1.696h-4.848z"></path>
			</svg>
			<svg viewBox="0 0 466.73 532.09" fill="currentColor">
				<path d="M457.43,125.94L244.42,2.96c-6.84-3.95-15.28-3.95-22.12,0L9.3,125.94c-5.75,3.32-9.3,9.46-9.3,16.11v247.99c0,6.65,3.55,12.79,9.3,16.11l213.01,122.98c6.84,3.95,15.28,3.95,22.12,0l213.01-122.98c5.75-3.32,9.3-9.46,9.3-16.11v-247.99c0-6.65-3.55-12.79-9.3-16.11h-.01ZM444.05,151.99l-205.63,356.16c-1.39,2.4-5.06,1.42-5.06-1.36v-233.21c0-4.66-2.49-8.97-6.53-11.31L24.87,145.67c-2.4-1.39-1.42-5.06,1.36-5.06h411.26c5.84,0,9.49,6.33,6.57,11.39h-.01Z"></path>
			</svg>
			<svg viewBox="0 0 32 40" fill="currentColor">
				<path d="M24 32H8V16H24V32Z" fill-opacity="0.3"></path>
				<path d="M24 8H8V32H24V8ZM32 40H0V0H32V40Z"></path>
			</svg>
		</span>
		<span class="copy-prompt-labels" data-copy-prompt-labels aria-hidden="true">
			<span class="copy-prompt-label copy-prompt-label--default" data-copy-prompt-label-default>Copy prompt</span>
			<span class="copy-prompt-label" data-copy-prompt-label-copied>Copied</span>
			<span class="copy-prompt-label" data-copy-prompt-label-failed>Try again</span>
		</span>
	</button>
	<span class="copy-prompt-status" role="status" data-copy-prompt-status></span>
</div>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-copy-prompt-button]").forEach((button) => {
		const status = button.parentElement?.querySelector<HTMLElement>("[data-copy-prompt-status]");
		if (!status) return;
		const feedback = button.closest("[data-copy-prompt-root]")?.querySelector<HTMLElement>("[data-copy-prompt-feedback]");
		const preview = feedback?.querySelector<HTMLElement>("[data-copy-prompt-preview]");
		const copied = feedback?.querySelector<HTMLElement>("[data-copy-prompt-copied]");
		const failed = feedback?.querySelector<HTMLElement>("[data-copy-prompt-failed]");
		const labels = button.querySelector<HTMLElement>("[data-copy-prompt-labels]");
		const defaultLabel = button.querySelector<HTMLElement>("[data-copy-prompt-label-default]");
		const copiedLabel = button.querySelector<HTMLElement>("[data-copy-prompt-label-copied]");
		const failedLabel = button.querySelector<HTMLElement>("[data-copy-prompt-label-failed]");
		let hovered = false;
		let keyboardFocused = false;
		let copyState: "idle" | "copied" | "failed" = "idle";
		const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
		const shown = new WeakMap<HTMLElement, boolean>();
		const exitTimers = new WeakMap<HTMLElement, number>();
		if (defaultLabel) shown.set(defaultLabel, true);
		const show = (element: HTMLElement | null | undefined, visible: boolean, delay = 0) => {
			if (!element) return;
			if ((shown.get(element) ?? false) === visible) return;
			shown.set(element, visible);
			const exitTimer = exitTimers.get(element);
			if (exitTimer !== undefined) window.clearTimeout(exitTimer);

			if (reducedMotion) {
				element.style.transition = "none";
				element.style.opacity = visible ? "1" : "0";
				element.style.transform = "none";
				element.style.filter = "none";
			} else if (visible) {
				const ease = "cubic-bezier(0.22, 1, 0.36, 1)";
				element.style.transition = ["opacity", "transform", "filter"]
					.map((property) => `${property} 500ms ${ease} ${delay}ms`)
					.join(", ");
				element.style.opacity = "1";
				element.style.transform = "translateY(0)";
				element.style.filter = "blur(0)";
			} else {
				element.style.transition = "opacity 200ms ease, transform 0s linear, filter 0s linear";
				element.style.opacity = "0";
				element.style.transform = "translateY(0)";
				element.style.filter = "blur(0)";
				exitTimers.set(element, window.setTimeout(() => {
					if (shown.get(element) === false) {
						element.style.transition = "none";
						element.style.transform = "translateY(12px)";
						element.style.filter = "blur(3px)";
					}
				}, 200));
			}

			if (element === preview) element.setAttribute("aria-hidden", String(!visible));
		};
		const resizeActiveLabel = () => {
			const activeLabel = copyState === "copied" ? copiedLabel : copyState === "failed" ? failedLabel : defaultLabel;
			if (labels && activeLabel) labels.style.inlineSize = `${activeLabel.scrollWidth}px`;
		};
		const updateFeedback = () => {
			show(preview, copyState === "idle" && (hovered || keyboardFocused), 40);
			show(copied, copyState === "copied", 40);
			show(failed, copyState === "failed", 40);
			show(defaultLabel, copyState === "idle");
			show(copiedLabel, copyState === "copied");
			show(failedLabel, copyState === "failed");
			resizeActiveLabel();
		};
		resizeActiveLabel();
		void document.fonts?.ready.then(resizeActiveLabel);

		button.addEventListener("pointerenter", () => {
			hovered = true;
			updateFeedback();
		});
		button.addEventListener("pointerleave", () => {
			hovered = false;
			updateFeedback();
		});
		button.addEventListener("focus", () => {
			keyboardFocused = button.matches(":focus-visible");
			updateFeedback();
		});
		button.addEventListener("blur", () => {
			keyboardFocused = false;
			updateFeedback();
		});

		let resetTimer: number | undefined;
		button.addEventListener("click", async () => {
			window.clearTimeout(resetTimer);
			status.textContent = "";
			copyState = "idle";
			updateFeedback();

			try {
				const prompt = button.dataset.prompt;
				if (!prompt || !navigator.clipboard?.writeText) throw new Error("Clipboard unavailable");
				await navigator.clipboard.writeText(prompt);
				copyState = "copied";
				status.textContent = "Prompt copied. Paste it into your coding agent to begin.";
			} catch {
				copyState = "failed";
				status.textContent = "Could not copy the prompt. Try again.";
			}
			updateFeedback();

			resetTimer = window.setTimeout(() => {
				copyState = "idle";
				status.textContent = "";
				updateFeedback();
			}, 4000);
		});
	});
</script>

<style>
	.copy-prompt {
		position: relative;
		display: inline-flex;
		width: 100%;
	}

	.copy-prompt-button {
		display: inline-flex;
		width: 100%;
		min-height: 48px;
		align-items: center;
		justify-content: center;
		gap: 0.75rem;
		padding: 0 1.25rem;
		color: var(--color-bg);
		background: var(--color-text);
		border: 0;
		border-radius: var(--radius-full);
		box-shadow:
			0 0 0 1px var(--color-text),
			0 1px 3px rgba(0, 0, 0, 0.12);
		font: inherit;
		font-size: var(--font-size-base);
		font-weight: 500;
		white-space: nowrap;
		cursor: copy;
	}

	.copy-prompt-button:hover {
		background: color-mix(in srgb, var(--color-text) 86%, var(--color-bg));
	}

	.copy-prompt-logos {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.25rem;
	}

	.copy-prompt-logos svg {
		width: 1.125rem;
		height: 1.125rem;
		flex: 0 0 auto;
	}

	.copy-prompt-logos svg:last-child {
		width: 0.9rem;
	}

	.copy-prompt-labels {
		display: inline-grid;
		min-inline-size: 0;
		align-items: center;
		justify-items: start;
	}

	.copy-prompt-label {
		grid-area: 1 / 1;
		white-space: nowrap;
		opacity: 0;
		filter: blur(3px);
		transform: translateY(12px);
	}

	.copy-prompt-label--default {
		opacity: 1;
		filter: none;
		transform: none;
	}

	.copy-prompt-status {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	:global(:root.dark) .copy-prompt-button {
		color: var(--color-text);
		background: var(--color-bg);
		box-shadow: 0 0 0 1px var(--color-border);
	}

	:global(:root.dark) .copy-prompt-button:hover {
		background: var(--color-surface);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .copy-prompt-button {
			color: var(--color-text);
			background: var(--color-bg);
			box-shadow: 0 0 0 1px var(--color-border);
		}

		:global(:root:not(.light)) .copy-prompt-button:hover {
			background: var(--color-surface);
		}
	}

	@media (min-width: 640px) {
		.copy-prompt {
			width: auto;
		}
	}

	@media (prefers-reduced-motion: no-preference) {
		.copy-prompt-labels {
			transition: inline-size 500ms cubic-bezier(0.22, 1, 0.36, 1);
		}
	}
</style>
