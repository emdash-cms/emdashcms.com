---
import { Image } from "astro:assets";
import editorDark from "../../public/landing/proof/post-editor-dark.png";
import editorLight from "../../public/landing/proof/post-editor-light.png";
import siteDark from "../../public/landing/proof/site-dark.png";
import siteLight from "../../public/landing/proof/site-light.png";
---

<div class="product-proof">
	<figure class="proof-editor">
		<figcaption>
			<span class="proof-step">01 / In EmDash</span>
			<span class="proof-title">Edit “EmDash is live”</span>
		</figcaption>
		<Image
			src={editorLight}
			alt="The real EmDash editor showing the title, content, and published status of the EmDash is live post"
			class="proof-image proof-image--light"
			widths={[640, 960, 1200]}
			sizes="(max-width: 640px) 960px, (min-width: 1140px) 1096px, calc(100vw - 32px)"
			loading="eager"
			fetchpriority="high"
		/>
		<Image
			src={editorDark}
			alt="The real EmDash editor showing the title, content, and published status of the EmDash is live post"
			class="proof-image proof-image--dark"
			widths={[640, 960, 1200]}
			sizes="(max-width: 640px) 960px, (min-width: 1140px) 1096px, calc(100vw - 32px)"
			loading="eager"
			fetchpriority="high"
		/>
	</figure>
	<a class="proof-site" href="/blog/emdash-is-live" aria-label="Read the published post: EmDash is live">
		<span class="proof-site-heading" aria-hidden="true">
			<span class="proof-step">02 / On the site</span>
			<span class="proof-title">Read the published post <span class="proof-arrow">↗</span></span>
		</span>
		<Image
			src={siteLight}
			alt=""
			class="proof-image proof-image--light"
			widths={[320, 480, 780]}
			sizes="(min-width: 640px) 420px, calc(100vw - 32px)"
			loading="eager"
		/>
		<Image
			src={siteDark}
			alt=""
			class="proof-image proof-image--dark"
			widths={[320, 480, 780]}
			sizes="(min-width: 640px) 420px, calc(100vw - 32px)"
			loading="eager"
		/>
	</a>
</div>

<style>
	.product-proof {
		position: relative;
		isolation: isolate;
	}

	.proof-editor,
	.proof-site {
		overflow: hidden;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow:
			0 0 0 4px var(--border-faint),
			0 20px 24px -4px rgba(0, 0, 0, 0.1),
			0 8px 8px -4px rgba(0, 0, 0, 0.04);
	}

	.proof-editor {
		margin: 0;
	}

	.proof-editor figcaption,
	.proof-site-heading {
		display: flex;
		min-height: 3.5rem;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 1.25rem;
		border-bottom: 1px solid var(--color-border);
	}

	.proof-step {
		color: var(--color-primary);
		font-size: var(--font-size-xs);
		font-weight: 600;
		white-space: nowrap;
	}

	.proof-title {
		font-size: var(--font-size-sm);
		font-weight: 500;
		white-space: nowrap;
	}

	.proof-arrow {
		margin-inline-start: 0.25rem;
	}

	.proof-image {
		display: block;
		width: 100%;
		height: auto;
	}

	.proof-image--dark {
		display: none;
	}

	.proof-site {
		position: absolute;
		z-index: 1;
		inset-inline-end: 1.5rem;
		inset-block-start: 18%;
		width: min(37%, 25rem);
		color: var(--color-text);
		transition: transform 150ms ease;
	}

	.proof-site:hover {
		transform: translateY(-4px);
	}

	.proof-site:focus-visible {
		outline: 3px solid var(--color-focus);
		outline-offset: 4px;
	}

	:global(:root.dark) .proof-image--light {
		display: none;
	}

	:global(:root.dark) .proof-image--dark {
		display: block;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .proof-image--light {
			display: none;
		}

		:global(:root:not(.light)) .proof-image--dark {
			display: block;
		}
	}

	@media (min-width: 641px) and (max-width: 1000px) {
		.proof-site {
			width: min(48%, 25rem);
		}
	}

	@media (min-width: 641px) and (max-width: 760px) {
		.proof-site-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25rem;
		}
	}

	@media (max-width: 640px) {
		.product-proof {
			display: grid;
			gap: 1rem;
		}

		.proof-editor figcaption,
		.proof-site-heading {
			padding-inline: 1rem;
		}

		.proof-editor {
			max-height: 31rem;
		}

		.proof-editor .proof-image {
			width: 250%;
			max-width: none;
			transform: translateX(-22%);
		}

		.proof-site {
			position: static;
			width: 100%;
		}
	}

	@media (max-width: 420px) {
		.proof-editor figcaption,
		.proof-site-heading {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.proof-site {
			transition: none;
		}

		.proof-site:hover {
			transform: none;
		}
	}
</style>
