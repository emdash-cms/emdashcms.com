---
interface MenuItem {
	label: string;
	url: string;
	target?: string | null;
}

interface SiteLogo {
	url: string;
	alt?: string | null;
}

interface Props {
	siteTitle: string;
	siteLogo?: SiteLogo | null;
	menuItems: MenuItem[];
	playgroundUrl: string;
	githubStars?: string;
	githubStarsLabel?: string;
}

const {
	siteTitle,
	siteLogo,
	menuItems,
	playgroundUrl,
	githubStars = "11K",
	githubStarsLabel = "11,000",
} = Astro.props;

function isExternalUrl(url?: string | null) {
	return typeof url === "string" && /^https?:\/\//.test(url);
}

function isGitHubItem(item: MenuItem) {
	return item.label.toLowerCase() === "github" || item.url.includes("github.com");
}

const githubItem = menuItems.find(isGitHubItem);
const navItems = menuItems.filter((item) => !isGitHubItem(item));
---

<header class="site-header" data-site-header data-scrolled="false">
	<nav class="site-nav" data-site-nav data-state="closed" aria-label="Primary navigation">
		<div class="site-nav-shell">
			<div class="site-nav-inner">
				<div class="site-brand-row">
					<a href="/" class="site-logo" aria-label={siteTitle} data-menu-close>
						{siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="site-logo-img" />
						) : (
							<>
								<img
									src="/brand/logo-dark-text.svg"
									alt={siteTitle}
									class="site-logo-img site-logo-img--light"
								/>
								<img
									src="/brand/logo-light-text.svg"
									alt={siteTitle}
									class="site-logo-img site-logo-img--dark"
								/>
							</>
						)}
					</a>

					<button
						type="button"
						class="nav-toggle"
						aria-label="Open menu"
						aria-expanded="false"
						aria-controls="site-nav-panel"
						data-menu-toggle
					>
						<svg class="nav-toggle-icon nav-toggle-icon--menu" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M4 7h16M4 12h16M4 17h16" />
						</svg>
						<svg class="nav-toggle-icon nav-toggle-icon--close" viewBox="0 0 24 24" aria-hidden="true">
							<path d="m6 6 12 12M18 6 6 18" />
						</svg>
					</button>
				</div>

				{navItems.length > 0 && (
					<div class="nav-center" aria-hidden="false">
						<ul>
							{navItems.map((item) => (
								<li>
									<a
										href={item.url}
										target={item.target || (isExternalUrl(item.url) ? "_blank" : undefined)}
										rel={isExternalUrl(item.url) ? "noreferrer" : undefined}
									>
										{item.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				)}

				<div class="nav-panel" id="site-nav-panel" data-nav-panel>
					{navItems.length > 0 && (
						<div class="nav-mobile-links">
							<ul>
								{navItems.map((item) => (
									<li>
										<a
											href={item.url}
											target={item.target || (isExternalUrl(item.url) ? "_blank" : undefined)}
											rel={isExternalUrl(item.url) ? "noreferrer" : undefined}
											data-menu-close
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					)}

					<div class="nav-actions">
						{githubItem && (
							<a
								href={githubItem.url}
								class="nav-action nav-action--github"
								target={githubItem.target || (isExternalUrl(githubItem.url) ? "_blank" : undefined)}
					rel={isExternalUrl(githubItem.url) ? "noreferrer" : undefined}
					aria-label={`EmDash GitHub repository, ${githubStarsLabel} stars`}
					data-menu-close
				>
								<svg viewBox="0 0 20 20" aria-hidden="true" class="github-icon">
									<path
										fill="currentColor"
										fill-rule="evenodd"
										clip-rule="evenodd"
										d="M9.98 2C5.57 2 2 5.59 2 10.04c0 3.55 2.28 6.55 5.45 7.62c.4.08.54-.17.54-.39c0-.19-.01-.82-.01-1.49c-2.22.48-2.68-.96-2.68-.96c-.36-.93-.88-1.17-.88-1.17c-.73-.49.05-.49.05-.49c.81.05 1.23.82 1.23.82c.71 1.22 1.86.88 2.32.66c.07-.52.28-.88.5-1.08c-1.77-.19-3.63-.88-3.63-3.96c0-.88.32-1.6.82-2.16c-.08-.2-.36-1.03.08-2.13c0 0 .67-.21 2.19.82a7.6 7.6 0 0 1 1.99-.27c.67 0 1.36.09 1.99.27c1.52-1.04 2.19-.82 2.19-.82c.44 1.1.16 1.93.08 2.13c.52.56.82 1.28.82 2.16c0 3.09-1.86 3.77-3.64 3.96c.29.25.54.73.54 1.49c0 1.08-.01 1.94-.01 2.21c0 .21.15.47.54.39A8.04 8.04 0 0 0 17.94 10.04C17.95 5.59 14.37 2 9.98 2Z"
									/>
								</svg>
								<span>{githubStars}</span>
							</a>
						)}
						<a href={playgroundUrl} class="nav-action nav-action--primary" target="_blank" rel="noreferrer" data-menu-close>
							Try it
						</a>
					</div>
				</div>
			</div>
		</div>
	</nav>
</header>

<script is:inline>
	(() => {
		const header = document.querySelector("[data-site-header]");
		const nav = document.querySelector("[data-site-nav]");
		const toggle = document.querySelector("[data-menu-toggle]");
		if (!header || !nav || !toggle) return;

		const setOpen = (open) => {
			nav.dataset.state = open ? "active" : "closed";
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
		};

		const updateScrolled = () => {
			header.dataset.scrolled = window.scrollY > 50 ? "true" : "false";
		};

		toggle.addEventListener("click", () => {
			setOpen(nav.dataset.state !== "active");
		});

		document.querySelectorAll("[data-menu-close]").forEach((item) => {
			item.addEventListener("click", () => setOpen(false));
		});

		window.addEventListener("scroll", updateScrolled, { passive: true });
		window.addEventListener("resize", () => {
			if (window.innerWidth >= 960) setOpen(false);
		});
		window.addEventListener("keydown", (event) => {
			if (event.key === "Escape") setOpen(false);
		});

		updateScrolled();
	})();
</script>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		padding: 0 8px;
		pointer-events: none;
	}

	.site-nav {
		pointer-events: auto;
	}

	.site-nav-shell {
		max-width: var(--wide-width);
		margin: 8px auto 0;
		padding: 0 var(--spacing-lg);
		border: 1px solid transparent;
		border-radius: 0;
		transition:
			max-width var(--transition-slow),
			padding var(--transition-slow),
			border-color var(--transition-slow),
			border-radius var(--transition-slow),
			background var(--transition-slow),
			box-shadow var(--transition-slow),
			backdrop-filter var(--transition-slow);
	}

	.site-header[data-scrolled="true"] .site-nav-shell,
	.site-nav[data-state="active"] .site-nav-shell {
		max-width: 920px;
		padding: 0 var(--spacing-md);
		border-color: var(--color-border);
		border-radius: 18px;
		background: var(--color-surface);
		background: color-mix(in srgb, var(--color-surface) 78%, transparent);
		box-shadow: var(--shadow-lg);
		backdrop-filter: blur(16px);
	}

	.site-nav-inner {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-lg);
		padding: 12px 0;
	}

	.site-brand-row {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
	}

	.site-logo {
		display: inline-flex;
		align-items: center;
		line-height: 0;
	}

	.site-logo-img {
		height: 36px;
		width: auto;
		display: block;
	}

	.site-logo-img--dark {
		display: none;
	}

	:global(:root.dark) .site-logo-img--light {
		display: none;
	}

	:global(:root.dark) .site-logo-img--dark {
		display: block;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .site-logo-img--light {
			display: none;
		}

		:global(:root:not(.light)) .site-logo-img--dark {
			display: block;
		}
	}

	.nav-toggle {
		position: relative;
		z-index: 2;
		display: inline-flex;
		width: 40px;
		height: 40px;
		align-items: center;
		justify-content: center;
		margin: -8px -10px -8px 0;
		color: var(--color-text);
		background: transparent;
		border: 0;
		border-radius: var(--button-radius);
		cursor: pointer;
		transition: background var(--transition-fast);
	}

	.nav-toggle:hover {
		background: var(--button-secondary-bg-hover);
	}

	.nav-toggle-icon {
		position: absolute;
		width: 24px;
		height: 24px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition:
			opacity var(--transition-base),
			transform var(--transition-base);
	}

	.nav-toggle-icon--close {
		opacity: 0;
		transform: rotate(-180deg) scale(0);
	}

	.site-nav[data-state="active"] .nav-toggle-icon--menu {
		opacity: 0;
		transform: rotate(180deg) scale(0);
	}

	.site-nav[data-state="active"] .nav-toggle-icon--close {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	.nav-center {
		display: none;
	}

	.nav-center ul,
	.nav-mobile-links ul {
		list-style: none;
	}

	.nav-center a,
	.nav-mobile-links a {
		display: block;
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-muted);
		transition: color var(--transition-fast);
	}

	.nav-center a:hover,
	.nav-mobile-links a:hover {
		color: var(--color-text);
	}

	.nav-panel {
		display: none;
		width: 100%;
		margin-bottom: var(--spacing-md);
		padding: var(--spacing-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 24px;
		box-shadow: var(--shadow-xl);
	}

	.site-nav[data-state="active"] .nav-panel {
		display: block;
	}

	.nav-mobile-links {
		margin-bottom: var(--spacing-xl);
	}

	.nav-mobile-links ul {
		display: grid;
		gap: var(--spacing-lg);
	}

	.nav-mobile-links a {
		font-size: var(--font-size-base);
	}

	.nav-actions {
		display: flex;
		width: 100%;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.nav-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		min-height: 36px;
		padding: 8px 12px;
		font-size: var(--font-size-sm);
		font-weight: 500;
		line-height: 1.35;
		border-radius: var(--button-radius);
		transition:
			background var(--transition-fast),
			color var(--transition-fast),
			transform var(--transition-fast);
	}

	.nav-action:active {
		transform: scale(0.99);
	}

	.nav-action--github {
		color: var(--color-text);
		background: transparent;
	}

	.nav-action--github:hover {
		background: var(--button-secondary-bg-hover);
	}

	.github-icon {
		width: 20px;
		height: 20px;
		color: color-mix(in srgb, var(--color-text) 48%, transparent);
	}

	.nav-action--primary {
		color: var(--button-primary-fg);
		background: var(--button-primary-bg);
	}

	.nav-action--primary:hover {
		background: var(--button-primary-bg-hover);
	}

	@media (min-width: 640px) {
		.nav-actions {
			flex-direction: row;
			justify-content: flex-end;
		}
	}

	@media (min-width: 960px) {
		.site-nav-inner {
			flex-wrap: nowrap;
			gap: 0;
			padding: 14px 0;
		}

		.site-brand-row {
			width: auto;
		}

		.nav-toggle,
		.nav-mobile-links {
			display: none;
		}

		.nav-center {
			position: absolute;
			inset: 0;
			display: block;
			width: fit-content;
			height: fit-content;
			margin: auto;
		}

		.nav-center ul {
			display: flex;
			gap: var(--spacing-xl);
		}

		.nav-panel,
		.site-nav[data-state="active"] .nav-panel {
			display: flex;
			width: fit-content;
			margin: 0;
			padding: 0;
			background: transparent;
			border: 0;
			border-radius: 0;
			box-shadow: none;
		}

		.nav-actions {
			width: auto;
			align-items: center;
			gap: var(--spacing-sm);
		}

		.site-header[data-scrolled="true"] .site-nav-shell {
			padding: 0 var(--spacing-md);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav-shell,
		.nav-toggle,
		.nav-toggle-icon,
		.nav-action {
			transition: none;
		}

		.nav-action:active {
			transform: none;
		}
	}
</style>
