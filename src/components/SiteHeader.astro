---
import { sanitizeHref } from "emdash";
import NavMenuLink from "./NavMenuLink.astro";
import { COMMUNITY_LINKS, SOCIAL_ICON_PATHS, getSocialType } from "./social";

interface MenuItem {
	label: string;
	url: string;
	target?: string | null;
}

interface SiteLogo {
	url: string;
	alt?: string | null;
}

interface Props {
	siteTitle: string;
	siteLogo?: SiteLogo | null;
	menuItems: MenuItem[];
	playgroundUrl: string;
	githubStars?: string;
	githubStarsLabel?: string;
}

const {
	siteTitle,
	siteLogo,
	menuItems,
	playgroundUrl,
	githubStars = "12K",
	githubStarsLabel = "12,000",
} = Astro.props;

function isExternalUrl(url?: string | null) {
	return typeof url === "string" && /^https?:\/\//i.test(url);
}

function getTarget(item: MenuItem) {
	return item.target || (isExternalUrl(item.url) ? "_blank" : undefined);
}

function getRel(item: MenuItem) {
	return getTarget(item) === "_blank" ? "noreferrer" : undefined;
}

function isGitHubItem(item: MenuItem) {
	return getSocialType(item.label, item.url) === "github";
}

const safeMenuItems = menuItems.map((item) => ({
	...item,
	url: sanitizeHref(item.url?.trim()),
}));
const logoWidth = 471;
const logoHeight = 118;
const safePlaygroundUrl = sanitizeHref(playgroundUrl.trim());
const githubItem = safeMenuItems.find(isGitHubItem);
const navItems = safeMenuItems.filter((item) => !isGitHubItem(item));

interface ProductLink {
	label: string;
	description: string;
	url: string;
	icon: string;
}

// The Product menu lists EmDash's own properties, so it lives in code rather
// than the editable "primary" menu. Keep it to a short list of places people
// can use today.
const productLinks: ProductLink[] = [
	{
		label: "Playground",
		description: "Try the admin in your browser",
		url: safePlaygroundUrl,
		icon: "ph:app-window",
	},
	{
		label: "Plugins",
		description: "Browse the plugin registry",
		url: "https://plugins.emdashcms.com",
		icon: "ph:puzzle-piece",
	},
	{
		label: "Build a plugin",
		description: "Hooks, routes, and admin pages",
		url: "https://docs.emdashcms.com/plugins/creating-plugins/choosing-a-format/",
		icon: "ph:code",
	},
];

// The Community menu replaces CMS links it already covers (e.g. Discord).
const communityTypes = new Set<string>(COMMUNITY_LINKS.map((link) => link.type));
const topNavItems = navItems.filter((item) => !communityTypes.has(getSocialType(item.label, item.url)));
---

<header class="site-header" data-site-header data-scrolled="false">
	<nav class="site-nav" data-site-nav data-state="closed" aria-label="Primary navigation">
		<div class="site-nav-shell">
			<div class="site-nav-inner">
				<div class="site-brand-row">
					<a href="/" class="site-logo" aria-label={siteTitle} data-menu-close>
						{siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="site-logo-img" width={logoWidth} height={logoHeight} />
						) : (
							<>
								<img
									src="/brand/logo-dark-text.svg"
									alt={siteTitle}
									class="site-logo-img site-logo-img--light"
									width={logoWidth}
									height={logoHeight}
								/>
								<img
									src="/brand/logo-light-text.svg"
									alt={siteTitle}
									class="site-logo-img site-logo-img--dark"
									width={logoWidth}
									height={logoHeight}
								/>
							</>
						)}
					</a>

					<button
						type="button"
						class="nav-toggle"
						aria-label="Open menu"
						aria-expanded="false"
						aria-controls="site-nav-panel"
						data-menu-toggle
					>
						<svg class="nav-toggle-icon nav-toggle-icon--menu" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M4 7h16M4 12h16M4 17h16" />
						</svg>
						<svg class="nav-toggle-icon nav-toggle-icon--close" viewBox="0 0 24 24" aria-hidden="true">
							<path d="m6 6 12 12M18 6 6 18" />
						</svg>
					</button>
				</div>

				<div class="nav-center">
					<ul class="nav-center-list">
						<li class="nav-dropdown" data-dropdown data-state="closed">
							<button
								type="button"
								class="nav-link nav-dropdown-trigger"
								aria-expanded="false"
								aria-controls="nav-product-panel"
								data-dropdown-trigger
							>
								Product
								<svg class="nav-dropdown-caret" viewBox="0 0 16 16" aria-hidden="true">
									<path d="m4 6 4 4 4-4" />
								</svg>
							</button>
							<div class="nav-dropdown-panel" id="nav-product-panel">
								<div class="menu-card">
									<ul class="menu-list">
										{productLinks.map((item) => (
											<li>
												<NavMenuLink
													href={item.url}
													label={item.label}
													description={item.description}
													target={getTarget(item)}
													rel={getRel(item)}
													icon={item.icon}
													closes="dropdown"
												/>
											</li>
										))}
									</ul>
								</div>
							</div>
						</li>
						{topNavItems.map((item) => (
							<li>
								<a
									class="nav-link"
									href={item.url}
									target={getTarget(item)}
									rel={getRel(item)}
								>
									{item.label}
								</a>
							</li>
						))}
						<li class="nav-dropdown" data-dropdown data-state="closed">
							<button
								type="button"
								class="nav-link nav-dropdown-trigger"
								aria-expanded="false"
								aria-controls="nav-community-panel"
								data-dropdown-trigger
							>
								Community
								<svg class="nav-dropdown-caret" viewBox="0 0 16 16" aria-hidden="true">
									<path d="m4 6 4 4 4-4" />
								</svg>
							</button>
							<div class="nav-dropdown-panel" id="nav-community-panel">
								<div class="menu-card">
									<ul class="menu-list">
										{COMMUNITY_LINKS.map((link) => (
											<li>
												<NavMenuLink
													href={link.url}
													label={link.label}
													description={link.description}
													target="_blank"
													rel="noreferrer"
													social={link.type}
													closes="dropdown"
												/>
											</li>
										))}
									</ul>
								</div>
							</div>
						</li>
					</ul>
				</div>

				<div class="nav-panel" id="site-nav-panel" data-nav-panel>
					<div class="nav-mobile-links">
						<p class="menu-heading" id="nav-mobile-product">Product</p>
						<ul class="menu-list nav-mobile-products" aria-labelledby="nav-mobile-product">
							{productLinks.map((item) => (
								<li>
									<NavMenuLink
										href={item.url}
										label={item.label}
										description={item.description}
										target={getTarget(item)}
										rel={getRel(item)}
										icon={item.icon}
										closes="menu"
									/>
								</li>
							))}
						</ul>

						{topNavItems.length > 0 && (
							<ul class="nav-mobile-list">
								{topNavItems.map((item) => (
									<li>
										<a
											href={item.url}
											target={getTarget(item)}
											rel={getRel(item)}
											data-menu-close
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						)}

						<div class="community-row">
							<p class="menu-heading" id="nav-mobile-community">Community</p>
							<ul class="community-list" aria-labelledby="nav-mobile-community">
								{COMMUNITY_LINKS.map((link) => (
									<li>
										<a
											class="community-link"
											href={link.url}
											target="_blank"
											rel="noreferrer"
											data-menu-close
										>
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path fill="currentColor" d={SOCIAL_ICON_PATHS[link.type]} />
											</svg>
											{link.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					</div>

					<div class="nav-actions">
						{githubItem && (
							<a
								href={githubItem.url}
								class="nav-action nav-action--github"
								target={getTarget(githubItem)}
								rel={getRel(githubItem)}
								aria-label={`EmDash GitHub repository, ${githubStarsLabel} stars`}
								data-menu-close
							>
								<svg viewBox="0 0 20 20" aria-hidden="true" class="github-icon">
									<path
										fill="currentColor"
										fill-rule="evenodd"
										clip-rule="evenodd"
										d="M9.98 2C5.57 2 2 5.59 2 10.04c0 3.55 2.28 6.55 5.45 7.62c.4.08.54-.17.54-.39c0-.19-.01-.82-.01-1.49c-2.22.48-2.68-.96-2.68-.96c-.36-.93-.88-1.17-.88-1.17c-.73-.49.05-.49.05-.49c.81.05 1.23.82 1.23.82c.71 1.22 1.86.88 2.32.66c.07-.52.28-.88.5-1.08c-1.77-.19-3.63-.88-3.63-3.96c0-.88.32-1.6.82-2.16c-.08-.2-.36-1.03.08-2.13c0 0 .67-.21 2.19.82a7.6 7.6 0 0 1 1.99-.27c.67 0 1.36.09 1.99.27c1.52-1.04 2.19-.82 2.19-.82c.44 1.1.16 1.93.08 2.13c.52.56.82 1.28.82 2.16c0 3.09-1.86 3.77-3.64 3.96c.29.25.54.73.54 1.49c0 1.08-.01 1.94-.01 2.21c0 .21.15.47.54.39A8.04 8.04 0 0 0 17.94 10.04C17.95 5.59 14.37 2 9.98 2Z"
									/>
								</svg>
								<span>{githubStars}</span>
							</a>
						)}
						<a href={safePlaygroundUrl} class="nav-action nav-action--primary" target="_blank" rel="noreferrer" data-menu-close>
							Try it
						</a>
					</div>
				</div>
			</div>
		</div>
	</nav>
</header>

<script is:inline>
	(() => {
		const header = document.querySelector("[data-site-header]");
		const nav = document.querySelector("[data-site-nav]");
		const toggle = document.querySelector("[data-menu-toggle]");
		if (!header || !nav || !toggle) return;

		const setOpen = (open) => {
			nav.dataset.state = open ? "active" : "closed";
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
		};

		const updateScrolled = () => {
			header.dataset.scrolled = window.scrollY > 50 ? "true" : "false";
		};

		// Desktop dropdowns follow the disclosure pattern: a button toggles a
		// panel of ordinary links. A mouse can also open a panel by hovering;
		// clicking the trigger while it is hover-open pins it instead of closing.
		const dropdowns = Array.from(document.querySelectorAll("[data-dropdown]")).flatMap((root) => {
			const trigger = root.querySelector("[data-dropdown-trigger]");
			return trigger ? [{ root, trigger, closeTimer: 0, openedByHover: false }] : [];
		});

		const setDropdown = (dropdown, open, { hover = false } = {}) => {
			window.clearTimeout(dropdown.closeTimer);
			if (open) {
				dropdowns.forEach((other) => {
					if (other !== dropdown) setDropdown(other, false);
				});
			}
			dropdown.root.dataset.state = open ? "open" : "closed";
			dropdown.trigger.setAttribute("aria-expanded", String(open));
			dropdown.openedByHover = open && hover;
		};

		const isOpen = (dropdown) => dropdown.root.dataset.state === "open";

		dropdowns.forEach((dropdown) => {
			const { root, trigger } = dropdown;

			trigger.addEventListener("click", () => {
				if (isOpen(dropdown) && dropdown.openedByHover) {
					dropdown.openedByHover = false;
					return;
				}
				setDropdown(dropdown, !isOpen(dropdown));
			});

			root.addEventListener("pointerenter", (event) => {
				if (event.pointerType !== "mouse") return;
				window.clearTimeout(dropdown.closeTimer);
				if (!isOpen(dropdown)) setDropdown(dropdown, true, { hover: true });
			});

			root.addEventListener("pointerleave", (event) => {
				if (event.pointerType !== "mouse" || !dropdown.openedByHover) return;
				dropdown.closeTimer = window.setTimeout(() => setDropdown(dropdown, false), 160);
			});

			// Focus on a panel link pins a hover-opened panel so moving the mouse
			// away doesn't hide the link that has keyboard focus. The trigger is
			// excluded: clicking it focuses it, and the click handler pins instead.
			root.addEventListener("focusin", (event) => {
				if (event.target !== trigger) dropdown.openedByHover = false;
			});

			root.addEventListener("focusout", (event) => {
				// relatedTarget is null when focus leaves for a non-focusable
				// click target; the document pointerdown handler covers that case.
				if (event.relatedTarget && !root.contains(event.relatedTarget)) {
					setDropdown(dropdown, false);
				}
			});

			root.querySelectorAll("[data-dropdown-close]").forEach((link) => {
				link.addEventListener("click", () => setDropdown(dropdown, false));
			});
		});

		document.addEventListener("pointerdown", (event) => {
			dropdowns.forEach((dropdown) => {
				if (isOpen(dropdown) && !dropdown.root.contains(event.target)) {
					setDropdown(dropdown, false);
				}
			});
		});

		toggle.addEventListener("click", () => {
			setOpen(nav.dataset.state !== "active");
		});

		document.querySelectorAll("[data-menu-close]").forEach((item) => {
			item.addEventListener("click", () => setOpen(false));
		});

		window.addEventListener("scroll", updateScrolled, { passive: true });
		window.addEventListener("resize", () => {
			if (window.innerWidth >= 960) setOpen(false);
			else dropdowns.forEach((dropdown) => setDropdown(dropdown, false));
		});
		window.addEventListener("keydown", (event) => {
			if (event.key !== "Escape") return;
			const openDropdown = dropdowns.find(isOpen);
			if (openDropdown) {
				const hadFocus = openDropdown.root.contains(document.activeElement);
				setDropdown(openDropdown, false);
				if (hadFocus) openDropdown.trigger.focus();
				return;
			}
			setOpen(false);
		});

		updateScrolled();
	})();
</script>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		pointer-events: none;
	}

	.site-nav {
		pointer-events: auto;
	}

	.site-nav-shell {
		width: 100%;
		max-width: var(--wide-width);
		margin: 8px auto 0;
		padding: 0 var(--spacing-lg);
		border: 1px solid transparent;
		border-radius: 0;
		transition:
			width var(--transition-slow),
			max-width var(--transition-slow),
			padding var(--transition-slow),
			border-color var(--transition-slow),
			border-radius var(--transition-slow),
			background var(--transition-slow),
			box-shadow var(--transition-slow),
			backdrop-filter var(--transition-slow);
	}

	.site-header[data-scrolled="true"] .site-nav-shell,
	.site-nav[data-state="active"] .site-nav-shell {
		width: calc(100% - 16px);
		max-width: 920px;
		padding: 0 var(--spacing-md);
		border-color: var(--color-border);
		border-radius: 18px;
		background: var(--color-surface);
		background: color-mix(in srgb, var(--color-surface) 78%, transparent);
		box-shadow: var(--shadow-lg);
		backdrop-filter: blur(16px);
	}

	.site-nav-inner {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-lg);
		padding: 12px 0;
	}

	.site-brand-row {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
	}

	.site-logo {
		display: inline-flex;
		align-items: center;
		line-height: 0;
	}

	.site-logo-img {
		height: clamp(28px, 3vw, 32px);
		width: auto;
		display: block;
	}

	.site-logo-img--dark {
		display: none;
	}

	:global(:root.dark) .site-logo-img--light {
		display: none;
	}

	:global(:root.dark) .site-logo-img--dark {
		display: block;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .site-logo-img--light {
			display: none;
		}

		:global(:root:not(.light)) .site-logo-img--dark {
			display: block;
		}
	}

	.nav-toggle {
		position: relative;
		z-index: 2;
		display: inline-flex;
		width: 40px;
		height: 40px;
		align-items: center;
		justify-content: center;
		margin: -8px -10px -8px 0;
		color: var(--color-text);
		background: transparent;
		border: 0;
		border-radius: var(--button-radius);
		cursor: pointer;
		transition: background var(--transition-fast);
	}

	.nav-toggle:hover {
		background: var(--button-secondary-bg-hover);
	}

	.nav-toggle-icon {
		position: absolute;
		width: 24px;
		height: 24px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition:
			opacity var(--transition-base),
			transform var(--transition-base);
	}

	.nav-toggle-icon--close {
		opacity: 0;
		transform: rotate(-180deg) scale(0);
	}

	.site-nav[data-state="active"] .nav-toggle-icon--menu {
		opacity: 0;
		transform: rotate(180deg) scale(0);
	}

	.site-nav[data-state="active"] .nav-toggle-icon--close {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	.nav-center {
		display: none;
	}

	.nav-center ul,
	.nav-mobile-links ul {
		list-style: none;
	}

	.nav-link,
	.nav-mobile-list a {
		display: block;
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-muted);
	}

	.nav-link:hover,
	.nav-mobile-list a:hover {
		color: var(--color-text);
	}

	/* Top-level desktop items share a quiet pill hover. */
	.nav-link {
		padding: 6px 12px;
		line-height: 20px;
		border-radius: var(--button-radius);
		transition:
			color var(--transition-fast),
			background var(--transition-fast);
	}

	.nav-link:hover {
		background: var(--button-secondary-bg);
	}

	.nav-dropdown {
		position: relative;
	}

	.nav-dropdown-trigger {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-family: inherit;
		background: transparent;
		border: 0;
		cursor: pointer;
	}

	.nav-dropdown[data-state="open"] .nav-dropdown-trigger {
		color: var(--color-text);
		background: var(--button-secondary-bg);
	}

	.nav-dropdown-caret {
		width: 14px;
		height: 14px;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: transform var(--transition-base);
	}

	.nav-dropdown[data-state="open"] .nav-dropdown-caret {
		transform: rotate(180deg);
	}

	/*
	 * The panel's top padding bridges the gap below the trigger so the pointer
	 * can travel into the menu without leaving the hover area.
	 */
	.nav-dropdown-panel {
		position: absolute;
		top: 100%;
		left: 50%;
		z-index: 1;
		padding-top: 22px;
		opacity: 0;
		visibility: hidden;
		transform: translate(-50%, -4px) scale(0.98);
		transform-origin: top center;
		transition:
			opacity 120ms ease-out,
			transform 120ms ease-out,
			visibility 0s linear 120ms;
	}

	.nav-dropdown[data-state="open"] .nav-dropdown-panel,
	:global(html:not(.js)) .nav-dropdown:is(:hover, :focus-within) .nav-dropdown-panel {
		opacity: 1;
		visibility: visible;
		transform: translate(-50%, 0) scale(1);
		transition:
			opacity 180ms cubic-bezier(0.22, 1, 0.36, 1),
			transform 180ms cubic-bezier(0.22, 1, 0.36, 1),
			visibility 0s;
	}

	.menu-card {
		width: 320px;
		padding: 10px;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 18px;
		box-shadow:
			0 24px 48px -24px rgba(0, 0, 0, 0.24),
			var(--shadow-lg);
	}

	.menu-heading {
		margin: 0 0 6px;
		font-size: var(--font-size-xs);
		font-weight: 500;
		line-height: 1.4;
		color: var(--color-muted);
	}

	.menu-list {
		display: grid;
		gap: 2px;
	}

	/* Mobile-only: the desktop nav has a Community dropdown instead. */
	.community-row {
		display: grid;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-lg);
		padding-top: var(--spacing-md);
		border-top: 1px solid var(--color-border);
	}

	.community-row .menu-heading {
		margin: 0;
	}

	.community-list {
		display: flex;
		flex-wrap: wrap;
		gap: 4px;
		margin-left: -8px;
	}

	.community-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		min-height: 32px;
		padding: 6px 8px;
		font-size: 0.8125rem;
		font-weight: 500;
		line-height: 1.4;
		color: var(--color-muted);
		border-radius: 8px;
		transition:
			color var(--transition-fast),
			background var(--transition-fast);
	}

	.community-link:hover {
		color: var(--color-text);
		background: var(--button-secondary-bg);
	}

	.community-link svg {
		width: 15px;
		height: 15px;
	}

	.nav-panel {
		display: block;
		width: 100%;
		margin-bottom: var(--spacing-md);
		padding: var(--spacing-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 24px;
		box-shadow: var(--shadow-xl);
	}

	:global(html.js) .nav-panel {
		display: none;
	}

	:global(html.js) .site-nav[data-state="active"] .nav-panel {
		display: block;
