---
import { sanitizeHref } from "emdash";

interface MenuItem {
	label: string;
	url: string;
	target?: string | null;
}

interface SiteLogo {
	url: string;
	alt?: string | null;
}

interface Props {
	siteTitle: string;
	siteLogo?: SiteLogo | null;
	menuItems: MenuItem[];
	playgroundUrl: string;
	githubStars?: string;
	githubStarsLabel?: string;
}

const {
	siteTitle,
	siteLogo,
	menuItems,
	playgroundUrl,
	githubStars = "12K",
	githubStarsLabel = "12,000",
} = Astro.props;

function isExternalUrl(url?: string | null) {
	return typeof url === "string" && /^https?:\/\//i.test(url);
}

function getTarget(item: MenuItem) {
	return item.target || (isExternalUrl(item.url) ? "_blank" : undefined);
}

function getRel(item: MenuItem) {
	return getTarget(item) === "_blank" ? "noreferrer" : undefined;
}

function isGitHubItem(item: MenuItem) {
	return item.label.toLowerCase() === "github" || item.url.includes("github.com");
}

const safeMenuItems = menuItems.map((item) => ({
	...item,
	url: sanitizeHref(item.url?.trim()),
}));
const logoWidth = 471;
const logoHeight = 118;
const safePlaygroundUrl = sanitizeHref(playgroundUrl.trim());
const githubItem = safeMenuItems.find(isGitHubItem);
const navItems = safeMenuItems.filter((item) => !isGitHubItem(item));
const productPages = [
	{ label: "Astro CMS", description: "Content that belongs in your Astro app.", url: "/astro-cms", icon: "code" },
	{ label: "Media library", description: "Files, details, and usage in one place.", url: "/media-library", icon: "media" },
	{ label: "For agents", description: "Scoped tools alongside your editors.", url: "/for-agents", icon: "agent" },
];
---

<header class="site-header" data-site-header data-scrolled="false">
	<nav class="site-nav" data-site-nav data-state="closed" aria-label="Primary navigation">
		<div class="site-nav-shell">
			<div class="site-nav-inner">
				<div class="site-brand-row">
					<a href="/" class="site-logo" aria-label={siteTitle} data-menu-close>
						{siteLogo ? (
							<img src={siteLogo.url} alt={siteLogo.alt || siteTitle} class="site-logo-img" width={logoWidth} height={logoHeight} />
						) : (
							<>
								<img
									src="/brand/logo-dark-text.svg"
									alt={siteTitle}
									class="site-logo-img site-logo-img--light"
									width={logoWidth}
									height={logoHeight}
								/>
								<img
									src="/brand/logo-light-text.svg"
									alt={siteTitle}
									class="site-logo-img site-logo-img--dark"
									width={logoWidth}
									height={logoHeight}
								/>
							</>
						)}
					</a>

					<button
						type="button"
						class="nav-toggle"
						aria-label="Open menu"
						aria-expanded="false"
						aria-controls="site-nav-panel"
						data-menu-toggle
					>
						<svg class="nav-toggle-icon nav-toggle-icon--menu" viewBox="0 0 24 24" aria-hidden="true">
							<path d="M4 7h16M4 12h16M4 17h16" />
						</svg>
						<svg class="nav-toggle-icon nav-toggle-icon--close" viewBox="0 0 24 24" aria-hidden="true">
							<path d="m6 6 12 12M18 6 6 18" />
						</svg>
					</button>
				</div>

				<div class="nav-center">
					<ul>
						<li class="product-menu">
							<details data-product-details>
								<summary data-product-trigger>Product <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></summary>
								<div class="product-popover">
									<div class="product-destinations">
										<p>Explore EmDash</p>
										{productPages.map((page) => (
											<a class="product-destination" href={page.url} data-menu-close>
												<span class="destination-icon" aria-hidden="true">
													{page.icon === "code" && <svg viewBox="0 0 24 24" fill="none"><path d="m8 7-5 5 5 5m8-10 5 5-5 5m-2-12-4 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>}
													{page.icon === "media" && <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="4" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.6" /><circle cx="8" cy="9" r="1.4" fill="currentColor" /><path d="m4 17 5-5 3 3 3-4 5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>}
													{page.icon === "agent" && <svg viewBox="0 0 24 24" fill="none"><path d="m12 2 1.8 6.2L20 10l-6.2 1.8L12 18l-1.8-6.2L4 10l6.2-1.8L12 2Zm7 14 .7 2.3L22 19l-2.3.7L19 22l-.7-2.3L16 19l2.3-.7L19 16Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /></svg>}
												</span>
												<span class="destination-copy"><strong>{page.label}</strong><small>{page.description}</small></span>
												<span class="destination-arrow" aria-hidden="true">↗</span>
											</a>
										))}
									</div>
								</div>
							</details>
						</li>
						{navItems.map((item) => (
							<li>
								<a
									href={item.url}
									target={getTarget(item)}
									rel={getRel(item)}
								>
									{item.label}
								</a>
							</li>
						))}
					</ul>
				</div>

				<div class="nav-panel" id="site-nav-panel" data-nav-panel>
					<div class="nav-mobile-links">
						<div class="nav-mobile-product">
							<span class="nav-mobile-heading">Product</span>
							<div class="nav-mobile-product-links">
								{productPages.map((page) => <a href={page.url} data-menu-close>{page.label}<span aria-hidden="true">↗</span></a>)}
							</div>
						</div>
						{navItems.length > 0 && (
							<ul>
								{navItems.map((item) => (
									<li>
										<a
											href={item.url}
											target={getTarget(item)}
											rel={getRel(item)}
											data-menu-close
										>
											{item.label}
										</a>
									</li>
								))}
							</ul>
						)}
					</div>

					<div class="nav-actions">
						{githubItem && (
							<a
								href={githubItem.url}
								class="nav-action nav-action--github"
								target={getTarget(githubItem)}
								rel={getRel(githubItem)}
								aria-label={`EmDash GitHub repository, ${githubStarsLabel} stars`}
								data-menu-close
							>
								<svg viewBox="0 0 20 20" aria-hidden="true" class="github-icon">
									<path
										fill="currentColor"
										fill-rule="evenodd"
										clip-rule="evenodd"
										d="M9.98 2C5.57 2 2 5.59 2 10.04c0 3.55 2.28 6.55 5.45 7.62c.4.08.54-.17.54-.39c0-.19-.01-.82-.01-1.49c-2.22.48-2.68-.96-2.68-.96c-.36-.93-.88-1.17-.88-1.17c-.73-.49.05-.49.05-.49c.81.05 1.23.82 1.23.82c.71 1.22 1.86.88 2.32.66c.07-.52.28-.88.5-1.08c-1.77-.19-3.63-.88-3.63-3.96c0-.88.32-1.6.82-2.16c-.08-.2-.36-1.03.08-2.13c0 0 .67-.21 2.19.82a7.6 7.6 0 0 1 1.99-.27c.67 0 1.36.09 1.99.27c1.52-1.04 2.19-.82 2.19-.82c.44 1.1.16 1.93.08 2.13c.52.56.82 1.28.82 2.16c0 3.09-1.86 3.77-3.64 3.96c.29.25.54.73.54 1.49c0 1.08-.01 1.94-.01 2.21c0 .21.15.47.54.39A8.04 8.04 0 0 0 17.94 10.04C17.95 5.59 14.37 2 9.98 2Z"
									/>
								</svg>
								<span>{githubStars}</span>
							</a>
						)}
						<a href={safePlaygroundUrl} class="nav-action nav-action--primary" target="_blank" rel="noreferrer" data-menu-close>
							Try it
						</a>
					</div>
				</div>
			</div>
		</div>
	</nav>
</header>

<script is:inline>
	(() => {
		const header = document.querySelector("[data-site-header]");
		const nav = document.querySelector("[data-site-nav]");
		const toggle = document.querySelector("[data-menu-toggle]");
		const productMenu = document.querySelector("[data-product-details]");
		const productTrigger = document.querySelector("[data-product-trigger]");
		if (!header || !nav || !toggle) return;

		const setOpen = (open) => {
			nav.dataset.state = open ? "active" : "closed";
			toggle.setAttribute("aria-expanded", String(open));
			toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			if (open && productMenu) productMenu.open = false;
		};

		const updateScrolled = () => {
			header.dataset.scrolled = window.scrollY > 50 ? "true" : "false";
		};

		toggle.addEventListener("click", () => {
			setOpen(nav.dataset.state !== "active");
		});

		document.querySelectorAll("[data-menu-close]").forEach((item) => {
			item.addEventListener("click", () => {
				setOpen(false);
				if (productMenu) productMenu.open = false;
			});
		});
		document.addEventListener("pointerdown", (event) => {
			if (productMenu?.open && !productMenu.contains(event.target)) productMenu.open = false;
		});
		productMenu?.addEventListener("focusout", () => {
			requestAnimationFrame(() => {
				if (!productMenu.contains(document.activeElement)) productMenu.open = false;
			});
		});

		window.addEventListener("scroll", updateScrolled, { passive: true });
		window.addEventListener("resize", () => {
			if (window.innerWidth >= 960) setOpen(false);
		});
		window.addEventListener("keydown", (event) => {
			if (event.key !== "Escape") return;
			if (productMenu?.open) {
				productMenu.open = false;
				productTrigger?.focus();
			} else {
				setOpen(false);
			}
		});

		updateScrolled();
	})();
</script>

<style>
	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		pointer-events: none;
	}

	.site-nav {
		pointer-events: auto;
	}

	.site-nav-shell {
		width: 100%;
		max-width: var(--wide-width);
		margin: 8px auto 0;
		padding: 0 var(--spacing-lg);
		border: 1px solid transparent;
		border-radius: 0;
		transition:
			width var(--transition-slow),
			max-width var(--transition-slow),
			padding var(--transition-slow),
			border-color var(--transition-slow),
			border-radius var(--transition-slow),
			background var(--transition-slow),
			box-shadow var(--transition-slow),
			backdrop-filter var(--transition-slow);
	}

	.site-header[data-scrolled="true"] .site-nav-shell,
	.site-nav[data-state="active"] .site-nav-shell {
		width: calc(100% - 16px);
		max-width: 920px;
		padding: 0 var(--spacing-md);
		border-color: var(--color-border);
		border-radius: 18px;
		background: var(--color-surface);
		background: color-mix(in srgb, var(--color-surface) 78%, transparent);
		box-shadow: var(--shadow-lg);
		backdrop-filter: blur(16px);
	}

	.site-nav-inner {
		position: relative;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-lg);
		padding: 12px 0;
	}

	.site-brand-row {
		display: flex;
		width: 100%;
		align-items: center;
		justify-content: space-between;
	}

	.site-logo {
		display: inline-flex;
		align-items: center;
		line-height: 0;
	}

	.site-logo-img {
		height: clamp(28px, 3vw, 32px);
		width: auto;
		display: block;
	}

	.site-logo-img--dark {
		display: none;
	}

	:global(:root.dark) .site-logo-img--light {
		display: none;
	}

	:global(:root.dark) .site-logo-img--dark {
		display: block;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .site-logo-img--light {
			display: none;
		}

		:global(:root:not(.light)) .site-logo-img--dark {
			display: block;
		}
	}

	.nav-toggle {
		position: relative;
		z-index: 2;
		display: inline-flex;
		width: 40px;
		height: 40px;
		align-items: center;
		justify-content: center;
		margin: -8px -10px -8px 0;
		color: var(--color-text);
		background: transparent;
		border: 0;
		border-radius: var(--button-radius);
		cursor: pointer;
		transition: background var(--transition-fast);
	}

	.nav-toggle:hover {
		background: var(--button-secondary-bg-hover);
	}

	.nav-toggle-icon {
		position: absolute;
		width: 24px;
		height: 24px;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition:
			opacity var(--transition-base),
			transform var(--transition-base);
	}

	.nav-toggle-icon--close {
		opacity: 0;
		transform: rotate(-180deg) scale(0);
	}

	.site-nav[data-state="active"] .nav-toggle-icon--menu {
		opacity: 0;
		transform: rotate(180deg) scale(0);
	}

	.site-nav[data-state="active"] .nav-toggle-icon--close {
		opacity: 1;
		transform: rotate(0deg) scale(1);
	}

	.nav-center {
		display: none;
	}

	.nav-center ul,
	.nav-mobile-links ul {
		list-style: none;
	}

	.nav-center a,
	.nav-mobile-links a {
		display: block;
		font-size: var(--font-size-sm);
		font-weight: 500;
		color: var(--color-muted);
		transition: color var(--transition-fast);
	}

	.nav-center a:hover,
	.nav-mobile-links a:hover {
		color: var(--color-text);
	}
	.product-menu { position: relative; }
	.product-menu summary {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		font-weight: 500;
		cursor: pointer;
		list-style: none;
	}
	.product-menu summary::-webkit-details-marker { display: none; }
	.product-menu summary:hover, .product-menu details[open] summary { color: var(--color-text); }
	.product-menu summary:focus-visible, .product-destination:focus-visible, .nav-mobile-product-links a:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; border-radius: 4px; }
	.product-menu summary svg { width: 1rem; height: 1rem; transition: transform var(--transition-fast); }
	.product-menu details[open] summary svg { transform: rotate(180deg); }
	.product-popover {
		position: absolute;
		z-index: 5;
		top: calc(100% + 1.4rem);
		left: 50%;
		width: min(24rem, calc(100vw - 2rem));
		overflow: hidden;
		padding: 0.45rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 1.1rem;
		box-shadow: 0 24px 70px color-mix(in srgb, var(--color-text) 15%, transparent);
		transform: translateX(-50%);
	}
	@media (prefers-reduced-motion: no-preference) {
		.product-menu details[open] .product-popover { animation: product-enter 240ms cubic-bezier(0.22, 1, 0.36, 1); }
	}
	@keyframes product-enter {
		from { opacity: 0; transform: translate(-50%, -8px); }
		to { opacity: 1; transform: translate(-50%, 0); }
	}
	.product-destinations { min-width: 0; padding: 1.1rem 0.55rem 0.55rem; }
	.product-destinations > p { margin: 0 0 0.55rem 0.75rem; color: var(--color-muted); font-size: 0.7rem; font-weight: 600; }
	.nav-center .product-destination { display: flex; min-width: 0; align-items: center; gap: 0.85rem; padding: 0.85rem 0.75rem; color: var(--color-text); border-radius: 0.65rem; text-decoration: none; }
	.nav-center .product-destination:hover { background: var(--heat-8); }
	.destination-icon { display: grid; width: 2.1rem; height: 2.1rem; flex: none; place-items: center; color: var(--color-primary); background: var(--heat-8); border: 1px solid var(--heat-12); border-radius: 0.5rem; }
	.destination-icon svg { width: 1.15rem; height: 1.15rem; }
	.destination-copy { display: grid; min-width: 0; gap: 0.2rem; }
	.destination-copy strong { font-size: 0.85rem; font-weight: 600; }
	.destination-copy small { color: var(--color-muted); font-size: 0.7rem; line-height: 1.35; }
	.destination-arrow { margin-inline-start: auto; color: var(--color-primary); font-size: 0.85rem; }

	.nav-panel {
		display: block;
		width: 100%;
		max-height: calc(100dvh - 5.5rem);
		overflow-y: auto;
		margin-bottom: var(--spacing-md);
		padding: var(--spacing-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: 24px;
		box-shadow: var(--shadow-xl);
		overscroll-behavior: contain;
	}

	:global(html.js) .nav-panel {
		display: none;
	}

	:global(html.js) .site-nav[data-state="active"] .nav-panel {
		display: block;
	}

	.nav-mobile-links {
		margin-bottom: var(--spacing-xl);
	}
	.nav-mobile-heading { color: var(--color-muted); font-size: 0.75rem; font-weight: 600; }
	.nav-mobile-product-links { display: grid; gap: 0.1rem; margin-top: 0.55rem; }
	.nav-mobile-product-links a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.6rem 0.7rem; color: var(--color-text); border-radius: 0.45rem; font-size: var(--font-size-sm); text-decoration: none; }
	.nav-mobile-product-links a:hover { background: var(--heat-8); }
	.nav-mobile-product-links a span { color: var(--color-primary); }

	.nav-mobile-links ul {
		display: grid;
		gap: var(--spacing-lg);
		margin-top: 1.25rem;
	}

	.nav-mobile-links a {
		font-size: var(--font-size-base);
	}

	.nav-actions {
		display: flex;
		width: 100%;
		flex-direction: column;
		gap: var(--spacing-sm);
	}

	.nav-action {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		min-height: 36px;
		padding: 8px 12px;
		font-size: var(--font-size-sm);
		font-weight: 500;
		line-height: 1.35;
		border-radius: var(--button-radius);
		transition:
			background var(--transition-fast),
			color var(--transition-fast),
			transform var(--transition-fast);
	}

	.nav-action:active {
		transform: scale(0.99);
	}

	.nav-action--github {
		color: var(--color-text);
		background: transparent;
	}

	.nav-action--github:hover {
		background: var(--button-secondary-bg-hover);
	}

	.github-icon {
		width: 20px;
		height: 20px;
		color: color-mix(in srgb, var(--color-text) 48%, transparent);
	}

	.nav-action--primary {
		color: var(--button-primary-fg);
		background: var(--button-primary-bg);
	}

	.nav-action--primary:hover {
		background: var(--button-primary-bg-hover);
	}

	@media (min-width: 640px) {
		.nav-actions {
			flex-direction: row;
			justify-content: flex-end;
		}
	}

	@media (min-width: 960px) {
		.site-nav-inner {
			flex-wrap: nowrap;
			gap: 0;
			padding: 14px 0;
		}

		.site-brand-row {
			width: auto;
		}

		.nav-toggle,
		.nav-mobile-links {
			display: none;
		}

		.nav-center {
			position: absolute;
			inset: 0;
			display: block;
			width: fit-content;
			height: fit-content;
			margin: auto;
		}

		.nav-center ul {
			display: flex;
			gap: var(--spacing-xl);
		}

		.nav-panel,
		:global(html.js) .nav-panel,
		:global(html.js) .site-nav[data-state="active"] .nav-panel {
			display: flex;
			width: fit-content;
			max-height: none;
			margin: 0;
			padding: 0;
			overflow: visible;
			background: transparent;
			border: 0;
			border-radius: 0;
			box-shadow: none;
		}

		.nav-actions {
			width: auto;
			align-items: center;
			gap: var(--spacing-sm);
		}

		.site-header[data-scrolled="true"] .site-nav-shell {
			padding: 0 var(--spacing-md);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-nav-shell,
		.nav-toggle,
		.nav-toggle-icon,
		.product-menu summary svg,
		.nav-action {
			transition: none;
		}

		.nav-action:active {
			transform: none;
		}
	}
</style>
