];

// The admin sidebar, in the real admin's order and icons (Dashboard omitted).
const adminNav = [
	{
		label: "Content",
		items: [
			{ label: "Pages", icon: ph.browser },
			{ label: "Posts", icon: ph.newspaperFill, active: true },
			{ label: "Media", icon: ph.imagesSquare },
		],
	},
	{
		label: "Manage",
		items: [
			{ label: "Comments", icon: ph.chats },
			{ label: "Menus", icon: ph.rows },
			{ label: "Redirects", icon: ph.path },
			{ label: "Widgets", icon: ph.puzzlePiece },
			{ label: "Sections", icon: ph.cardsThree },
			{ label: "Categories", icon: ph.folders },
			{ label: "Tags", icon: ph.tag },
			{ label: "Bylines", icon: ph.signature },
		],
	},
];

const importRows = [
	{ label: "Posts and pages", count: 128 },
	{ label: "Media files", count: 342 },
	{ label: "Categories and tags", count: 36 },
];

// A window onto this site's real `emdash-env.d.ts`, starting at the Post
// interface's own line number. The panel clips and fades the rest of the file.
// `thread` marks the Content field as it moves through the flow.
const typeStartLine = 21;
const typeLines = [
	{ html: '<span class="tok-k">export interface</span> <span class="tok-t">Post</span> {' },
	{ html: '  id: <span class="tok-p">string</span>;' },
	{ html: '  slug: <span class="tok-p">string</span> | <span class="tok-p">null</span>;' },
	{ html: '  status: <span class="tok-p">string</span>;' },
	{ html: '  title: <span class="tok-p">string</span>;' },
	{ html: '  excerpt?: <span class="tok-p">string</span>;' },
	{ html: '  content?: <span class="tok-p">PortableTextBlock</span>[];', thread: true },
	{ html: '  createdAt: <span class="tok-p">Date</span>;' },
	{ html: '  updatedAt: <span class="tok-p">Date</span>;' },
	{ html: '  publishedAt: <span class="tok-p">Date</span> | <span class="tok-p">null</span>;' },
];

// A window onto src/plugins/marketing-blocks/index.ts at the Capabilities
// block's own line number, dedented. `thread` marks the label the menu shows.
const blockStartLine = 75;
const blockLines = [
	{ html: "{" },
	{ html: '  type: <span class="tok-s">"marketing.capabilities"</span>,' },
	{ html: '  label: <span class="tok-s">"Capabilities"</span>,', thread: true },
	{ html: '  description: <span class="tok-s">"Feature bento with product illustrations"</span>,' },
	{ html: '  <span class="tok-c">// Only the heading is editable. Each card is paired with a bespoke</span>' },
	{ html: '  <span class="tok-c">// illustration, so card copy lives in Capabilities.astro.</span>' },
	{ html: "  fields: [" },
	{
		html: '    { type: <span class="tok-s">"text_input"</span>, action_id: <span class="tok-s">"headline"</span>, label: <span class="tok-s">"Headline"</span> },',
