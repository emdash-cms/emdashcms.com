---

<section class="capabilities" id={key} aria-labelledby={headingId}>
	<div class="cap-container container">
		<header class="cap-header">
			<div class="cap-heading">
				<p class="cap-eyebrow"><span class="cap-eyebrow-dash" aria-hidden="true"></span>Capabilities</p>
				<h2 id={headingId} class="cap-headline">
					{headlineLead}{headlineRest && " "}{headlineRest && <span class="cap-headline-muted">{headlineRest}</span>}
				</h2>
			</div>
			{subheadline && <p class="cap-intro">{subheadline}</p>}
		</header>

		<div class="cap-grid">
			{/* 1. Astro foundation: the anchor. */}
			<div class="cap-card cap-card--anchor">
				<div class="cap-copy cap-copy--anchor">
					<h3 class="cap-title cap-title--anchor">Everything you expect from a CMS. Built for Astro.</h3>
					<p class="cap-text">
						Create content types in the admin and edit them with drafts, revisions, and preview. EmDash generates
						TypeScript types from your schema, and Astro renders every entry on the server from structured JSON.
					</p>
				</div>

				<ol class="flow">
					<li class="flow-step">
						<div
							class="ui flow-panel"
							role="img"
							aria-label="The Posts content type in the admin: a required, searchable Title string, an Excerpt text field, and a searchable Content Portable Text field."
						>
							<div class="ui-bar">
								<span>Content types</span><span class="ui-sep">/</span><span class="ui-strong">Posts</span>
								<span class="ui-pill">3 fields</span>
							</div>
							<div class="schema">
								{schemaFields.map((field) => (
									<div class:list={["schema-row", { thread: field.thread }]}>
										<svg class="schema-grip" viewBox="0 0 24 24" set:html={icons.grip} />
										<div class="schema-main">
											<p class="schema-head">
												<span class="schema-name">{field.label}</span>
												<code class="schema-slug">{field.slug}</code>
											</p>
											<p class="schema-meta">
												<span>{field.type}</span>
												{field.flags.map((flag) => <span class="schema-flag">{flag}</span>)}
											</p>
										</div>
									</div>
								))}
								<div class="schema-add"><svg viewBox="0 0 24 24" set:html={icons.plus} />Add field</div>
							</div>
						</div>
						<p class="flow-caption"><span class="flow-num" aria-hidden="true">01</span><strong>Model</strong><span>Fields defined in the admin</span></p>
						<span class="flow-link" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icons.chevron} /></span>
					</li>

					<li class="flow-step">
						<div
							class="ui flow-panel"
							role="img"
							aria-label="The EmDash editor with a draft post titled Small tools, big impact, ready to publish."
						>
							<div class="ui-bar">
								<span>Posts</span><span class="ui-sep">/</span><span class="ui-strong">Edit</span>
								<span class="ui-pill"><span class="ui-pill-dot ui-pill-dot--draft"></span>Draft</span>
							</div>
							<div class="edit">
								<p class="edit-label">Title</p>
								<p class="edit-input">Small tools, big impact</p>
								<p class="edit-label">Content</p>
								<div class="edit-rich">
									<div class="edit-toolbar">
										<span class="is-on"><svg viewBox="0 0 24 24" set:html={icons.bold} /></span>
										<span><svg viewBox="0 0 24 24" set:html={icons.italic} /></span>
										<span><svg viewBox="0 0 24 24" set:html={icons.heading} /></span>
										<span class="edit-toolbar-sep"></span>
										<span><svg viewBox="0 0 24 24" set:html={icons.list} /></span>
										<span><svg viewBox="0 0 24 24" set:html={icons.link} /></span>
									</div>
									<div class="edit-body thread">
										<p><strong>The best tools</strong> do one thing well.<span class="editor-caret"></span></p>
									</div>
								</div>
							</div>
							<div class="ui-foot ui-foot--end">
								<span class="ui-btn ui-btn--primary">Publish</span>
							</div>
						</div>
						<p class="flow-caption"><span class="flow-num" aria-hidden="true">02</span><strong>Edit</strong><span>Drafts, revisions, and preview</span></p>
						<span class="flow-link" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icons.chevron} /></span>
					</li>

					<li class="flow-step">
						<div
							class="ui flow-panel"
							role="img"
							aria-label="The generated emdash-env.d.ts file, showing the Post interface with system fields followed by title, excerpt, and content."
						>
							<div class="ui-bar">
								<span class="ui-file">emdash-env.d.ts</span>
								<span class="ui-pill"><span class="ui-pill-dot ui-pill-dot--accent"></span>Generated</span>
							</div>
							<div class="code">
								{typeLines.map((line, index) => (
									<div class:list={["code-line", { thread: line.thread }]}>
										<span class="code-n">{typeStartLine + index}</span>
										<code set:html={line.html} />
									</div>
								))}
							</div>
						</div>
						<p class="flow-caption"><span class="flow-num" aria-hidden="true">03</span><strong>Type</strong><span>Types generated from your schema</span></p>
						<span class="flow-link" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={icons.chevron} /></span>
					</li>

					<li class="flow-step">
						<div
							class="ui flow-panel"
							role="img"
							aria-label="The published post rendered on the site at yoursite.com/blog/small-tools-big-impact."
						>
							<div class="ui-bar">
								<span class="ui-url">
									<svg viewBox="0 0 24 24" set:html={icons.lock} />
									<span class="ui-url-text"><span class="ui-url-host">yoursite.com</span>/blog/small-tools-big-impact</span>
								</span>
							</div>
							<div class="site">
								<p class="site-meta">Blog · June 1</p>
								<p class="site-title">Small tools, big impact</p>
								<p class="site-excerpt">Notes on building software that does less, and does it well.</p>
								<div class="site-body thread">
									<p><strong>The best tools</strong> do one thing well.</p>
									<span class="sk sk--100"></span>
									<span class="sk sk--100"></span>
									<span class="sk sk--72"></span>
								</div>
								<span class="sk sk--100"></span>
								<span class="sk sk--90"></span>
							</div>
						</div>
						<p class="flow-caption"><span class="flow-num" aria-hidden="true">04</span><strong>Render</strong><span>Astro pages via <code>getEmDashEntry()</code></span></p>
					</li>
				</ol>
			</div>

			{/* 2. Familiar CMS experience. */}
			<div class="cap-card cap-card--familiar">
				<div class="cap-copy">
					<h3 class="cap-title">Familiar from the first login</h3>
					<p class="cap-text">
						Pages, posts, media, menus, widgets, and taxonomies, organized the way WordPress users expect. Bring
						existing content over with the built-in WordPress importer.
					</p>
				</div>
				<div
					class="cap-visual visual-familiar"
					role="img"
					aria-label="The EmDash admin sidebar with Pages, Posts, and Media under Content, and Comments, Menus, Redirects, Widgets, Sections, Categories, Tags, and Bylines under Manage, beside a completed WordPress import of posts, pages, media, categories, and tags."
				>
					<div class="ui admin-nav">
						<div class="admin-brand">
							<svg class="admin-logo" viewBox="0 0 75 75" fill="none">
								<rect x="3" y="3" width="69" height="69" rx="10.518" stroke="url(#cap-logo-border)" stroke-width="6" />
								<rect x="18" y="34" width="39.3661" height="6.56101" fill="url(#cap-logo-dash)" />
								<defs>
									<linearGradient id="cap-logo-border" x1="-43" y1="124" x2="92.42" y2="-41.75" gradientUnits="userSpaceOnUse">
										<stop stop-color="#0F006B" />
										<stop offset="0.1667" stop-color="#5D0C83" />
										<stop offset="0.3333" stop-color="#CE2F55" />
										<stop offset="0.4167" stop-color="#FF6633" />
										<stop offset="0.5833" stop-color="#FBAD41" />
										<stop offset="0.75" stop-color="#FFE9CB" />
										<stop offset="1" stop-color="white" />
									</linearGradient>
									<linearGradient id="cap-logo-dash" x1="91.5" y1="27.5" x2="28.12" y2="54.18" gradientUnits="userSpaceOnUse">
										<stop stop-color="white" />
										<stop offset="0.1293" stop-color="#FFF8EE" />
										<stop offset="0.6171" stop-color="#FBAD41" />
										<stop offset="0.848" stop-color="#F6821F" />
										<stop offset="1" stop-color="#FF6633" />
									</linearGradient>
								</defs>
							</svg>
							My Site
						</div>
						{adminNav.map((group) => (
							<>
								<p class="admin-group">{group.label}</p>
								{group.items.map((item) => (
									<div class:list={["admin-item", { "is-active": item.active }]}>
										<svg class="ph" viewBox="0 0 256 256" set:html={item.icon} />
										{item.label}
									</div>
								))}
							</>
						))}
					</div>
					<div class="ui import-card">
						<div class="ui-bar">
							<span class="ui-strong">Import from WordPress</span>
							<span class="ui-pill"><span class="ui-pill-dot ui-pill-dot--success"></span>Complete</span>
						</div>
						<div class="import-file">
							<svg class="ph" viewBox="0 0 256 256" set:html={ph.fileText} />
							<code>export.xml</code>
							<span>2.4 MB</span>
						</div>
						<ul class="import-list">
							{importRows.map((row) => (
								<li>
									<svg class="ph" viewBox="0 0 256 256" set:html={ph.checkCircle} />
									<span>{row.label}</span>
									<span class="import-count">{row.count}</span>
								</li>
							))}
						</ul>
					</div>
				</div>
			</div>

			{/* 3. Editorial workflows. */}
			<div class="cap-card cap-card--editorial">
				<div class="cap-copy">
					<h3 class="cap-title">Drafts, revisions, and scheduling built in</h3>
					<p class="cap-text">
						Changes save as drafts while the live page stays untouched. Restore earlier revisions, schedule
						publishing, and share signed preview links before anything goes live.
					</p>
				</div>
				<div
					class="cap-visual visual-editorial"
					role="img"
					aria-label="A revision history beside the EmDash publish panel. The live version published on March 12 stays public while saved draft changes wait, ready to publish now or schedule for later."
				>
					<div class="timeline">
						<div class="tl-item">
							<span class="tl-dot"></span>
							<p class="tl-time">Mar 12</p>
							<p class="tl-label">Published</p>
						</div>
						<div class="tl-item">
							<span class="tl-dot"></span>
							<p class="tl-time">Yesterday</p>
							<p class="tl-label">Revision saved</p>
						</div>
						<div class="tl-item tl-item--current ui">
							<span class="tl-dot"></span>
							<p class="tl-time">Just now</p>
							<p class="tl-label">Draft autosaved</p>
						</div>
					</div>
					<div class="ui publish">
						<div class="publish-bar">
							<span class="ui-btn ui-btn--primary"><svg class="ph" viewBox="0 0 256 256" set:html={ph.upload} />Publish changes</span>
						</div>
						<div class="publish-body">
							<div class="publish-head">
								<p class="publish-title">Publish</p>
								<svg class="ph publish-handle" viewBox="0 0 256 256" set:html={ph.dotsSixVertical} />
							</div>
							<div class="publish-summary">
								<div class="publish-versions">
									<div class="publish-row">
										<svg class="ph publish-icon publish-icon--live" viewBox="0 0 256 256" set:html={ph.checkCircle} />
										<p><strong>Live version</strong><span>Visitors still see the published version</span></p>
									</div>
									<div class="publish-row">
										<svg class="ph publish-icon publish-icon--draft" viewBox="0 0 256 256" set:html={ph.arrowsClockwise} />
										<p><strong>Draft changes</strong><span>Ready to publish now or schedule for later</span></p>
									</div>
								</div>
								<div class="publish-meta">
									<p><span>Publication date</span><span class="publish-value">Mar 12, 9:00 AM<svg class="ph" viewBox="0 0 256 256" set:html={ph.pencilSimple} /></span></p>
									<p><span>Created and updated</span><svg class="ph" viewBox="0 0 256 256" set:html={ph.caretDown} /></p>
								</div>
							</div>
							<span class="ui-btn publish-schedule"><svg class="ph" viewBox="0 0 256 256" set:html={ph.calendarPlus} />Schedule</span>
						</div>
					</div>
				</div>
			</div>

			{/* 4. Agents. */}
			<div class="cap-card cap-card--agents">
				<div class="cap-copy">
					<h3 class="cap-title">An MCP server in every site</h3>
					<p class="cap-text">
						Connect Claude, Codex, Cursor, or any MCP client to draft, edit, search, and schedule content under the
						same publishing rules as your team. Scripts get the same operations through the REST API and CLI.
					</p>
				</div>
				<div
					class="cap-visual visual-agents"
					role="img"
					aria-label="Claude, one of several MCP clients alongside Codex, Cursor, and OpenCode, is connected to the site's emdash MCP server. Asked to draft a summer sale post for June 1 at 9 AM, it calls search, content_create, and content_schedule, and the post is scheduled for June 1 at 9 AM."
				>
					<ul class="clients">
						{agentClients.map((client) => (
							<li class:list={["client", { "is-active": "active" in client }]}>
								{"logo" in client ? (
									<AgentLogos only={[client.logo]} />
								) : (
									<svg class="ph" viewBox="0 0 256 256" set:html={ph.plus} />
								)}
								<span>{client.label}</span>
							</li>
						))}
					</ul>
					<div class="ui session">
						<div class="ui-bar session-bar">
							<AgentLogos only={["claude"]} />
							<span class="ui-strong">Claude</span>
						</div>
						<div class="session-body">
							<p class="session-ask">Draft a summer sale post for June 1 at 9 AM.</p>
							<div class="session-tools">
								<p class="session-tools-head"><svg class="ph" viewBox="0 0 256 256" set:html={ph.caretDown} />3 tool calls</p>
								{agentTools.map((tool) => (
									<div class="session-tool">
										<div class="session-tool-row">
											<span class="session-tool-icon">
												<svg class="ph" viewBox="0 0 256 256" set:html={tool.detail ? ph.caretDown : tool.icon} />
											</span>
											<span class="session-tool-label">{tool.label}</span>
											<code class="session-tool-chip">{tool.tool}</code>
										</div>
										{tool.detail && (
											<div class="session-tool-detail">
												{tool.detail.map((line) => <code>{line}</code>)}
											</div>
										)}
									</div>
								))}
							</div>
							<div class="session-result">
								<span class="session-result-icon"><svg class="ph" viewBox="0 0 256 256" set:html={ph.newspaperFill} /></span>
								<p><strong>Summer sale starts June 1</strong><span>Scheduled for Jun 1, 9:00 AM</span></p>
							</div>
						</div>
					</div>
