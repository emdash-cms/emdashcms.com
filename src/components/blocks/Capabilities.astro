// The editor's slash menu scrolled to its end: the built-in Section command,
// then this site's plugin blocks in registration order. Plugin blocks without
// an icon get the admin's default Cube.
const slashItems = [
	{ label: "Section", description: "Insert a reusable section", icon: ph.stack },
	{ label: "Hero", description: "Headline with optional links or agent actions", icon: ph.cube },
	{ label: "Capabilities", description: "Feature bento with product illustrations", icon: ph.cube, active: true },
	{ label: "Features", description: "Grid of feature cards with icons", icon: ph.cube },
	{ label: "Testimonials", description: "Customer testimonial cards", icon: ph.cube },
];

// Capability labels as the admin's consent dialog words them.
const consentCapabilities = ["Read your content", "Make network requests to: hooks.slack.com"];

const isolateDenied = [
	{ label: "Environment variables", icon: ph.key },
	{ label: "Filesystem", icon: ph.hardDrives },
	{ label: "Other plugins’ storage", icon: ph.database },
	{ label: "Undeclared hosts", icon: ph.globeSimple },
];

// Field rows copy the admin's custom-field list: label, slug, type, and flags.
const schemaFields = [
	{ label: "Title", slug: "title", type: "String", flags: ["Required", "Searchable"] },
