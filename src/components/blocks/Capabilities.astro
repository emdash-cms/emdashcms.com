		margin-top: 0.3125rem !important;
		color: var(--cap-muted);
		font-size: 0.6875rem;
		line-height: 1.45;
		text-wrap: pretty;
	}

	.site-body {
		margin-top: 0.625rem;
		padding: 0.3125rem 0.5rem 0.4375rem;
		font-size: 0.6875rem;
	}

	.site-body .sk:first-of-type {
		margin-top: 0.5rem;
	}

	.site-body + .sk {
		margin-top: 0.75rem;
	}

	/* ---------- Familiar admin ---------- */

	/* The sidebar runs off the bottom of the card and fades out. */
	.visual-familiar {
		align-items: flex-start;
		height: 17.5rem;
		min-height: 0;
		flex: 0 0 auto;
		margin-top: auto;
		overflow: hidden;
		padding-bottom: 0;
	}

	.admin-nav {
		width: 11.5rem;
		padding-bottom: 1.25rem;
		border-bottom: 0;
		border-radius: 12px 12px 0 0;
		-webkit-mask-image: linear-gradient(to bottom, #000 70%, transparent);
		mask-image: linear-gradient(to bottom, #000 70%, transparent);
	}

	.admin-brand {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.75rem 1rem;
		font-size: 0.8125rem;
		font-weight: 600;
		border-bottom: 1px solid var(--cap-line);
	}

	.admin-brand .admin-logo {
		width: 1rem;
		height: 1rem;
		stroke: none;
	}

	.admin-group {
		margin: 0.625rem 0.5rem 0.25rem !important;
		padding: 0 0.5rem 0.3125rem;
		color: var(--cap-subtle);
		font-size: 0.6875rem;
		font-weight: 500;
		border-bottom: 1px solid var(--cap-line);
	}

	.admin-item {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		margin-inline: 0.5rem;
		padding: 0.3125rem 0.5rem;
		font-weight: 500;
		border-radius: 7px;
	}

	.admin-item svg {
		width: 0.875rem;
		height: 0.875rem;
		opacity: 0.45;
	}

	.admin-item.is-active {
		background: var(--cap-ui-tint);
	}

	/* Phosphor glyphs are filled shapes, not strokes. */
	.ui svg.ph,
	.ui-btn svg.ph {
		fill: currentColor;
		stroke: none;
	}

	.ui-pill-dot--success {
		background: var(--cap-success);
	}

	.import-card {
		width: 14.5rem;
		margin-top: 3.25rem;
		margin-inline-start: -2.5rem;
		overflow: hidden;
	}

	.import-file {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		margin: 0.625rem 0.75rem 0.25rem;
		padding: 0.375rem 0.5rem;
		color: var(--cap-subtle);
		font-size: 0.625rem;
		border: 1px solid var(--cap-ui-border);
		border-radius: 7px;
	}

	.import-file svg {
		width: 0.875rem;
		height: 0.875rem;
	}

	.import-file code {
		color: var(--color-text);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
	}

	.import-file span {
		margin-inline-start: auto;
	}

	.import-list {
		display: grid;
		gap: 0.125rem;
		margin: 0;
		padding: 0.25rem 0.75rem 0.625rem;
		list-style: none;
	}

	.import-list li {
		display: flex;
		align-items: center;
		gap: 0.4375rem;
		padding: 0.25rem 0.125rem;
	}

	.import-list svg {
		width: 0.875rem;
		height: 0.875rem;
		color: var(--cap-success);
	}

	.import-count {
		margin-inline-start: auto;
		color: var(--cap-subtle);
		font-size: 0.6875rem;
		font-variant-numeric: tabular-nums;
	}

	/* ---------- Editorial workflow ---------- */

	.visual-editorial {
		gap: var(--spacing-lg);
	}

	.timeline {
		position: relative;
		display: flex;
		width: 10.5rem;
		flex: 0 0 auto;
		flex-direction: column;
		gap: 0.75rem;
		padding-inline-start: 0.25rem;
	}

	.timeline::before {
		position: absolute;
		inset-block: 0.75rem;
		inset-inline-start: 0.9375rem;
		width: 1px;
		background: var(--cap-line);
		content: "";
	}

	.tl-item {
		position: relative;
		padding: 0.5rem 0.75rem 0.5rem 1.75rem;
		font-size: 0.75rem;
		line-height: 1.35;
	}

	.tl-item p {
		margin: 0;
	}

	.tl-dot {
		position: absolute;
		inset-block-start: 0.875rem;
		inset-inline-start: 0.5rem;
		width: 0.4375rem;
		height: 0.4375rem;
		background: var(--color-surface);
		border: 1.5px solid var(--cap-subtle);
		border-radius: 50%;
	}

	.tl-item--current {
		margin-inline-start: -0.25rem;
		padding-inline-start: 2rem;
	}

	.tl-item--current .tl-dot {
		inset-inline-start: 0.75rem;
		background: var(--color-primary);
		border-color: var(--color-primary);
		box-shadow: 0 0 0 3px var(--heat-20);
	}

	.tl-time {
		color: var(--cap-subtle);
		font-size: 0.6875rem;
	}

	.tl-label {
		font-weight: 500;
	}

	/* Mirrors the editor's Publish panel: action bar, summary card, schedule. */
	.publish {
		width: 18.25rem;
		flex: 0 0 auto;
		overflow: hidden;
	}

	.publish-bar {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--cap-line);
	}

	.publish-body {
		display: grid;
		gap: 0.625rem;
		padding: 0.75rem;
	}

	.publish-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}

	.publish-title {
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.publish-handle {
		width: 0.875rem;
		height: 0.875rem;
		color: var(--cap-subtle);
	}

	.publish-summary {
		overflow: hidden;
		border: 1px solid var(--cap-ui-border);
		border-radius: 9px;
	}

	.publish-versions {
		display: grid;
		gap: 0.75rem;
		padding: 0.625rem;
	}

	.publish-row {
		position: relative;
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
	}

	/* Connector between the live and draft rows, as in the admin. */
	.publish-row:first-child::after {
		position: absolute;
		inset-block: 1.125rem -0.625rem;
		inset-inline-start: calc(0.4375rem - 0.5px);
		width: 1px;
		background: var(--cap-ui-border);
		content: "";
	}

	.publish-icon {
		width: 0.875rem;
		height: 0.875rem;
		margin-top: 0.0625rem;
	}

	.publish-icon--live {
		color: var(--cap-success);
	}

	.publish-icon--draft {
		color: var(--color-warning);
	}

	.publish-row p {
		display: grid;
		gap: 0.125rem;
	}

	.publish-row strong {
		font-weight: 600;
	}

	.publish-row span {
		color: var(--cap-subtle);
		font-size: 0.6875rem;
		text-wrap: pretty;
	}

	.publish-meta {
		display: grid;
		padding: 0.25rem 0.625rem;
		color: var(--cap-subtle);
		font-size: 0.6875rem;
		border-top: 1px solid var(--cap-line);
	}

	.publish-meta p {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.3125rem 0;
		white-space: nowrap;
	}

	.publish-meta svg {
		width: 0.6875rem;
		height: 0.6875rem;
	}

	.publish-value {
		display: inline-flex;
		align-items: center;
		gap: 0.3125rem;
		color: var(--cap-muted);
	}

	.publish-schedule {
		justify-content: center;
		background: transparent;
		border: 1px solid var(--cap-ui-border);
	}

	/* ---------- Agents ---------- */

	/* Clients on the left, one live session on the right, joined by a hairline. */
	.visual-agents {
		--agents-gap: 2rem;
		gap: var(--agents-gap);
	}

	.clients {
		display: grid;
		width: 8.75rem;
		flex: 0 0 auto;
		gap: 0.125rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Fade toward the ends of the list. A mask would clip the connector. */
	.client:first-child,
	.client:last-child {
		opacity: 0.5;
	}

	.client:nth-child(2),
	.client:nth-child(4) {
		opacity: 0.8;
	}

	.client {
		--agent-logo-size: 0.875rem;
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4375rem 0.625rem;
		color: var(--cap-muted);
		font-size: 0.75rem;
		white-space: nowrap;
		border-radius: 8px;
	}

	.client svg.ph {
		width: 0.875rem;
		height: 0.875rem;
		fill: currentColor;
	}

	.client.is-active {
		color: var(--color-text);
		font-weight: 600;
		background: var(--color-surface);
		box-shadow:
			0 0 0 1px var(--cap-ui-border),
			var(--cap-ui-shadow);
	}

	.client.is-active::after {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 100%;
		width: var(--agents-gap);
		height: 1px;
		background: var(--cap-ui-border);
		content: "";
	}

	.session {
		width: min(100%, 22.5rem);
		flex: 0 1 auto;
		overflow: hidden;
	}

	.session-bar {
		--agent-logo-size: 0.875rem;
		gap: 0.4375rem;
	}

	.session-body {
		display: grid;
		gap: 0.625rem;
		padding: 0.75rem;
	}

	.session-ask {
		justify-self: end;
		max-width: 85%;
		padding: 0.4375rem 0.6875rem;
		background: var(--cap-ui-tint);
		border-radius: 10px 10px 3px 10px;
		text-wrap: pretty;
	}

	/* Tool-call trace: collapsible header, icon + label + chip rows, one expanded. */
	.session-tools {
		display: grid;
	}

	.session-tools-head {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		color: var(--cap-muted);
		font-variant-numeric: tabular-nums;
	}

	.session-tools-head svg {
		width: 0.6875rem;
		height: 0.6875rem;
	}

	.session-tool:first-of-type {
		margin-top: 0.375rem;
	}

	.session-tool + .session-tool {
		margin-top: 0.25rem;
	}

	.session-tool-row {
		display: flex;
		min-width: 0;
		height: 1.625rem;
		align-items: center;
		gap: 0.5rem;
	}

	.session-tool-icon {
		display: grid;
		width: 1rem;
		height: 1rem;
		flex: 0 0 auto;
		place-items: center;
		color: var(--cap-subtle);
	}

	.session-tool-icon svg {
		width: 0.8125rem;
		height: 0.8125rem;
	}

	.session-tool-label {
		flex: 0 0 auto;
		font-weight: 500;
		white-space: nowrap;
	}

	.session-tool-chip {
		display: block;
		min-width: 0;
		flex: 1 1 auto;
		height: 1.3125rem;
		overflow: hidden;
		padding: 0 0.375rem;
		color: var(--cap-muted);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		line-height: 1.3125rem;
		text-overflow: ellipsis;
		white-space: nowrap;
		background: var(--cap-ui-tint);
		border-radius: 5px;
		box-shadow: inset 0 0 0 1px var(--cap-line);
	}

	.session-tool-detail {
		display: grid;
		gap: 0.125rem;
		margin: 0.125rem 0 0.25rem 0.5rem;
		padding: 0.125rem 0 0.125rem 0.875rem;
		border-inline-start: 1px solid var(--cap-ui-border);
	}

	.session-tool-detail code {
		overflow: hidden;
		color: var(--cap-muted);
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		line-height: 1.6;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.session-result {
		display: flex;
		align-items: center;
		gap: 0.5625rem;
		padding: 0.5rem 0.625rem 0.5rem 0.5rem;
		border: 1px solid var(--cap-ui-border);
		border-radius: 9px;
	}

	.session-result-icon {
		display: grid;
		width: 1.75rem;
		height: 1.75rem;
		flex: 0 0 auto;
		place-items: center;
		color: var(--color-primary);
		background: var(--heat-8);
		border-radius: 7px;
	}

	.session-result-icon svg {
		width: 0.875rem;
		height: 0.875rem;
	}

	.session-result p {
		display: grid;
		min-width: 0;
		gap: 0.0625rem;
	}

	.session-result strong {
		font-weight: 600;
		text-wrap: balance;
	}

	.session-result span {
		color: var(--cap-subtle);
		font-size: 0.6875rem;
	}

	/* ---------- Extend ---------- */

	/* The plugin source sits behind the insert menu it produces. Both share
	   one grid cell, so the stack is always as tall as its taller layer. */
	.ext-stack {
		display: grid;
		width: min(100%, 23rem);
	}

	.ext-stack > * {
		grid-area: 1 / 1;
	}

	.ext-code {
		display: flex;
		width: 88%;
		height: 11.25rem;
		flex-direction: column;
		overflow: hidden;
	}

	.ui-file-dir {
		color: var(--cap-subtle);
	}

	.ext-code .ui-bar {
		overflow: hidden;
	}

	.ext-code .ui-file {
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.code :global(.tok-s) {
		color: var(--cap-muted);
	}

	/* Mirrors the admin's slash menu: plain icon, title, and description rows. */
	.ext-menu {
		justify-self: end;
		align-self: start;
		width: min(15.75rem, 80%);
		/* Clears the bar and the first three lines, so the threaded label stays visible. */
		margin-top: 6.875rem;
		padding: 0.25rem;
		border-radius: 10px;
		box-shadow:
			var(--cap-ui-shadow),
			0 24px 40px -24px rgba(0, 0, 0, 0.35);
	}

	/* The menu scrolls on past the viewport: fade the row it cuts. */
	.ext-menu-list {
		display: grid;
		max-height: 10.75rem;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 2rem), transparent);
		mask-image: linear-gradient(to bottom, #000 calc(100% - 2rem), transparent);
	}

	.ext-item {
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 0.625rem;
		padding: 0.4375rem 0.625rem;
		border-radius: 6px;
	}

	.ext-item.is-active {
		background: var(--cap-ui-tint);
	}

	.ext-item svg {
		width: 0.875rem;
		height: 0.875rem;
		color: var(--cap-subtle);
	}

	.ext-item p {
		display: grid;
		min-width: 0;
	}

	.ext-item strong {
		font-weight: 500;
	}

	.ext-item span {
		overflow: hidden;
		color: var(--cap-subtle);
		font-size: 0.6875rem;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	/* ---------- Security ---------- */

	.visual-secure {
		flex-wrap: wrap;
		align-items: center;
		gap: 1.25rem;
	}

	/* Mirrors the admin's capability consent dialog. */
	.consent {
		width: 17.5rem;
		flex: 0 1 auto;
		overflow: hidden;
	}

	.consent-head {
		padding: 0.75rem 0.875rem 0.6875rem;
		border-bottom: 1px solid var(--cap-line);
	}

	.consent-title {
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.consent-sub {
		margin-top: 0.1875rem !important;
		color: var(--cap-subtle);
		font-size: 0.6875rem;
		text-wrap: pretty;
	}

	.consent-body {
		display: grid;
		gap: 0.375rem;
		padding: 0.625rem 0.875rem 0.75rem;
	}

	.consent-cap {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		padding: 0.4375rem 0.5rem;
		background: var(--cap-ui-tint);
		border-radius: 6px;
		overflow-wrap: anywhere;
	}

	.consent-cap svg {
		width: 0.875rem;
		height: 0.875rem;
		margin-top: 0.0625rem;
		color: var(--cap-subtle);
	}

	.consent-foot {
		display: flex;
		justify-content: flex-end;
		gap: 0.375rem;
		padding: 0.5rem 0.875rem;
		border-top: 1px solid var(--cap-line);
	}

	.ui-btn--ghost {
		color: var(--cap-muted);
		background: transparent;
	}

	/* What the plugin's isolate can't reach, whatever it declares. */
	.isolate {
		width: 14.5rem;
		flex: 0 1 auto;
		overflow: hidden;
	}

	.isolate .ui-bar svg {
		width: 0.8125rem;
		height: 0.8125rem;
	}

	.isolate-tag {
		margin-inline-start: auto;
	}

	.isolate-body {
		padding: 0.625rem 0.875rem 0.5rem;
	}

	.isolate-label {
		color: var(--cap-subtle);
		font-size: 0.6875rem;
		font-weight: 500;
	}

	.isolate-list {
		display: grid;
		margin: 0.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.isolate-list li {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.375rem 0;
		color: var(--cap-muted);
	}

	.isolate-list li + li {
		border-top: 1px solid var(--cap-line);
	}

	.isolate-list svg {
		width: 0.8125rem;
		height: 0.8125rem;
		color: var(--cap-subtle);
	}

	/* ---------- Tablet ---------- */

	@media (min-width: 640px) {
		.flow {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			row-gap: var(--spacing-xl);
		}

		/* Horizontal connectors within each row; none across the row wrap. */
		.flow-step:not(:last-child)::after {
			inset-block-start: calc(var(--flow-panel-h) / 2);
			inset-inline-start: 100%;
			width: var(--flow-gap);
			height: 1px;
		}

		.flow-link {
			inset-block-start: calc(var(--flow-panel-h) / 2 - 0.5625rem);
			inset-inline-start: calc(100% + var(--flow-gap) / 2 - 0.5625rem);
		}

		.flow-link svg {
			transform: none;
		}

		:global([dir="rtl"]) .flow-link svg {
			transform: scaleX(-1);
		}

		.flow-step:nth-child(2)::after,
		.flow-step:nth-child(2) .flow-link {
			display: none;
		}

		.cap-headline {
			font-size: var(--font-size-4xl);
		}
	}

	/* ---------- Large screens: editorial header, roomier cards ---------- */

	@media (min-width: 1024px) {
		.capabilities {
			padding: var(--spacing-4xl) 0 var(--spacing-2xl);
		}

		.cap-container {
			gap: var(--spacing-3xl);
		}

		.cap-header {
			grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
			align-items: end;
			gap: var(--spacing-2xl);
		}

		.cap-headline {
			max-width: 46rem;
			font-size: clamp(2.75rem, 4.6vw, var(--font-size-5xl));
			line-height: 1.02;
		}

		.cap-intro {
			justify-self: end;
			padding-bottom: 0.375rem;
			font-size: var(--font-size-lg);
		}

		.cap-copy {
			padding: var(--spacing-2xl) var(--spacing-2xl) 0;
		}

		.cap-card--anchor .cap-copy--anchor {
			display: grid;
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
			align-items: end;
			gap: var(--spacing-2xl);
		}

		.cap-card--anchor .cap-text {
			justify-self: end;
			max-width: 29rem;
			margin-top: 0;
		}

		.cap-title--anchor {
			font-size: 2.25rem;
		}

		.cap-visual {
			min-height: 17.5rem;
			padding: var(--spacing-lg) var(--spacing-2xl);
		}

		.visual-familiar {
			padding-top: var(--spacing-xl);
			padding-bottom: 0;
		}

		.flow {
			padding: var(--spacing-2xl);
		}
	}

	/*
	 * ---------- Desktop bento ----------
	 * The asymmetric grid and the four-step flow need the full container
	 * width; below it the cards stack and the flow stays two-by-two so the
	 * illustrations never clip.
	 */

	@media (min-width: 1200px) {
		.cap-grid {
			grid-template-columns: repeat(12, minmax(0, 1fr));
		}

		.cap-card--anchor {
			grid-column: 1 / -1;
		}

		.cap-card--familiar {
			grid-column: span 5;
		}

