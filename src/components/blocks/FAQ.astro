---
import { sanitizeHref } from "emdash";

interface Props {
	node: {
		_key?: string;
		headline?: string;
		ctaHeadline?: string;
		ctaDescription?: string;
		ctaPrimaryLabel?: string;
		ctaPrimaryUrl?: string;
		ctaSecondaryLabel?: string;
		ctaSecondaryUrl?: string;
		items?: Array<{
			question: string;
			answer: string;
		}>;
	};
}

const { node } = Astro.props;
const { _key, headline } = node;
const items = Array.isArray(node.items) ? node.items : [];
const headingId = `${_key ?? "faq"}-heading`;
const ctaHeadingId = `${_key ?? "faq"}-cta-heading`;
const markGradientId = `${_key ?? "faq"}-closing-gradient`;
const ctaHeadline = node.ctaHeadline?.trim() || "The site is yours. The work is shared.";
const ctaDescription = node.ctaDescription?.trim() || "Build in Astro, manage content in EmDash, and let authorized agents help without handing over control.";
const primaryLabel = node.ctaPrimaryLabel?.trim() || "Try the playground";
const primaryUrl = sanitizeHref(node.ctaPrimaryUrl?.trim() || "https://try.emdashcms.com/");
const secondaryLabel = node.ctaSecondaryLabel?.trim() || "Read the docs";
const secondaryUrl = sanitizeHref(node.ctaSecondaryUrl?.trim() || "https://docs.emdashcms.com/getting-started/");
---

{items.length > 0 && (
	<>
	<section class="faq" id={_key} aria-labelledby={headingId}>
		<div class="faq-container container">
			<div class="faq-intro">
				<header class="faq-header">
					<p class="faq-eyebrow">Questions</p>
					<h2 id={headingId}>{headline?.trim() || "Good to know."}</h2>
					<p class="faq-subline">The important details, before you build.</p>
				</header>
				<aside class="faq-help" aria-labelledby={`${headingId}-help`}>
					<svg class="help-icon" viewBox="0 0 36 36" fill="none" aria-hidden="true">
						<path d="M18 10c-4-2-8-2-12 0v17c4-2 8-2 12 0 4-2 8-2 12 0V10c-4-2-8-2-12 0Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
						<path d="M18 10v17" stroke="currentColor" stroke-width="1.7" />
					</svg>
					<h3 id={`${headingId}-help`}>Want to go deeper?</h3>
					<p>Get the details in the docs, or ask the people building EmDash.</p>
					<div class="help-links">
						<a href="https://docs.emdashcms.com/">Read the docs <span aria-hidden="true">↗</span></a>
						<a href="https://discord.gg/YY9vBaQRYt">Join the community <span aria-hidden="true">↗</span></a>
					</div>
				</aside>
			</div>
			<div class="faq-list" data-faq-list>
				{items.map((item) => (
					<details class="faq-item" data-faq-item>
						<summary class="faq-question" data-faq-trigger>
							<span>{item.question}</span>
							<svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path d="M6 9l6 6 6-6" />
							</svg>
						</summary>
						<div class="faq-answer" data-faq-answer>
							<div class="faq-answer-inner"><p>{item.answer}</p></div>
						</div>
					</details>
				))}
			</div>
		</div>
	</section>
	<section class="closing-cta" aria-labelledby={ctaHeadingId}>
		<div class="closing-panel container">
			<div class="closing-copy">
				<p class="closing-eyebrow">Built for what comes next</p>
				<h2 id={ctaHeadingId}>{ctaHeadline}</h2>
				<p class="closing-description">{ctaDescription}</p>
				<div class="closing-actions">
					<a class="closing-primary" href={primaryUrl}>{primaryLabel} <span aria-hidden="true">↗</span></a>
					<a class="closing-secondary" href={secondaryUrl}>{secondaryLabel} <span aria-hidden="true">↗</span></a>
				</div>
			</div>
			<div class="closing-art" aria-hidden="true">
				<svg viewBox="0 0 420 420" fill="none">
					<defs>
						<linearGradient id={markGradientId} x1="70" y1="340" x2="345" y2="45" gradientUnits="userSpaceOnUse">
							<stop stop-color="#ff5e1f" /><stop offset="0.55" stop-color="#ffb25c" /><stop offset="1" stop-color="#fff4e8" />
						</linearGradient>
					</defs>
					<circle cx="210" cy="210" r="181" stroke="#ffffff19" stroke-width="1" stroke-dasharray="2 9" />
					<path class="closing-trace" d="M20 210h73m234 0h73" stroke="#ff9568" stroke-width="1.5" stroke-dasharray="3 7" />
					<rect x="101" y="101" width="218" height="218" rx="33" stroke={`url(#${markGradientId})`} stroke-width="12" />
					<path d="M145 210h130" stroke={`url(#${markGradientId})`} stroke-width="12" stroke-linecap="round" />
				</svg>
				<span class="closing-label closing-label--astro"><span>{`{}`}</span> Astro</span>
				<span class="closing-label closing-label--editor"><span>◎</span> Editor</span>
				<span class="closing-label closing-label--agent"><span>✳</span> Agent</span>
			</div>
		</div>
	</section>
	</>
)}

<script is:inline>
	(() => {
		const lists = document.querySelectorAll("[data-faq-list]");
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

		const getAnswer = (item) => item.querySelector("[data-faq-answer]");

		function finishAnimation(answer) {
			answer.getAnimations().forEach((animation) => animation.cancel());
			answer.style.height = "";
			answer.style.opacity = "";
		}

		function openItem(item) {
			const answer = getAnswer(item);
			if (!answer || item.open) return;

			if (reduceMotion.matches) {
				item.open = true;
				return;
			}

			finishAnimation(answer);
			item.open = true;

			const targetHeight = answer.scrollHeight;
			answer.style.height = `${targetHeight}px`;
			answer.style.opacity = "1";

			const animation = answer.animate(
				[
					{ height: "0px", opacity: 0 },
					{ height: `${targetHeight}px`, opacity: 1 },
				],
				{ duration: 180, easing: "cubic-bezier(0.16, 1, 0.3, 1)" },
			);

			animation.onfinish = () => finishAnimation(answer);
		}

		function closeItem(item) {
			const answer = getAnswer(item);
			if (!answer || !item.open) return;

			if (reduceMotion.matches) {
				item.open = false;
				return;
			}

			finishAnimation(answer);
			const startHeight = answer.scrollHeight;
			answer.style.height = "0px";
			answer.style.opacity = "0";

			const animation = answer.animate(
				[
					{ height: `${startHeight}px`, opacity: 1 },
					{ height: "0px", opacity: 0 },
				],
				{ duration: 160, easing: "cubic-bezier(0.4, 0, 0.2, 1)" },
			);

			animation.onfinish = () => {
				item.open = false;
				finishAnimation(answer);
			};
		}

		lists.forEach((list) => {
			if (list.dataset.faqReady === "true") return;
			list.dataset.faqReady = "true";

			list.querySelectorAll("[data-faq-trigger]").forEach((trigger) => {
				trigger.addEventListener("click", (event) => {
					const item = trigger.closest("[data-faq-item]");
					if (!item) return;

					event.preventDefault();

					if (item.open) {
						closeItem(item);
						return;
					}

					list.querySelectorAll("[data-faq-item][open]").forEach((openItemElement) => {
						if (openItemElement !== item) closeItem(openItemElement);
					});
					openItem(item);
				});
			});
		});
	})();
</script>

<style>
	.faq {
		scroll-margin-top: 5.5rem;
		padding: clamp(4rem, 5vw, 5rem) 0 clamp(5rem, 7vw, 7rem);
		background: var(--color-bg);
		border-top: 1px solid var(--color-border);
	}
	.faq-container {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		align-items: start;
		gap: clamp(3rem, 7vw, 7rem);
		max-width: var(--wide-width);
	}
	.faq-intro { position: sticky; top: 7rem; min-width: 0; }
	.faq-eyebrow {
		margin-bottom: 0.9rem;
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 650;
		letter-spacing: 0.055em;
		text-transform: uppercase;
	}
	.faq-header h2 {
		max-width: 29rem;
		font-size: clamp(2.5rem, 4vw, 4.1rem);
		font-weight: 600;
		line-height: 1.07;
		letter-spacing: -0.05em;
		text-wrap: balance;
	}
	.faq-subline { max-width: 26rem; margin-top: 1rem; color: var(--color-muted); font-size: 1rem; line-height: 1.6; }
	.faq-help {
		max-width: 25rem;
		margin-top: clamp(2.5rem, 5vw, 4.5rem);
		padding: 1.5rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}
	.help-icon { display: block; width: 2.25rem; height: 2.25rem; color: var(--color-primary); }
	.faq-help h3 { margin-top: 1.1rem; font-size: 1.15rem; font-weight: 600; letter-spacing: -0.025em; }
	.faq-help p { max-width: 22rem; margin-top: 0.5rem; color: var(--color-muted); font-size: 0.83rem; line-height: 1.6; }
	.help-links { display: flex; flex-direction: column; gap: 0.85rem; margin-top: 1.5rem; }
	.help-links a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--color-text); font-size: 0.82rem; font-weight: 600; text-decoration: none; }
	.help-links a span { color: var(--color-primary); }
	.help-links a:hover { color: var(--color-primary); }
	.help-links a:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; border-radius: 2px; }
	.faq-list { min-width: 0; border-top: 1px solid var(--color-border); }
	.faq-item { border-bottom: 1px solid var(--color-border); }
	.faq-question {
		display: flex;
		min-height: 4.6rem;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.2rem 0;
		font-size: clamp(1rem, 1.15vw, 1.17rem);
		font-weight: 550;
		line-height: 1.45;
		cursor: pointer;
		list-style: none;
		transition: color var(--transition-fast);
	}
	.faq-question:hover, .faq-item[open] .faq-question { color: var(--color-primary); }
	.faq-question:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; border-radius: 2px; }
	.faq-question::-webkit-details-marker { display: none; }
	.faq-icon {
		width: 2rem;
		height: 2rem;
		flex: none;
		padding: 0.55rem;
		color: var(--color-muted);
		border: 1px solid var(--color-border);
		border-radius: 50%;
		transition: transform var(--transition-base), color var(--transition-fast), border-color var(--transition-fast);
	}
	.faq-item[open] .faq-icon { color: var(--color-primary); border-color: var(--heat-40); transform: rotate(180deg); }
	.faq-answer { overflow: hidden; }
	.faq-answer-inner { padding: 0 0 1.4rem; padding-inline-end: 3.5rem; }
	.faq-answer p { max-width: 53ch; color: var(--color-muted); font-size: 0.94rem; line-height: 1.65; }
	@media (max-width: 850px) {
		.faq-container { grid-template-columns: 1fr; gap: 3rem; }
		.faq-intro { position: static; }
		.faq-help { max-width: none; margin-top: 2rem; }
	}
	@media (max-width: 600px) {
		.faq-container { width: calc(100% - 2rem); }
		.faq-answer-inner { padding-inline-end: 1rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.faq-question, .faq-icon { transition: none; }
	}
	.closing-cta { padding: 0 clamp(1rem, 2.5vw, 2rem) clamp(5rem, 8vw, 8rem); background: var(--color-bg); }
	.closing-panel {
		display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); align-items: center; gap: 2rem;
		min-height: 30rem; max-width: var(--wide-width); overflow: hidden; padding: clamp(2rem, 5vw, 5rem);
		color: #f6f7f8; background: #1b1c20; border: 1px solid #ffffff25; border-radius: 1.25rem;
	}
	.closing-eyebrow { color: #ff9568; font-size: 0.72rem; font-weight: 650; letter-spacing: 0.06em; text-transform: uppercase; }
	.closing-copy h2 { max-width: 12ch; margin-top: 1.2rem; font-size: clamp(2.6rem, 4.7vw, 4.9rem); font-weight: 600; line-height: 1.05; letter-spacing: -0.055em; text-wrap: balance; }
	.closing-description { max-width: 33rem; margin-top: 1.4rem; color: #c1c3c8; font-size: clamp(1rem, 1.2vw, 1.13rem); line-height: 1.6; }
	.closing-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.3rem; margin-top: 2rem; }
	.closing-actions a { display: inline-flex; align-items: center; gap: 0.6rem; min-height: 2.8rem; font-size: 0.91rem; font-weight: 600; text-decoration: none; }
	.closing-actions a:focus-visible { outline: 2px solid #ff9568; outline-offset: 4px; border-radius: 0.35rem; }
	.closing-primary { padding: 0.7rem 1.1rem; color: #171717; background: #ff6d35; border-radius: 0.45rem; }
	.closing-primary:hover { background: #ff8956; }
	.closing-secondary { color: #f6f7f8; }
	.closing-secondary:hover { color: #ffb48e; }
	.closing-secondary span { color: #ff9568; }
	.closing-art { position: relative; width: min(100%, 27rem); margin-inline: auto; aspect-ratio: 1; background: radial-gradient(circle at 50% 50%, #ff5e1f12, transparent 62%); }
	.closing-art svg { display: block; width: 100%; height: 100%; filter: drop-shadow(0 15px 40px #ff5e1f23); }
	.closing-label { position: absolute; display: flex; align-items: center; gap: 0.4rem; padding: 0.5rem 0.7rem; color: #f6f7f8; background: #282a30; border: 1px solid #ffffff30; border-radius: 0.45rem; box-shadow: 0 12px 35px #0004; font-size: 0.72rem; font-weight: 600; }
	.closing-label > span { color: #ff9568; font-family: ui-monospace, SFMono-Regular, monospace; font-size: 0.9rem; }
	.closing-label--astro { top: 12%; left: 0; transform: rotate(-4deg); }
	.closing-label--editor { top: 24%; right: 0; transform: rotate(4deg); }
	.closing-label--agent { right: 10%; bottom: 7%; transform: rotate(-3deg); }
	@media (max-width: 850px) {
		.closing-panel { grid-template-columns: 1fr; gap: 0; }
		.closing-copy h2 { max-width: 15ch; }
		.closing-art { width: min(100%, 21rem); margin-top: 1rem; }
	}
	@media (max-width: 600px) {
		.closing-cta { padding-inline: 1rem; }
		.closing-panel { width: 100%; padding: 2rem 1.5rem 1rem; }
		.closing-copy h2 { font-size: clamp(2.35rem, 10vw, 3.6rem); }
		.closing-actions { gap: 0.4rem 1rem; }
		.closing-art { width: min(100%, 18rem); }
	}
	@media (prefers-reduced-motion: no-preference) {
		.closing-trace { animation: closing-travel 8s linear infinite; }
	}
	@keyframes closing-travel { to { stroke-dashoffset: -40; } }
</style>
