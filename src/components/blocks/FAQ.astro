---
interface Props {
	node: {
		_key?: string;
		headline?: string;
		items: Array<{
			question: string;
			answer: string;
		}>;
	};
}

const { node } = Astro.props;
const { _key, headline, items } = node;
const headingId = `${_key ?? "faq"}-heading`;
---

{items.length > 0 && (
	<section class="faq" id={_key} aria-labelledby={headingId}>
		<div class="faq-container container">
			<div class="faq-intro">
				<header class="faq-header">
					<p class="faq-eyebrow">Questions</p>
					<h2 id={headingId}>{headline?.trim() || "Good to know."}</h2>
					<p class="faq-subline">The important details, before you build.</p>
				</header>
				<aside class="faq-help" aria-labelledby={`${headingId}-help`}>
					<svg class="help-icon" viewBox="0 0 36 36" fill="none" aria-hidden="true">
						<path d="M18 10c-4-2-8-2-12 0v17c4-2 8-2 12 0 4-2 8-2 12 0V10c-4-2-8-2-12 0Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" />
						<path d="M18 10v17" stroke="currentColor" stroke-width="1.7" />
					</svg>
					<h3 id={`${headingId}-help`}>Want to go deeper?</h3>
					<p>Get the details in the docs, or ask the people building EmDash.</p>
					<div class="help-links">
						<a href="https://docs.emdashcms.com/">Read the docs <span aria-hidden="true">↗</span></a>
						<a href="https://discord.gg/YY9vBaQRYt">Join the community <span aria-hidden="true">↗</span></a>
					</div>
				</aside>
			</div>
			<div class="faq-list" data-faq-list>
				{items.map((item) => (
					<details class="faq-item" data-faq-item>
						<summary class="faq-question" data-faq-trigger>
							<span>{item.question}</span>
							<svg class="faq-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
								<path d="M6 9l6 6 6-6" />
							</svg>
						</summary>
						<div class="faq-answer" data-faq-answer>
							<div class="faq-answer-inner"><p>{item.answer}</p></div>
						</div>
					</details>
				))}
			</div>
		</div>
	</section>
)}

<script is:inline>
	(() => {
		const lists = document.querySelectorAll("[data-faq-list]");
		const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

		const getAnswer = (item) => item.querySelector("[data-faq-answer]");

		function finishAnimation(answer) {
			answer.getAnimations().forEach((animation) => animation.cancel());
			answer.style.height = "";
			answer.style.opacity = "";
		}

		function openItem(item) {
			const answer = getAnswer(item);
			if (!answer || item.open) return;

			if (reduceMotion.matches) {
				item.open = true;
				return;
			}

			finishAnimation(answer);
			item.open = true;

			const targetHeight = answer.scrollHeight;
			answer.style.height = `${targetHeight}px`;
			answer.style.opacity = "1";

			const animation = answer.animate(
				[
					{ height: "0px", opacity: 0 },
					{ height: `${targetHeight}px`, opacity: 1 },
				],
				{ duration: 180, easing: "cubic-bezier(0.16, 1, 0.3, 1)" },
			);

			animation.onfinish = () => finishAnimation(answer);
		}

		function closeItem(item) {
			const answer = getAnswer(item);
			if (!answer || !item.open) return;

			if (reduceMotion.matches) {
				item.open = false;
				return;
			}

			finishAnimation(answer);
			const startHeight = answer.scrollHeight;
			answer.style.height = "0px";
			answer.style.opacity = "0";

			const animation = answer.animate(
				[
					{ height: `${startHeight}px`, opacity: 1 },
					{ height: "0px", opacity: 0 },
				],
				{ duration: 160, easing: "cubic-bezier(0.4, 0, 0.2, 1)" },
			);

			animation.onfinish = () => {
				item.open = false;
				finishAnimation(answer);
			};
		}

		lists.forEach((list) => {
			if (list.dataset.faqReady === "true") return;
			list.dataset.faqReady = "true";

			list.querySelectorAll("[data-faq-trigger]").forEach((trigger) => {
				trigger.addEventListener("click", (event) => {
					const item = trigger.closest("[data-faq-item]");
					if (!item) return;

					event.preventDefault();

					if (item.open) {
						closeItem(item);
						return;
					}

					list.querySelectorAll("[data-faq-item][open]").forEach((openItemElement) => {
						if (openItemElement !== item) closeItem(openItemElement);
					});
					openItem(item);
				});
			});
		});
	})();
</script>

<style>
	.faq {
		padding: clamp(5rem, 8vw, 8rem) 0;
		background: var(--color-bg);
		border-top: 1px solid var(--color-border);
	}
	.faq-container {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		align-items: start;
		gap: clamp(3rem, 7vw, 7rem);
		max-width: var(--wide-width);
	}
	.faq-intro { position: sticky; top: 7rem; min-width: 0; }
	.faq-eyebrow {
		margin-bottom: 0.9rem;
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 650;
		letter-spacing: 0.055em;
		text-transform: uppercase;
	}
	.faq-header h2 {
		max-width: 29rem;
		font-size: clamp(2.5rem, 4vw, 4.1rem);
		font-weight: 600;
		line-height: 1.07;
		letter-spacing: -0.05em;
		text-wrap: balance;
	}
	.faq-subline { max-width: 26rem; margin-top: 1rem; color: var(--color-muted); font-size: 1rem; line-height: 1.6; }
	.faq-help {
		max-width: 25rem;
		margin-top: clamp(2.5rem, 5vw, 4.5rem);
		padding: 1.5rem;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}
	.help-icon { display: block; width: 2.25rem; height: 2.25rem; color: var(--color-primary); }
	.faq-help h3 { margin-top: 1.1rem; font-size: 1.15rem; font-weight: 600; letter-spacing: -0.025em; }
	.faq-help p { max-width: 22rem; margin-top: 0.5rem; color: var(--color-muted); font-size: 0.83rem; line-height: 1.6; }
	.help-links { display: flex; flex-direction: column; gap: 0.85rem; margin-top: 1.5rem; }
	.help-links a { display: flex; align-items: center; justify-content: space-between; gap: 1rem; color: var(--color-text); font-size: 0.82rem; font-weight: 600; text-decoration: none; }
	.help-links a span { color: var(--color-primary); }
	.help-links a:hover { color: var(--color-primary); }
	.help-links a:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; border-radius: 2px; }
	.faq-list { min-width: 0; border-top: 1px solid var(--color-border); }
	.faq-item { border-bottom: 1px solid var(--color-border); }
	.faq-question {
		display: flex;
		min-height: 4.6rem;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: 1.2rem 0;
		font-size: clamp(1rem, 1.15vw, 1.17rem);
		font-weight: 550;
		line-height: 1.45;
		cursor: pointer;
		list-style: none;
		transition: color var(--transition-fast);
	}
	.faq-question:hover, .faq-item[open] .faq-question { color: var(--color-primary); }
	.faq-question:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 4px; border-radius: 2px; }
	.faq-question::-webkit-details-marker { display: none; }
	.faq-icon {
		width: 2rem;
		height: 2rem;
		flex: none;
		padding: 0.55rem;
		color: var(--color-muted);
		border: 1px solid var(--color-border);
		border-radius: 50%;
		transition: transform var(--transition-base), color var(--transition-fast), border-color var(--transition-fast);
	}
	.faq-item[open] .faq-icon { color: var(--color-primary); border-color: var(--heat-40); transform: rotate(180deg); }
	.faq-answer { overflow: hidden; }
	.faq-answer-inner { padding: 0 0 1.4rem; padding-inline-end: 3.5rem; }
	.faq-answer p { max-width: 53ch; color: var(--color-muted); font-size: 0.94rem; line-height: 1.65; }
	@media (max-width: 850px) {
		.faq-container { grid-template-columns: 1fr; gap: 3rem; }
		.faq-intro { position: static; }
		.faq-help { max-width: none; margin-top: 2rem; }
	}
	@media (max-width: 600px) {
		.faq-container { width: calc(100% - 2rem); }
		.faq-answer-inner { padding-inline-end: 1rem; }
	}
	@media (prefers-reduced-motion: reduce) {
		.faq-question, .faq-icon { transition: none; }
	}
</style>
