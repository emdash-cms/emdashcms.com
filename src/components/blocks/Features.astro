---
import { Icon } from "astro-iconset/components";
import FeatureVisual from "../FeatureVisual.astro";

interface Feature {
	icon: string;
	title: string;
	description: string;
}

interface Props {
	node: {
		_key?: string;
		headline?: string;
		subheadline?: string;
		features: Feature[];
	};
}

const { node } = Astro.props;
const { _key, headline, subheadline, features } = node;
const headingId = `${_key ?? "features"}-heading`;
const chapterLinks: Record<string, { label: string; href: string }> = {
	code: { label: "Start building with EmDash", href: "https://docs.emdashcms.com/getting-started/" },
	cloud: { label: "Explore the media library", href: "/media-library" },
	shield: { label: "See agent workflows", href: "/for-agents" },
};
const chapterCount = Math.min(3, features.length);
const chapters = Array.from({ length: chapterCount }, (_, index) => {
	const start = Math.floor((index * features.length) / chapterCount);
	const end = Math.floor(((index + 1) * features.length) / chapterCount);
	const [lead, ...support] = features.slice(start, end);
	return { index, lead, support, headingId: `${headingId}-${index + 1}`, link: chapterLinks[lead.icon] };
});

const iconMap: Record<string, string> = {
	zap: "ph:lightning",
	shield: "ph:shield-check",
	users: "ph:users-three",
	chart: "ph:chart-bar",
	code: "ph:code",
	globe: "ph:globe",
	heart: "ph:heart",
	star: "ph:star",
	check: "ph:check-circle",
	lock: "ph:lock",
	clock: "ph:clock",
	cloud: "ph:cloud",
};
---

<section class="features" id={_key} aria-labelledby={headline ? headingId : undefined}>
	{(headline || subheadline) && (
		<header class="features-intro container">
			{headline && <h2 id={headingId}>{headline}</h2>}
			{subheadline && <p>{subheadline}</p>}
		</header>
	)}
	<div class="features-chapters">
		{chapters.map(({ index, lead, support, headingId: chapterHeadingId, link }) => (
			<section class="feature-chapter" aria-labelledby={chapterHeadingId}>
				<div class="chapter-inner container">
					<header class="chapter-heading">
						<div class="chapter-title">
							<span class="chapter-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
							<h3 id={chapterHeadingId}>{lead.title}</h3>
						</div>
						<div class="chapter-summary">
							<p>{lead.description}</p>
							{link && (
								<a href={link.href}>
									{link.label}
									<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
										<path d="M4 10h11m-5-5 5 5-5 5" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								</a>
							)}
						</div>
					</header>
					<div class="chapter-bento">
						<div class="chapter-scene"><FeatureVisual scene={index} /></div>
						{support.length > 0 && (
							<div class="chapter-support">
								{support.map((feature) => (
									<article class="support-card">
										<div class="support-symbol" aria-hidden="true">
											<Icon name={iconMap[feature.icon] || "ph:sparkle"} />
										</div>
										<div class="support-copy">
											<h4>{feature.title}</h4>
											<p>{feature.description}</p>
										</div>
										<FeatureVisual scene={index} compact />
									</article>
								))}
							</div>
						)}
					</div>
				</div>
			</section>
		))}
	</div>
</section>

<style>
	.features { background: var(--color-bg); }
	.features-intro {
		display: grid;
		gap: 1.5rem;
		padding-top: clamp(5rem, 9vw, 8rem);
		padding-bottom: clamp(3rem, 6vw, 5rem);
	}
	.features-intro h2 {
		max-width: 38rem;
		font-size: clamp(2.5rem, 5.5vw, 5.25rem);
		font-weight: 600;
		line-height: 1.04;
		letter-spacing: -0.055em;
		text-wrap: balance;
	}
	.features-intro p {
		max-width: 31rem;
		color: var(--color-muted);
		font-size: clamp(1rem, 1.25vw, 1.125rem);
		line-height: 1.65;
	}
	.feature-chapter { border-top: 1px solid var(--color-border); }
	.chapter-inner { padding-top: clamp(3rem, 5.5vw, 5.5rem); padding-bottom: clamp(4.5rem, 7vw, 7rem); }
	.chapter-heading { display: grid; gap: 1.25rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
	.chapter-title { display: flex; align-items: baseline; gap: clamp(1rem, 2vw, 2rem); }
	.chapter-index {
		color: var(--color-primary);
		font-size: 0.8rem;
		font-weight: 650;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.02em;
	}
	.chapter-title h3 {
		font-size: clamp(2rem, 3.5vw, 3.75rem);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}
	.chapter-summary p { max-width: 35rem; color: var(--color-muted); font-size: var(--font-size-lg); line-height: 1.6; }
	.chapter-summary a {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		margin-top: 1rem;
		padding-block: 0.4rem;
		color: var(--color-text);
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		transition: color var(--transition-fast);
	}
	.chapter-summary a:hover { color: var(--color-primary); }
	.chapter-summary a:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; border-radius: 2px; }
	.chapter-summary a svg { width: 1rem; height: 1rem; color: var(--color-primary); }
	@media (prefers-reduced-motion: no-preference) {
		.chapter-summary a svg { transition: transform var(--transition-fast); }
		.chapter-summary a:hover svg { transform: translateX(3px); }
	}
	.chapter-bento { display: grid; gap: 1rem; }
	.chapter-scene, .chapter-support { min-width: 0; }
	.chapter-support { display: grid; gap: 1rem; }
	.support-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		overflow: hidden;
		min-height: 25rem;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}
	.support-symbol {
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		place-items: center;
		color: var(--color-primary);
		font-size: 1.35rem;
		background: var(--heat-8);
		border: 1px solid var(--heat-12);
		border-radius: 0.7rem;
	}
	.support-copy { margin-top: 1.6rem; }
	.support-copy h4 { font-size: 1.35rem; font-weight: 600; line-height: 1.25; letter-spacing: -0.03em; }
	.support-copy p { margin-top: 0.65rem; color: var(--color-muted); font-size: var(--font-size-sm); line-height: 1.65; }
	.support-card :global(.feature-compact) { margin-top: auto; }
	@media (min-width: 900px) {
		.features-intro { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); align-items: end; gap: 5rem; }
		.chapter-heading { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); align-items: start; gap: 5rem; }
		.chapter-bento { grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); }
		.feature-chapter:nth-child(even) .chapter-bento { grid-template-columns: minmax(0, 1fr) minmax(0, 1.65fr); }
		.feature-chapter:nth-child(even) .chapter-scene { order: 1; }
	}
</style>
