---
import { Icon } from "astro-iconset/components";
import FeatureIntroVisual from "../FeatureIntroVisual.astro";
import FeatureVisual from "../FeatureVisual.astro";

interface Feature {
	icon: string;
	title: string;
	description: string;
}

interface Props {
	node: {
		_key?: string;
		headline?: string;
		subheadline?: string;
		features: Feature[];
	};
}

const { node } = Astro.props;
const { _key, headline, subheadline, features } = node;
const headingId = `${_key ?? "features"}-heading`;
const chapterCount = Math.min(3, features.length);
const chapters = Array.from({ length: chapterCount }, (_, index) => {
	const start = Math.floor((index * features.length) / chapterCount);
	const end = Math.floor(((index + 1) * features.length) / chapterCount);
	const [lead, ...support] = features.slice(start, end);
	return { index, lead, support, headingId: `${headingId}-${index + 1}` };
});

const iconMap: Record<string, string> = {
	zap: "ph:lightning",
	shield: "ph:shield-check",
	users: "ph:users-three",
	chart: "ph:chart-bar",
	code: "ph:code",
	globe: "ph:globe",
	heart: "ph:heart",
	star: "ph:star",
	check: "ph:check-circle",
	lock: "ph:lock",
	clock: "ph:clock",
	cloud: "ph:cloud",
};
---

<section class="features" id={_key} aria-labelledby={headline ? headingId : undefined}>
	{(headline || subheadline) && (
		<header class="features-intro container">
			<div class="features-intro-copy">
				{headline && <h2 id={headingId}>{headline}</h2>}
				{subheadline && <p>{subheadline}</p>}
			</div>
			<FeatureIntroVisual />
		</header>
	)}
	<div class="features-chapters">
		{chapters.map(({ index, lead, support, headingId: chapterHeadingId }) => (
			<section class="feature-chapter" aria-labelledby={chapterHeadingId}>
				<div class="chapter-inner container">
					<header class="chapter-heading">
						<div class="chapter-title">
							<span class="chapter-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
							<h3 id={chapterHeadingId}>{lead.title}</h3>
						</div>
						<div class="chapter-summary">
							<p>{lead.description}</p>
						</div>
					</header>
					<div class="chapter-bento">
						<div class="chapter-scene"><FeatureVisual scene={index} /></div>
						{support.length > 0 && (
							<div class="chapter-support">
								{support.map((feature) => (
									<article class="support-card">
										<div class:list={["support-symbol", { "support-symbol--astro": feature.icon === "zap" }]} aria-hidden="true">
											{feature.icon === "zap" ? (
												<><img class="astro-logo--light" src="/brand/products/astro-logo-dark.svg" alt="" width="86" height="30" /><img class="astro-logo--dark" src="/brand/products/astro-logo-light-gradient.svg" alt="" width="86" height="30" /></>
											) : <Icon name={iconMap[feature.icon] || "ph:sparkle"} />}
										</div>
										<div class="support-copy">
											<h4>{feature.title}</h4>
											<p>{feature.description}</p>
										</div>
										<FeatureVisual scene={index} compact />
									</article>
								))}
							</div>
						)}
					</div>
				</div>
			</section>
		))}
	</div>
</section>

<style>
	.features { scroll-margin-top: 5.5rem; background: var(--color-bg); }
	.features-intro {
		display: grid;
		align-items: center;
		gap: clamp(2rem, 5vw, 5rem);
		padding-top: clamp(4rem, 7vw, 6.5rem);
		padding-bottom: clamp(3.5rem, 6vw, 5rem);
	}
	.features-intro-copy { display: grid; justify-items: start; gap: 1.5rem; min-width: 0; }
	.features-intro h2 {
		max-width: 38rem;
		font-size: clamp(2.5rem, 5.5vw, 5.25rem);
		font-weight: 600;
		line-height: 1.04;
		letter-spacing: -0.055em;
		text-wrap: balance;
	}
	.features-intro-copy p {
		max-width: 31rem;
		color: var(--marketing-text-secondary);
		font-size: clamp(1rem, 1.25vw, 1.125rem);
		line-height: 1.65;
	}
	.feature-chapter { border-top: 1px solid var(--color-border); }
	.chapter-inner { padding-top: clamp(3rem, 5.5vw, 5.5rem); padding-bottom: clamp(4.5rem, 7vw, 7rem); }
	.feature-chapter:last-child .chapter-inner { padding-bottom: clamp(4.5rem, 5vw, 5rem); }
	.chapter-heading { display: grid; gap: 1.25rem; margin-bottom: clamp(2rem, 4vw, 3rem); }
	.chapter-title { display: flex; align-items: baseline; gap: clamp(1rem, 2vw, 2rem); }
	.chapter-index {
		color: var(--marketing-text-accent);
		font-size: 0.8rem;
		font-weight: 650;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.02em;
	}
	.chapter-title h3 {
		font-size: clamp(2rem, 3.5vw, 3.75rem);
		font-weight: 600;
		line-height: 1.08;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}
	.chapter-summary p { max-width: 35rem; color: var(--marketing-text-secondary); font-size: var(--font-size-lg); line-height: 1.6; }
	.chapter-bento { display: grid; gap: 1rem; }
	.chapter-scene, .chapter-support { min-width: 0; }
	.chapter-support { display: grid; gap: 1rem; }
	.support-card {
		display: flex;
		min-width: 0;
		flex-direction: column;
		overflow: hidden;
		min-height: 25rem;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}
	.support-symbol {
		display: grid;
		width: 2.25rem;
		height: 2.25rem;
		place-items: center;
		color: var(--color-primary);
		font-size: 1.35rem;
		background: var(--heat-8);
		border: 1px solid var(--heat-12);
		border-radius: 0.7rem;
	}
	.support-symbol--astro { width: 5.5rem; background: transparent; border: 0; }
	.support-symbol img { width: 5.35rem; height: 1.86rem; object-fit: contain; }
	.astro-logo--dark { display: none; }
	:global(:root.dark) .astro-logo--light { display: none; }
	:global(:root.dark) .astro-logo--dark { display: block; }
	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .astro-logo--light { display: none; }
		:global(:root:not(.light)) .astro-logo--dark { display: block; }
	}
	.support-copy { margin-top: 1.6rem; }
	.support-copy h4 { font-size: 1.35rem; font-weight: 600; line-height: 1.25; letter-spacing: -0.03em; }
	.support-copy p { margin-top: 0.65rem; color: var(--marketing-text-secondary); font-size: var(--font-size-sm); line-height: 1.65; }
	.support-card :global(.feature-compact) { margin-top: auto; }
	@media (min-width: 900px) {
		.features-intro { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
		.chapter-heading { grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); align-items: start; gap: 5rem; }
		.chapter-bento { grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); }
		.chapter-scene { display: flex; }
		.chapter-scene :global(.feature-stage) { width: 100%; }
		.chapter-support { grid-auto-rows: minmax(0, 1fr); }
		.support-card { min-height: 0; }
		.feature-chapter:nth-child(even) .chapter-bento { grid-template-columns: minmax(0, 1fr) minmax(0, 1.65fr); }
		.feature-chapter:nth-child(even) .chapter-scene { order: 1; }
	}
</style>
