---
import { Icon } from "astro-iconset/components";

interface Feature {
	icon: string;
	title: string;
	description: string;
}

interface Props {
	node: {
		_key?: string;
		headline?: string;
		subheadline?: string;
		features: Feature[];
	};
}

const { node } = Astro.props;
const { _key, headline, subheadline, features } = node;
const headingId = `${_key ?? "features"}-heading`;
const chapterCount = Math.min(3, features.length);
const chapters = Array.from({ length: chapterCount }, (_, index) => {
	const start = Math.floor((index * features.length) / chapterCount);
	const end = Math.floor(((index + 1) * features.length) / chapterCount);
	const [lead, ...support] = features.slice(start, end);
	return { index, lead, support, headingId: `${headingId}-${index + 1}` };
});

const iconMap: Record<string, string> = {
	zap: "ph:lightning",
	shield: "ph:shield-check",
	users: "ph:users-three",
	chart: "ph:chart-bar",
	code: "ph:code",
	globe: "ph:globe",
	heart: "ph:heart",
	star: "ph:star",
	check: "ph:check-circle",
	lock: "ph:lock",
	clock: "ph:clock",
	cloud: "ph:cloud",
};
---

<section class="features" id={_key} aria-labelledby={headline ? headingId : undefined}>
	{(headline || subheadline) && (
		<header class="features-intro container">
			{headline && <h2 id={headingId} class="features-headline">{headline}</h2>}
			{subheadline && <p class="features-subheadline">{subheadline}</p>}
		</header>
	)}
	<div class="features-chapters">
		{chapters.map(({ index, lead, support, headingId: chapterHeadingId }) => (
			<section class:list={["feature-chapter", { "feature-chapter--solo": support.length === 0 }]} aria-labelledby={chapterHeadingId}>
				<div class="chapter-layout container">
					<span class="chapter-number" aria-hidden="true">
						{String(index + 1).padStart(2, "0")} / {String(chapterCount).padStart(2, "0")}
					</span>
					<div class="chapter-lead">
						<span class="chapter-icon" aria-hidden="true">
							<Icon name={iconMap[lead.icon] || "ph:sparkle"} />
						</span>
						<h3 id={chapterHeadingId}>{lead.title}</h3>
						<p>{lead.description}</p>
					</div>
					{support.length > 0 && (
						<div class="chapter-support">
							{support.map((feature) => (
								<div class="support-feature">
									<span class="support-icon" aria-hidden="true">
										<Icon name={iconMap[feature.icon] || "ph:sparkle"} />
									</span>
									<h4>{feature.title}</h4>
									<p>{feature.description}</p>
								</div>
							))}
						</div>
					)}
				</div>
			</section>
		))}
	</div>
</section>

<style>
	.features {
		background: var(--color-bg);
	}

	.features-intro {
		display: grid;
		gap: var(--spacing-lg);
		padding-top: var(--spacing-5xl);
		padding-bottom: var(--spacing-4xl);
	}

	.features-headline {
		max-width: 40rem;
		font-size: clamp(2.25rem, 4vw, 3.75rem);
		font-weight: 600;
		line-height: 1.07;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.features-subheadline {
		max-width: 29rem;
		color: var(--color-muted);
		font-size: var(--font-size-base);
		line-height: 1.65;
	}

	.feature-chapter {
		border-top: 1px solid var(--color-border);
	}

	.feature-chapter:nth-child(even) {
		background: color-mix(in srgb, var(--color-bg) 55%, var(--color-surface));
	}

	.chapter-layout {
		display: grid;
		gap: var(--spacing-xl);
		padding-top: var(--spacing-4xl);
		padding-bottom: var(--spacing-4xl);
	}

	.chapter-number {
		color: var(--color-primary);
		font-size: var(--font-size-xs);
		font-weight: 600;
		line-height: 1.5;
	}

	.chapter-icon,
	.support-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: var(--color-primary);
	}

	.chapter-icon {
		width: 2rem;
		height: 2rem;
		margin-bottom: var(--spacing-lg);
		font-size: 1.75rem;
	}

	.chapter-lead h3 {
		max-width: 35rem;
		margin-bottom: var(--spacing-md);
		font-size: clamp(2rem, 3.5vw, 3.25rem);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.chapter-lead p {
		max-width: 38rem;
		color: var(--color-muted);
		font-size: var(--font-size-lg);
		line-height: 1.6;
	}

	.chapter-support {
		align-self: end;
		border-top: 1px solid var(--color-border);
		padding-top: var(--spacing-lg);
	}

	.support-feature + .support-feature {
		margin-top: var(--spacing-xl);
		border-top: 1px solid var(--color-border);
		padding-top: var(--spacing-xl);
	}

	.support-icon {
		width: 1.25rem;
		height: 1.25rem;
		margin-bottom: var(--spacing-md);
		font-size: 1.25rem;
	}

	.support-feature h4 {
		margin-bottom: 0.5rem;
		font-size: var(--font-size-base);
		font-weight: 600;
		line-height: 1.35;
	}

	.support-feature p {
		max-width: 27rem;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		line-height: 1.65;
	}

	@media (min-width: 900px) {
		.features-intro {
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
			align-items: end;
			gap: var(--spacing-3xl);
		}

		.chapter-layout {
			grid-template-columns: 3rem minmax(0, 1.2fr) minmax(0, 0.8fr);
			gap: clamp(2rem, 4vw, 4rem);
			padding-top: var(--spacing-5xl);
			padding-bottom: var(--spacing-5xl);
		}

		.feature-chapter--solo .chapter-layout {
			grid-template-columns: 3rem minmax(0, 1fr);
		}
	}
</style>
