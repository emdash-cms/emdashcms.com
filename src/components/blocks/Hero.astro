---
interface Props {
	node: {
		_key?: string;
		headline: string;
		subheadline?: string;
		// CTAs are flattened to sibling fields because Block Kit has no
		// object-group element. Empty strings mean "no CTA".
		primaryCtaLabel?: string;
		primaryCtaUrl?: string;
		secondaryCtaLabel?: string;
		secondaryCtaUrl?: string;
		image?: { url: string; alt?: string };
		centered?: boolean;
	};
}

const { node } = Astro.props;
const { _key, headline, subheadline, image, centered } = node;
const headingId = _key ? `${_key}-title` : "hero-title";
const imageUrl = image?.url?.trim();
const announcement = {
	href: "/blog/emdash-is-live",
	tag: "Announcement",
	label: "EmDash is live",
};

const primaryCta =
	node.primaryCtaLabel && node.primaryCtaUrl
		? { label: node.primaryCtaLabel, url: node.primaryCtaUrl }
		: undefined;
const secondaryCta =
	node.secondaryCtaLabel && node.secondaryCtaUrl
		? { label: node.secondaryCtaLabel, url: node.secondaryCtaUrl }
		: undefined;
---

<section class:list={["hero", { "hero-centered": centered }]} id={_key} aria-labelledby={headingId}>
	<div class="hero-section">
		<div class="hero-container">
			<div class="hero-copy">
				<a href={announcement.href} class="hero-announcement">
					<span class="hero-announcement-tag">{announcement.tag}</span>
					<span class="hero-announcement-text">{announcement.label}</span>
					<span class="hero-announcement-divider" aria-hidden="true"></span>
					<span class="hero-announcement-arrow" aria-hidden="true">→</span>
				</a>
				<h1 id={headingId} class="hero-headline">{headline}</h1>
				{subheadline && <p class="hero-subheadline">{subheadline}</p>}
				{(primaryCta || secondaryCta) && (
					<div class="hero-actions">
						{primaryCta && (
							<a href={primaryCta.url} class="btn btn-primary btn-lg">
								<span>{primaryCta.label}</span>
							</a>
						)}
						{secondaryCta && (
							<a href={secondaryCta.url} class="btn btn-secondary btn-lg">
								<span>{secondaryCta.label}</span>
							</a>
						)}
					</div>
				)}
			</div>

			<div class="hero-image-wrap">
				<div class="hero-image-frame">
					{imageUrl ? (
						<img
							src={imageUrl}
							alt={image?.alt || ""}
							loading="eager"
							fetchpriority="high"
						/>
					) : (
						<div class="hero-image-blank" aria-hidden="true"></div>
					)}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		overflow: hidden;
		background: color-mix(in srgb, var(--color-bg) 50%, var(--color-surface));
	}

	.hero-section {
		position: relative;
	}

	.hero-container {
		position: relative;
		z-index: 10;
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 8.5rem var(--spacing-lg) var(--spacing-xl);
	}

	.hero-centered {
		text-align: center;
	}

	.hero-centered .hero-actions {
		justify-content: center;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.hero-centered .hero-copy {
		align-items: center;
		max-width: 100%;
	}

	.hero-announcement {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		width: fit-content;
		margin-bottom: 1.5rem;
		padding: 4px 12px 4px 4px;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		font-weight: 500;
		line-height: 1;
		background: color-mix(in srgb, var(--color-surface) 72%, transparent);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		transition:
			background var(--transition-fast),
			border-color var(--transition-fast),
			color var(--transition-fast);
	}

	.hero-announcement:hover {
		color: var(--color-text);
		background: var(--color-surface);
		border-color: color-mix(in srgb, var(--color-text) 16%, var(--color-border));
	}

	.hero-announcement-tag {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
		padding: 3px 8px;
		color: var(--color-primary);
		font-size: var(--font-size-xs);
		font-weight: 650;
		line-height: 1;
		background: var(--heat-8);
		border-radius: var(--radius-full);
	}

	.hero-announcement-text {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		line-height: 1;
	}

	.hero-announcement-divider {
		display: block;
		width: 1px;
		height: 16px;
		background: var(--color-border);
	}

	.hero-announcement-arrow {
		display: inline-block;
		font-size: 0.95em;
		font-weight: 400;
		line-height: 1;
	}

	.hero-headline {
		max-width: var(--wide-width);
		font-size: var(--font-size-4xl);
		font-weight: 700;
		line-height: 1.03;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}

	.hero-subheadline {
		max-width: 36rem;
		margin-top: 0.75rem;
		font-size: 0.9375rem;
		line-height: 1.5;
		color: color-mix(in srgb, var(--color-text) 62%, transparent);
		text-wrap: balance;
	}

	.hero-actions {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: center;
		margin-top: var(--spacing-lg);
		gap: 0.75rem;
	}

	.hero-actions :global(.btn) {
		width: 100%;
		white-space: nowrap;
	}

	.hero-image-wrap {
		position: relative;
		margin-top: var(--spacing-3xl);
		margin-right: -14rem;
	}

	.hero-image-frame {
		position: relative;
		overflow: hidden;
		margin: 0 auto;
		background: var(--color-surface);
		border: 1px solid transparent;
		border-radius: var(--radius);
		box-shadow:
			0 20px 24px -4px rgba(0, 0, 0, 0.1),
			0 8px 8px -4px rgba(0, 0, 0, 0.04),
			0 0 0 1px rgba(0, 0, 0, 0.1);
	}

	.hero-image-frame img,
	.hero-image-blank {
		width: 100%;
		aspect-ratio: 2880 / 1842;
	}

	.hero-image-frame img {
		height: auto;
	}

	.hero-image-blank {
		display: block;
		background: var(--color-surface);
	}

	@media (min-width: 640px) {
		.hero-actions {
			width: auto;
			flex-direction: row;
		}

		.hero-actions :global(.btn) {
			width: fit-content;
		}

		.hero-image-wrap {
			margin-right: 0;
		}
	}

	@media (min-width: 1024px) {
		.hero-container {
			padding-top: 10rem;
			padding-bottom: var(--spacing-xl);
		}

		.hero-headline {
			font-size: 3.25rem;
		}

		.hero-subheadline {
			margin-top: var(--spacing-md);
			font-size: var(--font-size-lg);
		}

		.hero-actions {
			margin-top: var(--spacing-xl);
		}
	}

	@media (max-width: 640px) {
		.hero-container {
			padding-top: 7.5rem;
		}

		.hero-headline {
			font-size: var(--font-size-3xl);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-announcement {
			transition: none;
		}
	}
</style>
