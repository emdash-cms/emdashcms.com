---
import { sanitizeHref } from "emdash";
import { Image } from "astro:assets";
import heroDashDark from "../../../public/landing/hero/hero-dash-dark.png";
import heroDashLight from "../../../public/landing/hero/hero-dash-light.png";
import arrowRightSvg from "../../icons/arrow-right.svg?raw";
import CopyPromptButton from "../CopyPromptButton.astro";

interface Props {
	node: {
		_key?: string;
		headline: string;
		subheadline?: string;
		// CTA fields are flattened because Block Kit has no object-group element.
		// Empty strings mean "no CTA".
		primaryCtaLabel?: string;
		primaryCtaUrl?: string;
		secondaryCtaLabel?: string;
		secondaryCtaUrl?: string;
		showAgentActions?: boolean;
		agentPrompt?: string;
		centered?: boolean;
	};
}

const { node } = Astro.props;
const { _key, headline, subheadline, centered } = node;
const headingId = _key ? `${_key}-title` : "hero-title";
const announcement = {
	href: "/blog/emdash-is-live",
	tag: "Announcement",
	label: "EmDash is live",
};
const defaultCopyPrompt = `I want to build a site with EmDash. Read https://emdashcms.com/start.md, inspect my project, and use what I have already told you. If my goal is unclear, ask one focused question. Make the content editable, run the site locally, and let me review it before deployment.`;
const copyPrompt = node.agentPrompt?.trim() || defaultCopyPrompt;

const primaryCta =
	node.primaryCtaLabel && node.primaryCtaUrl
		? { label: node.primaryCtaLabel, url: sanitizeHref(node.primaryCtaUrl.trim()) }
		: undefined;
const secondaryCta =
	node.secondaryCtaLabel && node.secondaryCtaUrl
		? { label: node.secondaryCtaLabel, url: sanitizeHref(node.secondaryCtaUrl.trim()) }
		: undefined;
const showAgentActions = node.showAgentActions ?? (Astro.url.pathname === "/" && _key === "hero");
---

<section class:list={["hero", { "hero-centered": centered }]} id={_key} aria-labelledby={headingId}>
	<div class="hero-section">
		<div class="hero-container">
			<div class="hero-copy" data-copy-prompt-root>
				<a href={announcement.href} class="hero-announcement">
					<span class="hero-announcement-tag">{announcement.tag}</span>
					<span class="hero-announcement-text">{announcement.label}</span>
					<span class="hero-announcement-divider" aria-hidden="true"></span>
					<span class="hero-announcement-arrow" aria-hidden="true" set:html={arrowRightSvg}></span>
				</a>
				<h1 id={headingId} class="hero-headline">{headline}</h1>
				{subheadline && <p class="hero-subheadline">{subheadline}</p>}
				{(primaryCta || secondaryCta || showAgentActions) && (
					<div class="hero-cta-group">
						<div class="hero-actions">
							{primaryCta && (
								<a href={primaryCta.url} class="btn btn-primary btn-lg">
									<span>{primaryCta.label}</span>
								</a>
							)}
							{!showAgentActions && secondaryCta && (
								<a href={secondaryCta.url} class="btn btn-secondary btn-lg">
									<span>{secondaryCta.label}</span>
								</a>
							)}
							{showAgentActions && (
								<div class="hero-local-start">
									<div class="hero-install-command">
										<span class="hero-command-prompt" aria-hidden="true">$</span>
										<code>npm create emdash@latest</code>
										<button type="button" aria-label="Copy scaffold command" data-copy-install-command>
											<svg class="hero-copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" /></svg>
											<svg class="hero-check-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
										</button>
									</div>
									<span class="hero-install-status" role="status" data-install-status></span>
								</div>
							)}
						</div>
						{showAgentActions && (
							<div class="hero-agent-row">
								<span class="hero-agent-label">Or build with an agent</span>
								<div class="hero-copy-action">
									<CopyPromptButton prompt={copyPrompt} />
									<div class="hero-prompt-feedback" data-copy-prompt-feedback>
										<p class="hero-prompt-preview" data-copy-prompt-preview aria-hidden="true">
											<span class="hero-prompt-dash" aria-hidden="true"></span>
											<span class="hero-prompt-preview-text">An EmDash starter for your agent: plan, build, preview locally.</span>
										</p>
										<p class="hero-prompt-copied" data-copy-prompt-copied aria-hidden="true">
											<span class="hero-prompt-check">✓</span>
											<span class="hero-prompt-message">Prompt copied. Paste it into your coding agent to begin.</span>
										</p>
										<p class="hero-prompt-failed" data-copy-prompt-failed aria-hidden="true" inert>
											<span>Copy manually:</span>
											<input type="text" value={copyPrompt} readonly aria-label="EmDash agent prompt to copy manually" data-copy-prompt-manual />
										</p>
									</div>
								</div>
							</div>
						)}
					</div>
				)}
			</div>

			<div class="hero-image-wrap">
				<div class="hero-image-frame">
					<Image
						src={heroDashLight}
						alt="EmDash post editor with draft content and publishing controls"
						class="hero-image hero-image--light"
						widths={[640, 960, 1280, 1600, 2000]}
						sizes="(min-width: 1140px) 1096px, calc(100vw - 32px)"
						loading="eager"
						fetchpriority="high"
					/>
					<Image
						src={heroDashDark}
						alt="EmDash post editor with draft content and publishing controls"
						class="hero-image hero-image--dark"
						widths={[640, 960, 1280, 1600, 2000]}
						sizes="(min-width: 1140px) 1096px, calc(100vw - 32px)"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLButtonElement>("[data-copy-install-command]").forEach((button) => {
		const command = button.parentElement?.querySelector("code")?.textContent?.trim();
		const status = button.closest(".hero-local-start")?.querySelector<HTMLElement>("[data-install-status]");
		let resetTimer: number | undefined;
		button.addEventListener("click", async () => {
			window.clearTimeout(resetTimer);
			try {
				if (!command || !navigator.clipboard?.writeText) throw new Error("Clipboard unavailable");
				await navigator.clipboard.writeText(command);
				button.classList.add("is-copied");
				button.setAttribute("aria-label", "Scaffold command copied");
				if (status) status.textContent = "Scaffold command copied";
			} catch {
				button.classList.remove("is-copied");
				button.setAttribute("aria-label", "Copy scaffold command");
				if (status) status.textContent = "Could not copy. Select the command to copy it manually.";
			}
			resetTimer = window.setTimeout(() => {
				button.classList.remove("is-copied");
				button.setAttribute("aria-label", "Copy scaffold command");
				if (status) status.textContent = "";
			}, 3000);
		});
	});
</script>

<style>
	.hero {
		--marketing-text-secondary: #626262;
		overflow: hidden;
		background: color-mix(in srgb, var(--color-bg) 50%, var(--color-surface));
	}

	:global(:root.dark) .hero {
		--marketing-text-secondary: #b0b0b0;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .hero {
			--marketing-text-secondary: #b0b0b0;
		}
	}

	.hero-section {
		position: relative;
	}

	.hero-container {
		position: relative;
		z-index: 10;
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 8.5rem var(--spacing-lg) var(--spacing-xl);
	}

	.hero-centered {
		text-align: center;
	}

	.hero-copy {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.hero-centered .hero-copy {
		align-items: center;
		max-width: 100%;
	}

	.hero-announcement {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		width: fit-content;
		margin-bottom: 1.5rem;
		padding: 4px 12px 4px 4px;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		font-weight: 500;
		line-height: 1;
		background: color-mix(in srgb, var(--color-surface) 72%, transparent);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		transition:
			background var(--transition-fast),
			border-color var(--transition-fast),
			color var(--transition-fast);
	}

	.hero-announcement:hover {
		color: var(--color-text);
		background: var(--color-surface);
		border-color: color-mix(in srgb, var(--color-text) 16%, var(--color-border));
	}

	.hero-announcement-tag {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
		padding: 3px 8px;
		color: var(--color-primary);
		font-size: var(--font-size-xs);
		font-weight: 650;
		line-height: 1;
		background: var(--heat-8);
		border-radius: var(--radius-full);
	}

	.hero-announcement-text {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		line-height: 1;
	}

	.hero-announcement-divider {
		display: block;
		width: 1px;
		height: 16px;
		background: var(--color-border);
	}

	.hero-announcement-arrow {
		display: inline-block;
		flex: 0 0 auto;
		width: 16px;
		height: 16px;
		color: currentColor;
		line-height: 1;
	}

	.hero-announcement-arrow :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-headline {
		max-width: var(--wide-width);
		font-size: var(--font-size-4xl);
		font-weight: 700;
		line-height: 1.03;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}

	.hero-subheadline {
		max-width: 36rem;
		margin-top: 0.75rem;
		font-size: 0.9375rem;
		line-height: 1.5;
		color: color-mix(in srgb, var(--color-text) 66%, transparent);
		text-wrap: balance;
	}

	.hero-cta-group {
		position: relative;
		width: 100%;
	}

	.hero-actions {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: center;
		margin-top: var(--spacing-lg);
		gap: 0.75rem;
	}

	.hero-centered .hero-actions {
		justify-content: center;
	}

	.hero-agent-label {
		color: var(--marketing-text-secondary);
		font-size: var(--font-size-sm);
		line-height: 1.5;
		white-space: nowrap;
	}

	.hero-agent-row {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.75rem;
		margin-top: 1rem;
	}

	.hero-centered .hero-agent-row {
		align-items: center;
	}

	.hero-actions :global(.btn) {
		width: 100%;
		min-height: 48px;
		padding: 0.75rem 1.25rem;
		border-radius: var(--button-radius);
		white-space: nowrap;
	}

	.hero-actions :global(.btn-primary) {
		color: #fff;
	}

	.hero-copy-action,
	.hero-local-start {
		width: 100%;
	}

	.hero-install-command {
		display: inline-flex;
		width: 100%;
		min-height: 48px;
		align-items: center;
		gap: 0.5rem;
		padding-inline-start: 0.75rem;
		color: var(--color-text);
		background: var(--color-surface);
		border: 0;
		border-radius: var(--radius);
		box-shadow:
			0 0 0 1px var(--color-border),
			0 1px 3px rgba(0, 0, 0, 0.12);
	}

	.hero-command-prompt {
		color: var(--marketing-text-secondary);
	}

	.hero-install-command code {
		font-size: 0.8125rem;
		white-space: nowrap;
		user-select: text;
	}

	.hero-install-command button {
		display: grid;
		width: 38px;
		height: 48px;
		flex: 0 0 auto;
		place-items: center;
		margin-inline-start: auto;
		padding: 0;
		color: var(--marketing-text-secondary);
		background: transparent;
		border: 0;
		border-inline-start: 1px solid var(--color-border);
		border-radius: 0 var(--radius) var(--radius) 0;
		cursor: copy;
	}

	.hero-install-command button:hover,
	.hero-install-command button.is-copied {
		color: var(--color-primary);
		background: color-mix(in srgb, var(--color-primary) 8%, transparent);
	}

	.hero-install-command button:focus-visible {
		outline: 2px solid var(--color-primary);
		outline-offset: 2px;
	}

	.hero-install-command svg {
		grid-area: 1 / 1;
		width: 16px;
		height: 16px;
		transition: opacity var(--transition-fast), transform var(--transition-fast);
	}

	.hero-check-icon,
	.hero-install-command .is-copied .hero-copy-icon {
		opacity: 0;
		transform: scale(0.7);
	}

	.hero-install-command .is-copied .hero-check-icon {
		opacity: 1;
		transform: scale(1);
	}

	.hero-install-status {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.hero-prompt-feedback {
		position: absolute;
		inset-block-start: calc(100% + var(--spacing-md));
		inset-inline-start: 0;
		width: min(43rem, calc(100vw - 2 * var(--spacing-lg)));
		height: 1.5rem;
		font-size: var(--font-size-sm);
		line-height: 1.5;
	}

	.hero-centered .hero-prompt-feedback {
		inset-inline-start: 50%;
		transform: translateX(-50%);
	}

	.hero-prompt-feedback p {
		position: absolute;
		inset: 0;
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		opacity: 0;
		filter: blur(3px);
		transform: translateY(12px);
		pointer-events: none;
	}

	.hero-prompt-preview {
		color: var(--marketing-text-secondary);
	}

	.hero-prompt-copied {
		color: var(--marketing-text-secondary);
	}

	.hero-prompt-failed {
		color: #b42318;
	}

	.hero-prompt-failed[aria-hidden="false"] {
		pointer-events: auto;
	}

	.hero-prompt-failed input {
		min-width: 0;
		width: min(100%, 30rem);
		height: 1.5rem;
		padding: 0 0.5rem;
		color: var(--color-text);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-sm);
		font: inherit;
	}

	:global(:root.dark) .hero-prompt-failed {
		color: #f97066;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .hero-prompt-failed {
			color: #f97066;
		}
	}

	.hero-prompt-preview-text {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hero-prompt-message {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hero-prompt-dash {
		width: 0.875rem;
		height: 2px;
		flex: 0 0 auto;
		background: var(--color-primary);
		border-radius: var(--radius-full);
	}

	.hero-prompt-check {
		color: var(--color-primary);
		font-weight: 600;
	}

	.hero-image-wrap {
		position: relative;
		width: 100%;
		margin-top: var(--spacing-3xl);
	}

	.hero-image-frame {
		position: relative;
		overflow: hidden;
		width: 100%;
		margin: 0 auto;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow:
			0 0 0 4px var(--border-faint),
			0 20px 24px -4px rgba(0, 0, 0, 0.1),
			0 8px 8px -4px rgba(0, 0, 0, 0.04);
	}

	:global(:root.dark) .hero-image-frame {
		border-color: color-mix(in srgb, var(--color-bg) 90%, var(--color-text));
		box-shadow:
			0 0 0 4px color-mix(in srgb, var(--color-text) 5%, transparent),
			0 20px 24px -4px rgba(0, 0, 0, 0.24),
			0 8px 8px -4px rgba(0, 0, 0, 0.18);
	}

	:global(:root.dark) .hero-image-frame :global(.hero-image--light) {
		display: none;
	}

	:global(:root.dark) .hero-image-frame :global(.hero-image--dark) {
		display: block;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .hero-image-frame {
			border-color: color-mix(in srgb, var(--color-bg) 90%, var(--color-text));
			box-shadow:
				0 0 0 4px color-mix(in srgb, var(--color-text) 5%, transparent),
				0 20px 24px -4px rgba(0, 0, 0, 0.24),
				0 8px 8px -4px rgba(0, 0, 0, 0.18);
		}

		:global(:root:not(.light)) .hero-image-frame :global(.hero-image--light) {
			display: none;
		}

		:global(:root:not(.light)) .hero-image-frame :global(.hero-image--dark) {
			display: block;
		}
	}

	.hero-image-frame :global(.hero-image) {
		display: block;
		width: 100%;
		height: auto;
	}

	.hero-image-frame :global(.hero-image--dark) {
		display: none;
	}

	@media (min-width: 640px) {
		.hero-copy-action {
			position: relative;
		}

		.hero-actions {
			flex-direction: row;
			flex-wrap: wrap;
			justify-content: flex-start;
		}

		.hero-actions :global(.btn) {
			width: fit-content;
		}

		.hero-copy-action,
		.hero-local-start,
		.hero-install-command {
			width: auto;
		}

		.hero-prompt-feedback {
			inset-inline-start: 0;
			width: min(43rem, calc(100vw - 12rem));
		}
	}

	@media (min-width: 1024px) {
		.hero-container {
			padding-top: 10rem;
			padding-bottom: var(--spacing-xl);
		}

		.hero-headline {
			font-size: 3.25rem;
		}

		.hero-subheadline {
			margin-top: var(--spacing-md);
			font-size: var(--font-size-lg);
		}

		.hero-actions {
			margin-top: var(--spacing-xl);
		}
	}

	@media (max-width: 640px) {
		.hero-container {
			padding-top: 7.5rem;
		}

		.hero-headline {
			font-size: var(--font-size-3xl);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-announcement,
		.hero-install-command svg {
			transition: none;
		}
	}
</style>
