---
import { sanitizeHref } from "emdash";
import { Image } from "astro:assets";
import heroDashDark from "../../../public/landing/hero/hero-dash-dark.png";
import heroDashLight from "../../../public/landing/hero/hero-dash-light.png";
import arrowRightSvg from "../../icons/arrow-right.svg?raw";
import CopyPromptButton from "../CopyPromptButton.astro";

interface Props {
	node: {
		_key?: string;
		headline: string;
		subheadline?: string;
		// CTA fields are flattened because Block Kit has no object-group element.
		// Empty strings mean "no CTA".
		primaryCtaLabel?: string;
		primaryCtaUrl?: string;
		copyPrompt?: string;
		centered?: boolean;
	};
}

const { node } = Astro.props;
const { _key, headline, subheadline, centered } = node;
const headingId = _key ? `${_key}-title` : "hero-title";
const announcement = {
	href: "/blog/emdash-is-live",
	tag: "Announcement",
	label: "EmDash is live",
};
const defaultCopyPrompt = `Read https://docs.emdashcms.com/llms.txt, then help me build an EmDash site.
Ask what I want to make, follow the current docs to set up or adapt an Astro project, model editable content, and run it locally for review. Show me how to edit content in the admin and connect my AI assistant through EmDash's MCP server. Don't deploy until I approve.`;
const copyPrompt = node.copyPrompt?.trim() || defaultCopyPrompt;
const copyPromptPreview = copyPrompt.split(/\r?\n/, 1)[0];

const primaryCta =
	node.primaryCtaLabel && node.primaryCtaUrl
		? { label: node.primaryCtaLabel, url: sanitizeHref(node.primaryCtaUrl.trim()) }
		: undefined;
---

<section class:list={["hero", { "hero-centered": centered }]} id={_key} aria-labelledby={headingId}>
	<div class="hero-section">
		<div class="hero-container">
			<div class="hero-copy" data-copy-prompt-root>
				<a href={announcement.href} class="hero-announcement">
					<span class="hero-announcement-tag">{announcement.tag}</span>
					<span class="hero-announcement-text">{announcement.label}</span>
					<span class="hero-announcement-divider" aria-hidden="true"></span>
					<span class="hero-announcement-arrow" aria-hidden="true" set:html={arrowRightSvg}></span>
				</a>
				<h1 id={headingId} class="hero-headline">{headline}</h1>
				{subheadline && <p class="hero-subheadline">{subheadline}</p>}
				<div class="hero-actions">
					{primaryCta && (
						<a href={primaryCta.url} class="btn btn-primary btn-lg">
							<span>{primaryCta.label}</span>
						</a>
					)}
					<CopyPromptButton prompt={copyPrompt} />
				</div>
				<div class="hero-prompt-feedback" data-copy-prompt-feedback>
					<p class="hero-prompt-preview" data-copy-prompt-preview aria-hidden="true">
						<span class="hero-prompt-quote" aria-hidden="true">“</span>
						<span class="hero-prompt-preview-text">{copyPromptPreview}</span>
						<span class="hero-prompt-quote" aria-hidden="true">”</span>
					</p>
					<p class="hero-prompt-copied" data-copy-prompt-copied aria-hidden="true">
						<span>✓</span>
						<span class="hero-prompt-message">Copied — now paste that into your coding agent for a guided walkthrough!</span>
					</p>
					<p class="hero-prompt-failed" data-copy-prompt-failed aria-hidden="true">Could not copy the prompt. Try again.</p>
				</div>
			</div>

			<div class="hero-image-wrap">
				<div class="hero-image-frame">
					<Image
						src={heroDashLight}
						alt="EmDash CMS dashboard"
						class="hero-image hero-image--light"
						widths={[640, 960, 1280, 1600, 2000]}
						sizes="(min-width: 1140px) 1096px, calc(100vw - 32px)"
						loading="eager"
						fetchpriority="high"
					/>
					<Image
						src={heroDashDark}
						alt="EmDash CMS dashboard"
						class="hero-image hero-image--dark"
						widths={[640, 960, 1280, 1600, 2000]}
						sizes="(min-width: 1140px) 1096px, calc(100vw - 32px)"
						loading="eager"
						fetchpriority="high"
					/>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		overflow: hidden;
		background: color-mix(in srgb, var(--color-bg) 50%, var(--color-surface));
	}

	.hero-section {
		position: relative;
	}

	.hero-container {
		position: relative;
		z-index: 10;
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: 8.5rem var(--spacing-lg) var(--spacing-xl);
	}

	.hero-centered {
		text-align: center;
	}

	.hero-centered .hero-actions {
		justify-content: center;
	}

	.hero-copy {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.hero-centered .hero-copy {
		align-items: center;
		max-width: 100%;
	}

	.hero-announcement {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		width: fit-content;
		margin-bottom: 1.5rem;
		padding: 4px 12px 4px 4px;
		color: var(--color-muted);
		font-size: var(--font-size-sm);
		font-weight: 500;
		line-height: 1;
		background: color-mix(in srgb, var(--color-surface) 72%, transparent);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		transition:
			background var(--transition-fast),
			border-color var(--transition-fast),
			color var(--transition-fast);
	}

	.hero-announcement:hover {
		color: var(--color-text);
		background: var(--color-surface);
		border-color: color-mix(in srgb, var(--color-text) 16%, var(--color-border));
	}

	.hero-announcement-tag {
		display: inline-flex;
		align-items: center;
		min-height: 24px;
		padding: 3px 8px;
		color: var(--color-primary);
		font-size: var(--font-size-xs);
		font-weight: 650;
		line-height: 1;
		background: var(--heat-8);
		border-radius: var(--radius-full);
	}

	.hero-announcement-text {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		line-height: 1;
	}

	.hero-announcement-divider {
		display: block;
		width: 1px;
		height: 16px;
		background: var(--color-border);
	}

	.hero-announcement-arrow {
		display: inline-block;
		flex: 0 0 auto;
		width: 16px;
		height: 16px;
		color: currentColor;
		line-height: 1;
	}

	.hero-announcement-arrow :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	.hero-headline {
		max-width: var(--wide-width);
		font-size: var(--font-size-4xl);
		font-weight: 700;
		line-height: 1.03;
		letter-spacing: -0.045em;
		text-wrap: balance;
	}

	.hero-subheadline {
		max-width: 36rem;
		margin-top: 0.75rem;
		font-size: 0.9375rem;
		line-height: 1.5;
		color: color-mix(in srgb, var(--color-text) 62%, transparent);
		text-wrap: balance;
	}

	.hero-actions {
		display: flex;
		width: 100%;
		flex-direction: column;
		align-items: center;
		margin-top: var(--spacing-lg);
		gap: 0.75rem;
	}

	.hero-actions :global(.btn) {
		width: 100%;
		min-height: 48px;
		padding: 0.75rem 1.25rem;
		border-radius: var(--radius-full);
		white-space: nowrap;
	}

	.hero-prompt-feedback {
		position: relative;
		width: min(100%, 43rem);
		height: 1.5rem;
		margin-top: var(--spacing-md);
		font-size: var(--font-size-sm);
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		line-height: 1.5;
	}

	.hero-centered .hero-prompt-feedback {
		margin-inline: auto;
	}

	.hero-prompt-feedback p {
		position: absolute;
		inset: 0;
		display: flex;
		min-width: 0;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		opacity: 0;
		filter: blur(3px);
		transform: translateY(4px);
		pointer-events: none;
		transition:
			opacity 180ms ease-out,
			filter 180ms ease-out,
			transform 180ms ease-out;
	}

	.hero-prompt-preview {
		color: var(--color-muted);
	}

	.hero-prompt-copied {
		color: #2563eb;
	}

	.hero-prompt-failed {
		color: #b42318;
	}

	:global(:root.dark) .hero-prompt-copied {
		color: #60a5fa;
	}

	:global(:root.dark) .hero-prompt-failed {
		color: #f97066;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .hero-prompt-copied {
			color: #60a5fa;
		}

		:global(:root:not(.light)) .hero-prompt-failed {
			color: #f97066;
		}
	}

	.hero-prompt-preview-text {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hero-prompt-message {
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hero-prompt-quote {
		color: var(--color-primary);
		font-family: var(--font-sans);
		font-weight: 600;
	}

	.hero-image-wrap {
		position: relative;
		width: 100%;
		margin-top: var(--spacing-3xl);
	}

	.hero-image-frame {
		position: relative;
		overflow: hidden;
		width: 100%;
		margin: 0 auto;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		box-shadow:
			0 0 0 4px var(--border-faint),
			0 20px 24px -4px rgba(0, 0, 0, 0.1),
			0 8px 8px -4px rgba(0, 0, 0, 0.04);
	}

	:global(:root.dark) .hero-image-frame {
		border-color: color-mix(in srgb, var(--color-bg) 90%, var(--color-text));
		box-shadow:
			0 0 0 4px color-mix(in srgb, var(--color-text) 5%, transparent),
			0 20px 24px -4px rgba(0, 0, 0, 0.24),
			0 8px 8px -4px rgba(0, 0, 0, 0.18);
	}

	:global(:root.dark) .hero-image-frame :global(.hero-image--light) {
		display: none;
	}

	:global(:root.dark) .hero-image-frame :global(.hero-image--dark) {
		display: block;
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .hero-image-frame {
			border-color: color-mix(in srgb, var(--color-bg) 90%, var(--color-text));
			box-shadow:
				0 0 0 4px color-mix(in srgb, var(--color-text) 5%, transparent),
				0 20px 24px -4px rgba(0, 0, 0, 0.24),
				0 8px 8px -4px rgba(0, 0, 0, 0.18);
		}

		:global(:root:not(.light)) .hero-image-frame :global(.hero-image--light) {
			display: none;
		}

		:global(:root:not(.light)) .hero-image-frame :global(.hero-image--dark) {
			display: block;
		}
	}

	.hero-image-frame :global(.hero-image) {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 5 / 3;
	}

	.hero-image-frame :global(.hero-image--dark) {
		display: none;
	}

	@media (min-width: 640px) {
		.hero-actions {
			width: auto;
			flex-direction: row;
		}

		.hero-actions :global(.btn) {
			width: fit-content;
		}

	}

	@media (min-width: 1024px) {
		.hero-container {
			padding-top: 10rem;
			padding-bottom: var(--spacing-xl);
		}

		.hero-headline {
			font-size: 3.25rem;
		}

		.hero-subheadline {
			margin-top: var(--spacing-md);
			font-size: var(--font-size-lg);
		}

		.hero-actions {
			margin-top: var(--spacing-xl);
		}
	}

	@media (max-width: 640px) {
		.hero-container {
			padding-top: 7.5rem;
		}

		.hero-headline {
			font-size: var(--font-size-3xl);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-announcement,
		.hero-prompt-feedback p {
			transition: none;
		}
	}
</style>
