---
import { sanitizeHref } from "emdash";

interface Testimonial {
	quote: string;
	author: string;
	role?: string;
	company?: string;
	context?: unknown;
	referenceUrl?: unknown;
	referenceLabel?: unknown;
}

interface Props {
	node: {
		_key?: string;
		headline?: string;
		testimonials: Testimonial[];
	};
}

const { node } = Astro.props;
const { _key, headline, testimonials } = node;
const headingId = `${_key ?? "testimonials"}-heading`;

function getInitials(name: string) {
	return name
		.split(" ")
		.map((part) => part[0])
		.filter(Boolean)
		.slice(0, 2)
		.join("")
		.toUpperCase();
}

function getAttribution(testimonial: Testimonial) {
	if (testimonial.role && testimonial.company) return `${testimonial.role} at ${testimonial.company}`;
	return testimonial.role || testimonial.company;
}

function trimmedString(value: unknown) {
	return typeof value === "string" ? value.trim() : undefined;
}

function getHttpReference(value: unknown) {
	const candidate = trimmedString(value);
	if (!candidate) return undefined;
	try {
		const parsed = new URL(sanitizeHref(candidate));
		return (parsed.protocol === "http:" || parsed.protocol === "https:") && parsed.hostname ? parsed.href : undefined;
	} catch {
		return undefined;
	}
}

const knownReferences: Record<string, { quote: string; context?: string; url: string; label: string }> = {
	"Joost de Valk": {
		quote: "The most interesting thing to happen to content management in years.",
		url: "https://joost.blog/wordpress-refactor-not-redecorate/",
		label: "Read original",
	},
	"Brian Coords": {
		quote: "Getting from zero to a basic design is fast. I mean, really fast.",
		url: "https://www.briancoords.com/emdash-first-thoughts-and-takeaways-for-wordpress/",
		label: "Read original",
	},
};

function getReference(testimonial: Testimonial) {
	const known = knownReferences[testimonial.author];
	const fallback = known?.quote === testimonial.quote ? known : undefined;
	return {
		context: trimmedString(testimonial.context) || fallback?.context,
		referenceUrl: getHttpReference(testimonial.referenceUrl) || getHttpReference(fallback?.url),
		referenceLabel: trimmedString(testimonial.referenceLabel) || fallback?.label || "Read source",
	};
}

const testimonialItems = testimonials
	.map((testimonial) => ({
		...testimonial,
		...getReference(testimonial),
		attribution: getAttribution(testimonial),
		initials: getInitials(testimonial.author),
	}))
	.filter((testimonial) => !(testimonial.author === "Matt Mullenweg" && testimonial.quote === "The entire functionality of WordPress, and then some." && !testimonial.referenceUrl));
---

{testimonialItems.length > 0 && (
	<section class="testimonials" id={_key} aria-labelledby={headingId}>
		<div class="testimonials-container container">
			<header class="testimonials-header">
				<div>
					<p class="testimonials-eyebrow">From the community</p>
					<h2 id={headingId}>{headline?.trim() || "In their words."}</h2>
				</div>
				<span class="testimonials-count" aria-label={`${testimonialItems.length} voices`}>
					{String(testimonialItems.length).padStart(2, "0")} voices
				</span>
			</header>
			<div class:list={["testimonials-grid", { "testimonials-grid--solo": testimonialItems.length === 1, "testimonials-grid--pair": testimonialItems.length === 2 }]}>
				{testimonialItems.map((testimonial, index) => (
					<figure class:list={["testimonial-item", { "testimonial-item--featured": index === 0 }]}>
						<svg class="quote-mark" viewBox="0 0 120 90" aria-hidden="true" fill="currentColor">
							<path d="M8 45C8 22 23 7 49 4v14c-13 2-20 10-20 20h21v39H8V45Zm60 0C68 22 83 7 109 4v14c-13 2-20 10-20 20h21v39H68V45Z" />
						</svg>
						{testimonial.context && <p class="quote-context">{testimonial.context}</p>}
						<blockquote><p>“{testimonial.quote}”</p></blockquote>
						<figcaption>
							<span class="testimonial-avatar" aria-hidden="true">{testimonial.initials}</span>
							<span class="testimonial-meta">
								<cite>{testimonial.author}</cite>
								{testimonial.attribution && <span>{testimonial.attribution}</span>}
								{testimonial.referenceUrl && <a class="testimonial-reference" href={testimonial.referenceUrl} aria-label={`${testimonial.referenceLabel} by ${testimonial.author}`}>{testimonial.referenceLabel} <span aria-hidden="true">↗</span></a>}
							</span>
						</figcaption>
					</figure>
				))}
			</div>
		</div>
	</section>
)}

<style>
	.testimonials {
		scroll-margin-top: 5.5rem;
		padding: clamp(3.5rem, 5vw, 4.5rem) 0 clamp(4rem, 5vw, 5rem);
		background: color-mix(in srgb, var(--color-bg) 65%, var(--color-surface));
		border-top: 1px solid var(--color-border);
	}
	.testimonials-container { max-width: var(--wide-width); }
	.testimonials-header {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: clamp(2rem, 4vw, 3rem);
	}
	.testimonials-eyebrow {
		margin-bottom: 0.85rem;
		color: var(--color-primary);
		font-size: 0.75rem;
		font-weight: 650;
		letter-spacing: 0.055em;
		text-transform: uppercase;
	}
	.testimonials-header h2 {
		font-size: clamp(2.5rem, 5vw, 4.5rem);
		font-weight: 600;
		line-height: 1.05;
		letter-spacing: -0.05em;
		text-wrap: balance;
	}
	.testimonials-count {
		padding-bottom: 0.45rem;
		color: var(--color-muted);
		font-family: ui-monospace, SFMono-Regular, monospace;
		font-size: 0.7rem;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}
	.testimonials-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
		gap: 1rem;
	}
	.testimonials-grid--solo { grid-template-columns: 1fr; }
	.testimonial-item {
		display: flex;
		min-width: 0;
		min-height: 13rem;
		flex-direction: column;
		padding: clamp(1.5rem, 2.5vw, 2.5rem);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
	}
	.testimonial-item--featured {
		grid-row: span 2;
		min-height: 27rem;
		background: radial-gradient(ellipse at 18% 5%, var(--heat-12), transparent 47%), var(--color-surface);
	}
	.testimonials-grid--pair .testimonial-item:last-child { grid-row: span 2; }
	.quote-mark { width: 1.5rem; height: 1.15rem; flex: none; color: var(--color-primary); opacity: 0.65; }
	.testimonial-item--featured .quote-mark { width: 3.5rem; height: 2.65rem; opacity: 0.75; }
	.quote-context { margin-top: 1.4rem; color: var(--color-primary); font-size: 0.68rem; font-weight: 650; letter-spacing: 0.045em; text-transform: uppercase; }
	.testimonial-item blockquote { margin: 1.1rem 0 1.5rem; }
	.testimonial-item blockquote p { font-size: clamp(1.1rem, 1.45vw, 1.45rem); font-weight: 500; line-height: 1.42; letter-spacing: -0.022em; text-wrap: pretty; }
	.testimonial-item--featured blockquote { max-width: 37rem; margin-top: 2rem; }
	.testimonial-item--featured blockquote p { font-size: clamp(1.9rem, 2.75vw, 2.85rem); line-height: 1.23; letter-spacing: -0.04em; }
	.testimonial-item figcaption {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
		margin-top: auto;
		padding-top: 1.25rem;
		border-top: 1px solid var(--color-border);
	}
	.testimonial-avatar {
		display: grid;
		width: 2rem;
		height: 2rem;
		flex: none;
		place-items: center;
		color: var(--color-primary);
		background: var(--heat-8);
		border: 1px solid var(--heat-12);
		border-radius: 50%;
		font-size: 0.62rem;
		font-weight: 650;
	}
	.testimonial-item--featured .testimonial-avatar { width: 2.5rem; height: 2.5rem; font-size: 0.72rem; }
	.testimonial-meta { display: flex; min-width: 0; flex-direction: column; gap: 0.15rem; }
	.testimonial-meta cite { font-size: 0.85rem; font-style: normal; font-weight: 600; line-height: 1.3; }
	.testimonial-meta span { color: var(--color-muted); font-size: 0.76rem; line-height: 1.35; }
	.testimonial-reference { width: fit-content; margin-top: 0.35rem; color: var(--color-primary); font-size: 0.72rem; font-weight: 600; text-decoration: none; }
	.testimonial-reference:hover { text-decoration: underline; text-underline-offset: 3px; }
	.testimonial-reference:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; border-radius: 2px; }
	.testimonial-reference span { color: inherit; }
	@media (max-width: 760px) {
		.testimonials-grid { grid-template-columns: 1fr; }
		.testimonial-item--featured, .testimonials-grid--pair .testimonial-item:last-child { grid-row: auto; }
		.testimonial-item--featured { min-height: 22rem; }
		.testimonial-item:not(.testimonial-item--featured) { min-height: 12rem; }
	}
	@media (max-width: 420px) {
		.testimonials-header { align-items: start; flex-direction: column; }
		.testimonial-item--featured blockquote p { font-size: 1.8rem; }
	}
</style>
