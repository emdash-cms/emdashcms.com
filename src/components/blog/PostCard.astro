---
/**
 * A post summary for the blog index and the "Keep reading" row.
 *
 * - `feature`: the latest post, with a larger cover and title.
 * - `card`: a grid card.
 *
 * Both lay out from their own width rather than the viewport's: narrow cards
 * put the cover on top, and wide ones put it beside the copy. So a lone card
 * spanning the page reads as a row, and the same card in a three-up grid
 * reads as a tile.
 *
 * The title link stretches over the whole card, so the card has one link
 * whose accessible name is the post title.
 */
import type { ContentEntry, InferCollectionData } from "emdash";
import arrowRightSvg from "../../icons/arrow-right.svg?raw";
import { formatPostDate, postAuthors, readingMinutes } from "../../lib/posts";
import PostByline from "./PostByline.astro";
import PostCover from "./PostCover.astro";

interface Props {
	post: ContentEntry<InferCollectionData<"posts">>;
	layout?: "feature" | "card";
	headingLevel?: 2 | 3;
	priority?: boolean;
	/** `sizes` for a featured image. Grids pass one that matches their column count. */
	sizes?: string;
}

const { post, layout = "card", headingLevel = 3, priority = false } = Astro.props;
const Heading = headingLevel === 2 ? "h2" : "h3";
const published = formatPostDate(post.data.publishedAt);
const minutes = readingMinutes(post.data.content);
const authors = postAuthors(post.data.bylines);
const sizes =
	Astro.props.sizes ??
	(layout === "feature"
		? "(min-width: 1200px) 640px, (min-width: 768px) 55vw, 100vw"
		: "(min-width: 1024px) 380px, (min-width: 640px) 40vw, 100vw");
---

<article class:list={["post-card", `post-card--${layout}`]}>
	<div class="post-card-inner">
		<div class="post-card-media">
			<PostCover
				slug={post.id}
				image={post.data.featured_image}
				variant={layout === "feature" ? "feature" : "card"}
				priority={priority}
				sizes={sizes}
			/>
		</div>
		<div class="post-card-body">
			{
				(published || minutes) && (
					<p class="post-card-meta">
						{published && <time datetime={published.datetime}>{published.label}</time>}
						{published && minutes && <span aria-hidden="true">·</span>}
						{minutes && <span>{minutes} min read</span>}
					</p>
				)
			}
			<Heading class="post-card-title">
				<a href={`/blog/${post.id}`} class="post-card-link">{post.data.title}</a>
			</Heading>
			{post.data.excerpt && <p class="post-card-excerpt">{post.data.excerpt}</p>}
			<div class="post-card-footer">
				<PostByline authors={authors} size="card" />
				<span class="post-card-cta" aria-hidden="true">
					Read
					<span class="post-card-arrow" set:html={arrowRightSvg} />
				</span>
			</div>
		</div>
	</div>
</article>

<style>
	.post-card {
		--card-border: var(--color-border);
		--card-ring: var(--border-faint);
		/* Both stay at or above 4.5:1 for small text on the card surface. */
		--card-muted: color-mix(in srgb, var(--color-text) 72%, transparent);
		--card-subtle: color-mix(in srgb, var(--color-text) 66%, transparent);
		/* Brand orange darkened for small text on light surfaces (4.5:1). */
		--card-accent-text: color-mix(in srgb, var(--color-primary) 72%, #000);

		position: relative;
		min-width: 0;
		height: 100%;
		container: post-card / inline-size;
		background: var(--color-surface);
		border: 1px solid var(--card-border);
		border-radius: 18px;
		box-shadow:
			0 0 0 4px var(--card-ring),
			var(--shadow-sm);
		transition:
			border-color var(--transition-base),
			box-shadow var(--transition-base);
	}

	:global(:root.dark) .post-card {
		--card-border: color-mix(in srgb, var(--color-bg) 90%, var(--color-text));
		--card-ring: color-mix(in srgb, var(--color-text) 5%, transparent);
		--card-accent-text: var(--color-primary);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .post-card {
			--card-border: color-mix(in srgb, var(--color-bg) 90%, var(--color-text));
			--card-ring: color-mix(in srgb, var(--color-text) 5%, transparent);
			--card-accent-text: var(--color-primary);
		}
	}

	/* Set the property, not --card-border, so the dark-theme rules can't outrank it. */
	.post-card:hover {
		border-color: color-mix(in srgb, var(--color-text) 18%, var(--color-surface));
		box-shadow:
			0 0 0 4px var(--card-ring),
			var(--shadow-lg);
	}

	/*
	 * The stretched link carries focus; draw the ring around the whole card.
	 * Without :has(), the link keeps its own focus ring.
	 */
	@supports selector(:has(*)) {
		.post-card:has(.post-card-link:focus-visible) {
			box-shadow:
				0 0 0 2px var(--color-bg),
				0 0 0 4px var(--color-focus);
		}

		.post-card-link:focus-visible {
			box-shadow: none;
		}
	}

	.post-card-link::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: inherit;
	}

	.post-card-inner {
		display: flex;
		height: 100%;
		flex-direction: column;
	}

	.post-card-media {
		position: relative;
		margin: 6px 6px 0;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 12px;
	}

	/* The inset ring sits above the cover so it stays visible over photos. */
	.post-card-media::after {
		content: "";
		position: absolute;
		inset: 0;
		border-radius: inherit;
		box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--color-text) 6%, transparent);
		pointer-events: none;
	}

	/* Out of flow, so a tall featured image can't stretch the card. */
	.post-card-media :global(.post-cover) {
		position: absolute;
		inset: 0;
		transition: transform 500ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.post-card:hover .post-card-media :global(.post-cover) {
		transform: scale(1.03);
	}

	.post-card-body {
		display: flex;
		min-width: 0;
		flex: 1;
		flex-direction: column;
		padding: 1.125rem 1.25rem 1.25rem;
	}

	.post-card-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		margin-bottom: 0.625rem;
		color: var(--card-subtle);
		font-size: 0.8125rem;
		line-height: 1.4;
		font-variant-numeric: tabular-nums;
	}

	.post-card-title {
		color: var(--color-text);
		font-size: 1.125rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.02em;
		overflow-wrap: break-word;
		text-wrap: balance;
	}

	.post-card-excerpt {
		display: -webkit-box;
		margin-top: 0.5rem;
		overflow: hidden;
		color: var(--card-muted);
		font-size: 0.9375rem;
		line-height: 1.55;
		overflow-wrap: break-word;
		text-wrap: pretty;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
	}

	.post-card-footer {
		--byline-ring: var(--color-surface);
		--byline-muted: var(--card-muted);
		--byline-accent: var(--card-accent-text);

		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--spacing-md);
		margin-top: auto;
		padding-top: 1.25rem;
	}

	.post-card-cta {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		gap: 0.25rem;
		margin-inline-start: auto;
		color: var(--card-accent-text);
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1;
	}

	.post-card-arrow {
		--nudge: 2px;

		display: block;
		width: 0.875rem;
		height: 0.875rem;
		transition: transform var(--transition-base);
	}

	:global([dir="rtl"]) .post-card-arrow {
		--nudge: -2px;
	}

	.post-card-arrow :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	:global([dir="rtl"]) .post-card-arrow :global(svg) {
		transform: scaleX(-1);
	}

	.post-card:hover .post-card-arrow {
		transform: translateX(var(--nudge));
	}

	/* ---------- Wide cards: cover beside the copy ---------- */

	@container post-card (min-width: 36rem) {
		.post-card--card .post-card-inner {
			display: grid;
			grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
		}

		.post-card--card .post-card-media {
			margin: 6px;
			aspect-ratio: auto;
			min-height: 11rem;
		}

		.post-card--card .post-card-body {
			justify-content: center;
			padding: 1.25rem 1.5rem;
		}

		.post-card--card .post-card-footer {
			margin-top: 0;
		}
	}

	/* ---------- Feature: the latest post ---------- */

	.post-card--feature .post-card-body {
		padding: 1.5rem;
	}

	.post-card--feature .post-card-title {
		font-size: 1.5rem;
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.03em;
	}

	.post-card--feature .post-card-excerpt {
		margin-top: 0.75rem;
		font-size: 1rem;
		-webkit-line-clamp: 4;
		line-clamp: 4;
	}

	/* The feature keeps its cover on top until there's room for a large one beside the copy. */
	@container post-card (min-width: 44rem) {
		.post-card--feature .post-card-inner {
			display: grid;
			grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
		}

		.post-card--feature .post-card-media {
			margin: 6px;
			aspect-ratio: auto;
			min-height: 20rem;
		}

		.post-card--feature .post-card-body {
			justify-content: center;
			padding: 2.25rem 2.5rem 2.25rem 2rem;
		}

		.post-card--feature .post-card-title {
			font-size: 1.875rem;
		}

		.post-card--feature .post-card-footer {
			margin-top: 0;
			padding-top: 2rem;
		}
	}

	@container post-card (min-width: 60rem) {
		.post-card--feature .post-card-media {
			min-height: 24rem;
		}

		.post-card--feature .post-card-title {
			font-size: 2.125rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.post-card-media :global(.post-cover),
		.post-card-arrow {
			transition: none;
		}

		.post-card:hover .post-card-media :global(.post-cover),
		.post-card:hover .post-card-arrow {
			transform: none;
		}
	}
</style>
