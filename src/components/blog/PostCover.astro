---
/**
 * A post's cover: its featured image when one is set, otherwise generated
 * halftone art seeded by the slug. Covers fill their container, so the caller
 * sets the aspect ratio.
 */
import type { ImageValue } from "emdash";
import { Image } from "emdash/ui";
import { ART_GRIDS, type ArtVariant, halftoneArt } from "../../lib/post-art";

interface Props {
	slug: string;
	image?: ImageValue | null;
	variant: ArtVariant;
	/**
	 * Alt text for the featured image. Defaults to empty, because cards and
	 * the post header already carry the title.
	 */
	alt?: string;
	priority?: boolean;
	sizes?: string;
}

const { slug, image, variant, alt = "", priority = false, sizes } = Astro.props;
const { columns, rows } = ART_GRIDS[variant];
const art = image ? null : halftoneArt(slug, columns, rows);
const paperId = art ? `post-art-paper-${variant}-${art.key}` : undefined;
---

<div class:list={["post-cover", `post-cover--${variant}`, art && `post-cover--art post-cover--${art.motif}`]}>
	{
		image ? (
			<Image image={image} alt={alt} priority={priority} sizes={sizes} class="post-cover-image" />
		) : art ? (
			<svg
				class="post-art"
				viewBox={`0 0 ${art.width} ${art.height}`}
				preserveAspectRatio="xMidYMid slice"
				aria-hidden="true"
				focusable="false"
			>
				<defs>
					<pattern id={paperId} width="10" height="10" patternUnits="userSpaceOnUse">
						<circle class="post-art-grain" cx="5" cy="5" r="0.75" />
					</pattern>
				</defs>
				<rect width="100%" height="100%" fill={`url(#${paperId})`} />
				{art.layers.map((layer) => (
					<path
						class:list={["post-art-dots", layer.accent && "post-art-dots--accent"]}
						d={layer.d}
						stroke-width={layer.width}
					/>
				))}
			</svg>
		) : null
	}
</div>

<style>
	.post-cover {
		--art-bg: color-mix(in srgb, var(--color-bg) 55%, var(--color-surface));
		--art-paper: color-mix(in srgb, var(--color-text) 9%, transparent);
		--art-ink: color-mix(in srgb, var(--color-text) 62%, transparent);
		--art-accent: var(--color-primary);

		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		background: var(--art-bg);
	}

	:global(:root.dark) .post-cover {
		--art-bg: color-mix(in srgb, var(--color-bg) 40%, var(--color-surface));
		--art-paper: color-mix(in srgb, var(--color-text) 8%, transparent);
		--art-ink: color-mix(in srgb, var(--color-text) 50%, transparent);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .post-cover {
			--art-bg: color-mix(in srgb, var(--color-bg) 40%, var(--color-surface));
			--art-paper: color-mix(in srgb, var(--color-text) 8%, transparent);
			--art-ink: color-mix(in srgb, var(--color-text) 50%, transparent);
		}
	}

	.post-art {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* The paper rect is filled by the pattern attribute; only the pattern's dot is styled. */
	.post-art-grain {
		fill: var(--art-paper);
	}

	.post-art-dots {
		fill: none;
		stroke: var(--art-ink);
		stroke-linecap: round;
	}

	.post-art-dots--accent {
		stroke: var(--art-accent);
	}

	/* No display rule here: EmDash hides one of the light/dark variants with display: none. */
	.post-cover :global(.post-cover-image) {
		width: 100%;
		max-width: none;
		height: 100%;
		object-fit: cover;
		vertical-align: top;
	}
</style>
