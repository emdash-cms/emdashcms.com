---
/**
 * A spotlight card is a featured site that fills its row: a case study, or the
 * odd featured site out.
 *
 * The name links to the live site and stretches over the whole card, so the
 * card has one link whose accessible name is the site name. A preview card,
 * which shows a submission before it is sent, has no link.
 */
import { Image } from "emdash/ui";
import arrowUpRightSvg from "../../icons/arrow-up-right.svg?raw";
import type { ShowcaseSite } from "../../lib/showcase";
import PostCover from "../blog/PostCover.astro";
import ShowcaseButton from "./ShowcaseButton.astro";

interface Props {
	site: ShowcaseSite;
	size: "spotlight" | "featured" | "index";
	priority?: boolean;
	preview?: boolean;
}

const { site, size, priority = false, preview = false } = Astro.props;
const featured = size !== "index";
const spotlight = size === "spotlight";
const caseStudy = spotlight ? site.storyUrl : null;
const sizes = spotlight
	? "(min-width: 1200px) 720px, (min-width: 1024px) 62vw, 88vw"
	: featured
		? "(min-width: 1200px) 500px, (min-width: 640px) 42vw, 88vw"
		: "(min-width: 1200px) 330px, (min-width: 640px) 42vw, 88vw";
---

<article class:list={["showcase-card", `showcase-card--${size}`, { "showcase-card--featured": spotlight }]}>
	<div class="showcase-card-media">
		<div class="showcase-card-well">
			<div class="showcase-card-window">
				{
					site.screenshot ? (
						<Image image={site.screenshot} alt="" priority={priority} sizes={sizes} class="showcase-card-image" />
					) : (
						<>
							<PostCover slug={site.id} variant={featured ? "feature" : "card"} />
							<span class="showcase-card-host-pill" aria-hidden="true">
								{site.host}
							</span>
						</>
					)
				}
			</div>
		</div>
	</div>
	<div class="showcase-card-caption">
		{
			caseStudy && (
				<p class="showcase-card-eyebrow">
					<span class="showcase-card-eyebrow-dash" aria-hidden="true" />
					Case study
				</p>
			)
		}
		<div class="showcase-card-title-row">
			<h3 class="showcase-card-title">
				{
					preview ? (
						<span class="showcase-card-link">{site.title}</span>
					) : (
						<a href={site.href} class="showcase-card-link" target="_blank" rel="noopener" title={site.title}>
							{site.title}
						</a>
					)
				}
			</h3>
			<span class="showcase-card-arrow" aria-hidden="true" set:html={arrowUpRightSvg} />
		</div>
		{featured && site.description && <p class="showcase-card-description">{site.description}</p>}
		<p class="showcase-card-meta">
			<span class="showcase-card-host">{site.host}</span>
			{
				site.category && (
					<>
						{" "}
						<span aria-hidden="true">·</span> {site.category}
					</>
				)
			}
		</p>
		{
			caseStudy && (
				<div class="showcase-card-story">
					<ShowcaseButton label="Read the story" href={caseStudy} icon="external" />
				</div>
			)
		}
	</div>
</article>

<style>
	.showcase-card {
		--well-border: var(--color-border);
		--well-ring: var(--border-faint);
		--well-bg: color-mix(in srgb, var(--color-text) 3.5%, var(--color-surface));
		--well-dot: color-mix(in srgb, var(--color-text) 9%, transparent);
		--well-radius: 14px;
		--window-border: var(--color-border);
		--window-radius: 8px;
		--window-shadow: 0 1px 2px rgba(0, 0, 0, 0.05), 0 16px 32px -18px rgba(0, 0, 0, 0.22);
		/* Both stay at or above 4.5:1 for small text on the page canvas. */
		--card-muted: color-mix(in srgb, var(--color-text) 72%, transparent);
		--card-subtle: color-mix(in srgb, var(--color-text) 66%, transparent);
		/* Brand orange darkened to 3:1 or more on light surfaces. */
		--card-accent: color-mix(in srgb, var(--color-primary) 72%, #000);
		--card-inset: var(--showcase-well-inset);

		position: relative;
		min-width: 0;
		height: 100%;
		padding: var(--card-inset) var(--card-inset) 0;
	}

	:global(:root.dark) .showcase-card {
		--well-border: color-mix(in srgb, var(--color-bg) 90%, var(--color-text));
		--well-ring: color-mix(in srgb, var(--color-text) 5%, transparent);
		--well-bg: color-mix(in srgb, var(--color-text) 3%, var(--color-surface));
		--well-dot: color-mix(in srgb, var(--color-text) 10%, transparent);
		--window-border: color-mix(in srgb, var(--color-bg) 80%, var(--color-text));
		--window-shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 18px 36px -18px rgba(0, 0, 0, 0.8);
		--card-accent: var(--color-primary);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .showcase-card {
			--well-border: color-mix(in srgb, var(--color-bg) 90%, var(--color-text));
			--well-ring: color-mix(in srgb, var(--color-text) 5%, transparent);
			--well-bg: color-mix(in srgb, var(--color-text) 3%, var(--color-surface));
			--well-dot: color-mix(in srgb, var(--color-text) 10%, transparent);
			--window-border: color-mix(in srgb, var(--color-bg) 80%, var(--color-text));
			--window-shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 18px 36px -18px rgba(0, 0, 0, 0.8);
			--card-accent: var(--color-primary);
		}
	}

	.showcase-card--featured {
		--well-radius: 18px;
		--window-radius: 10px;
		--card-inset: 1.25rem;
	}

	.showcase-card-well {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		isolation: isolate;
		background: var(--well-bg);
		border-radius: var(--well-radius);
		box-shadow:
			0 0 0 1px var(--well-border),
			0 0 0 4px var(--well-ring);
		transition: box-shadow var(--transition-base);
	}

	.showcase-card-well::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: radial-gradient(circle, var(--well-dot) 1px, transparent 1.2px);
		background-position: 7px 7px;
		background-size: 14px 14px;
		mask-image: radial-gradient(120% 90% at 50% 0%, transparent 35%, #000 100%);
	}

	.showcase-card--featured .showcase-card-well {
		--well-dot: color-mix(in srgb, var(--color-text) 13%, transparent);

		background:
			radial-gradient(55% 70% at 100% 0%, color-mix(in srgb, var(--color-primary) 13%, transparent), transparent 70%),
			radial-gradient(50% 65% at 0% 100%, color-mix(in srgb, var(--color-primary) 10%, transparent), transparent 72%),
			var(--well-bg);
	}

	.showcase-card--featured .showcase-card-well::before {
		background-position: 6px 6px;
		background-size: 12px 12px;
		mask-image: radial-gradient(110% 85% at 50% 15%, transparent 40%, #000 100%);
	}

	.showcase-card--featured .showcase-card-well::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image: radial-gradient(
			circle,
			color-mix(in srgb, var(--color-primary) 55%, transparent) 1.2px,
			transparent 1.6px
		);
		background-position: 6px 6px;
		background-size: 12px 12px;
		mask-image: radial-gradient(55% 75% at 0% 100%, #000, transparent 70%);
		opacity: 0.7;
	}

	/* 16:10 like the screenshots. It overshoots the well's bottom edge by 4px so the 3px hover lift never shows a gap. */
	.showcase-card-window {
		position: absolute;
		inset: calc(8% + 4px) 4% auto;
		overflow: hidden;
		aspect-ratio: 16 / 10;
		background: var(--color-surface);
		border-radius: var(--window-radius) var(--window-radius) 0 0;
		box-shadow:
			0 0 0 1px var(--window-border),
			var(--window-shadow);
		transition: transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	/*
	 * Full width, top aligned: a screenshot in another shape loses its bottom, never an edge of the page.
	 * No display rule here: EmDash hides one of the light/dark variants with display: none.
	 */
	.showcase-card-window :global(.showcase-card-image) {
		width: 100%;
		max-width: none;
		height: auto;
	}

	.showcase-card-host-pill {
		position: absolute;
		inset-block-start: 50%;
		inset-inline-start: 50%;
		max-width: calc(100% - 2rem);
		padding: 0.3125rem 0.75rem;
		overflow: hidden;
		color: var(--card-muted);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1.4;
		text-overflow: ellipsis;
		white-space: nowrap;
		background: var(--color-surface);
		border: 1px solid var(--well-border);
		border-radius: var(--radius-full);
		box-shadow: 0 0 0 3px var(--well-ring);
		translate: -50% -50%;
	}

	:global([dir="rtl"]) .showcase-card-host-pill {
		translate: 50% -50%;
	}

	.showcase-card-caption {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding: 1rem calc(var(--showcase-inset) - var(--card-inset)) 1.375rem;
	}

	.showcase-card-title-row {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
	}

	/* One line each for the name and the meta keeps index captions the same height. */
	.showcase-card-title {
		min-width: 0;
		flex: 1;
		overflow: hidden;
		color: var(--color-text);
		font-size: 0.9375rem;
		font-weight: 600;
		line-height: 1.4;
		letter-spacing: -0.012em;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.showcase-card-link::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
	}

	.showcase-card-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 0.5rem;
		color: var(--color-text);
		font-size: var(--font-size-sm);
		font-weight: 600;
		line-height: 1;
	}

	.showcase-card-eyebrow-dash {
		width: 0.875rem;
		height: 2px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
	}

	/* Above the stretched link, so it opens the write-up rather than the site. */
	.showcase-card-story {
		position: relative;
		z-index: 2;
		margin-top: 1rem;
	}

	.showcase-card-arrow {
		--nudge-x: 2px;

		display: block;
		flex: none;
		width: 0.875rem;
		height: 0.875rem;
		margin-top: 0.1875rem;
		color: var(--card-subtle);
		transition:
			color var(--transition-base),
			transform var(--transition-base);
	}

	:global([dir="rtl"]) .showcase-card-arrow {
		--nudge-x: -2px;
	}

	.showcase-card-arrow :global(svg) {
		display: block;
		width: 100%;
		height: 100%;
	}

	:global([dir="rtl"]) .showcase-card-arrow :global(svg) {
		transform: scaleX(-1);
	}

	.showcase-card-description {
		display: -webkit-box;
		max-width: 34rem;
		overflow: hidden;
		color: var(--card-muted);
		font-size: 0.9375rem;
		line-height: 1.55;
		text-wrap: pretty;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	.showcase-card-meta {
		overflow: hidden;
		color: var(--card-subtle);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		line-height: 1.6;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.showcase-card--featured .showcase-card-caption {
		gap: 0.375rem;
		padding-top: 1.25rem;
		padding-bottom: 1.75rem;
	}

	.showcase-card--featured .showcase-card-title {
		font-size: 1.25rem;
		line-height: 1.3;
		letter-spacing: -0.024em;
	}

	.showcase-card--featured .showcase-card-arrow {
		width: 1rem;
		height: 1rem;
		margin-top: 0.25rem;
	}

	.showcase-card--featured .showcase-card-meta {
		margin-top: 0.125rem;
	}

	@media (min-width: 1024px) {
		.showcase-card--spotlight {
			display: grid;
			grid-column: 1 / -1;
			grid-template-columns: subgrid;
			padding: 0;
		}

		.showcase-card--spotlight .showcase-card-media {
			display: flex;
			flex-direction: column;
			grid-column: span 4;
			padding: var(--card-inset);
			background: var(--showcase-dash-y) right top / 1px 100% no-repeat;
		}

		/* About as tall as an index card, growing when the caption needs more. */
		.showcase-card--spotlight .showcase-card-well {
			flex-grow: 1;
			aspect-ratio: 21 / 8;
		}

		:global([dir="rtl"]) .showcase-card--spotlight .showcase-card-media {
			background-position: left top;
		}

		.showcase-card--spotlight .showcase-card-caption {
			grid-column: span 2;
			justify-content: center;
			gap: 0.5rem;
			padding: calc(var(--card-inset) + 0.5rem) var(--showcase-inset) var(--card-inset);
		}

		.showcase-card--spotlight .showcase-card-title {
			font-size: 1.75rem;
			line-height: 1.2;
			letter-spacing: -0.032em;
			display: -webkit-box;
			white-space: normal;
			overflow-wrap: anywhere;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
			line-clamp: 2;
		}

		.showcase-card--spotlight .showcase-card-arrow {
			width: 1.125rem;
			height: 1.125rem;
			margin-top: 0.4375rem;
		}

		.showcase-card--spotlight .showcase-card-description {
			margin-top: 0.25rem;
			font-size: 1rem;
			-webkit-line-clamp: 5;
			line-clamp: 5;
		}
	}

	/* Set the property, not --well-border, so the dark-theme rules can't outrank it. */
	.showcase-card:hover .showcase-card-well {
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--color-text) 18%, var(--color-surface)),
			0 0 0 4px var(--well-ring);
	}

	.showcase-card:hover .showcase-card-window {
		transform: translateY(-3px);
	}

	.showcase-card:hover .showcase-card-arrow {
		color: var(--card-accent);
		transform: translate(var(--nudge-x), -2px);
	}

	/*
	 * The stretched link carries focus; draw the ring around the well.
	 * Without :has(), the link keeps its own focus ring.
	 */
	@supports selector(:has(*)) {
		.showcase-card:has(.showcase-card-link:focus-visible) .showcase-card-well {
			box-shadow:
				0 0 0 2px var(--color-bg),
				0 0 0 4px var(--color-focus);
		}

		.showcase-card:has(.showcase-card-link:focus-visible) .showcase-card-arrow {
			color: var(--card-accent);
			transform: translate(var(--nudge-x), -2px);
		}

		.showcase-card-link:focus-visible {
			box-shadow: none;
		}
	}

	@media (max-width: 639.98px) {
		.showcase-card--featured {
			--card-inset: var(--showcase-well-inset);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.showcase-card-well,
		.showcase-card-window,
		.showcase-card-arrow {
			transition: none;
		}

		.showcase-card:hover .showcase-card-window,
		.showcase-card:hover .showcase-card-arrow {
			transform: none;
		}

		.showcase-card:has(.showcase-card-link:focus-visible) .showcase-card-arrow {
			transform: none;
		}
	}
</style>
