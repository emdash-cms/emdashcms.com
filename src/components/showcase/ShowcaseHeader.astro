---
interface Props {
	/** The h1's id, which the page's landmark is labelled by. */
	titleId: string;
	/** A muted lead-in to the title. */
	lead: string;
	title: string;
	intro: string;
	eyebrowHref?: string;
}

const { titleId, lead, title, intro, eyebrowHref } = Astro.props;
const Eyebrow = eyebrowHref ? "a" : "p";
---

<header>
	<div class="showcase-ruled showcase-head">
		<Eyebrow class="showcase-eyebrow" href={eyebrowHref}>
			<span class="showcase-eyebrow-dash" aria-hidden="true"></span>Showcase
		</Eyebrow>
		<h1 id={titleId} class="showcase-title">
			<span class="showcase-title-lead">{lead}</span>{" "}{title}
		</h1>
	</div>
	<div class="showcase-ruled showcase-intro-row">
		<p class="showcase-intro">{intro}</p>
		{
			Astro.slots.has("default") && (
				<div class="showcase-actions">
					<slot />
				</div>
			)
		}
	</div>
</header>

<style>
	.showcase-head {
		padding: 3.5rem var(--showcase-inset) 2.25rem;
	}

	.showcase-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: 1.25rem;
		color: var(--color-text);
		font-size: var(--font-size-sm);
		font-weight: 600;
		line-height: 1;
	}

	.showcase-eyebrow-dash {
		width: 0.875rem;
		height: 2px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
	}

	.showcase-title {
		color: var(--color-text);
		font-size: clamp(2.75rem, 1.2rem + 4.6vw, 4.5rem);
		font-weight: 700;
		line-height: 1.02;
		letter-spacing: -0.045em;
		overflow-wrap: break-word;
		text-wrap: balance;
	}

	.showcase-title-lead {
		color: color-mix(in srgb, var(--color-text) 52%, transparent);
	}

	.showcase-intro-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 1.5rem;
		padding: 1.75rem var(--showcase-inset) 2rem;
	}

	.showcase-intro {
		max-width: 34rem;
		color: color-mix(in srgb, var(--color-text) 72%, transparent);
		font-size: var(--font-size-lg);
		line-height: 1.6;
		text-wrap: pretty;
	}

	.showcase-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
	}

	@media (min-width: 768px) {
		.showcase-title-lead {
			display: block;
		}
	}

	@media (min-width: 1024px) {
		.showcase-intro-row {
			grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
			align-items: end;
			gap: 2rem;
		}

		.showcase-actions {
			justify-content: flex-end;
		}
	}

	@media (max-width: 639.98px) {
		.showcase-head {
			padding-top: 2.5rem;
		}

		.showcase-intro {
			font-size: var(--font-size-base);
		}
	}
</style>
