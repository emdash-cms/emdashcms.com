---
import { decodeSlug, getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";

const slug = decodeSlug(Astro.params.slug);

if (!slug) {
	return Astro.redirect("/404");
}

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);

if (!post) {
	return Astro.redirect("/404");
}

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const published = post.data.publishedAt
	? {
		datetime: post.data.publishedAt.toISOString(),
		label: post.data.publishedAt.toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			day: "numeric",
		}),
	}
	: null;
const articleMeta = {
	publishedTime: post.data.publishedAt?.toISOString() ?? null,
	modifiedTime: post.data.updatedAt.toISOString(),
	author: post.data.bylines?.[0]?.byline.displayName ?? null,
};
---

<Base
	title={post.data.title}
	description={post.data.excerpt || "Release announcement from EmDash CMS."}
	pageType="article"
	articleMeta={articleMeta}
	content={{ collection: "posts", id: post.data.id, slug: post.id }}
>
	<article class="post-page">
		<div class="post-container">
			<div class="post-rail">
				<header class="post-header">
					<p class="eyebrow"><a href="/blog">Blog</a></p>
					<h1>{post.data.title}</h1>
					{published && (
						<p class="post-date">
							<time datetime={published.datetime}>{published.label}</time>
						</p>
					)}
					{post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
				</header>
				<div class="post-content">
					<PortableText value={post.data.content} />
				</div>
			</div>
		</div>
	</article>
</Base>

<style>
	.post-page {
		overflow: hidden;
		background: color-mix(in srgb, var(--color-bg) 50%, var(--color-surface));
	}

	.post-container {
		width: calc(100% - 16px);
		max-width: 920px;
		margin: 0 auto;
		padding: 8.5rem 0 var(--spacing-5xl);
	}

	.post-rail {
		max-width: none;
		padding: 0 var(--spacing-md);
	}

	.post-header {
		max-width: 28rem;
		margin-bottom: var(--spacing-3xl);
	}

	.eyebrow {
		font-size: var(--font-size-sm);
		font-weight: 400;
		line-height: 1.5;
	}

	.eyebrow a {
		color: color-mix(in srgb, var(--color-text) 72%, transparent);
		transition: color var(--transition-fast);
	}

	.eyebrow a:hover {
		color: var(--color-text);
	}

	.post-page h1 {
		max-width: 28rem;
		margin-top: var(--spacing-md);
		color: var(--color-text);
		font-size: var(--font-size-4xl);
		font-weight: 600;
		line-height: 1.12;
		letter-spacing: -0.035em;
		text-wrap: balance;
	}

	.post-date {
		margin-top: var(--spacing-md);
		margin-bottom: 0;
		font-size: var(--font-size-sm);
		color: color-mix(in srgb, var(--color-text) 56%, transparent);
	}

	.post-excerpt {
		max-width: 40rem;
		margin-top: var(--spacing-md);
		font-size: 0.9375rem;
		line-height: 1.5;
		color: color-mix(in srgb, var(--color-text) 62%, transparent);
		text-wrap: balance;
	}

	.post-content {
		font-size: var(--font-size-base);
		line-height: 1.75;
		color: color-mix(in srgb, var(--color-text) 72%, transparent);
	}

	.post-content :global(p) {
		margin-bottom: 1.25em;
	}

	.post-content :global(h2) {
		font-size: var(--font-size-2xl);
		line-height: 1.12;
		letter-spacing: -0.035em;
		margin: 2.25em 0 0.75em;
	}

	.post-content :global(h3) {
		font-size: var(--font-size-xl);
		margin: 1.5em 0 0.5em;
	}

	.post-content :global(a) {
		color: var(--color-primary);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.post-content :global(ul),
	.post-content :global(ol) {
		padding-left: 1.5rem;
		margin-bottom: 1.25em;
	}

	.post-content :global(li) {
		margin-bottom: 0.4em;
	}

	.post-content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.9em;
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		padding: 0.15em 0.35em;
		border-radius: var(--radius-sm);
	}

	.post-content :global(pre) {
		overflow-x: auto;
		padding: var(--spacing-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		margin-bottom: 1.5em;
	}

	.post-content :global(pre code) {
		display: block;
		padding: 0;
		color: inherit;
		font-size: inherit;
		background: transparent;
		border: 0;
		border-radius: 0;
	}

	.post-content :global(blockquote) {
		border-left: 3px solid var(--heat-40);
		padding-left: var(--spacing-lg);
		color: var(--color-muted);
		margin: 1.5em 0;
	}

	@media (min-width: 1024px) {
		.post-container {
			padding-top: 10rem;
		}

		.post-excerpt {
			font-size: var(--font-size-lg);
		}
	}

	@media (max-width: 640px) {
		.post-container {
			padding-top: 7.5rem;
		}

		.post-page h1 {
			font-size: var(--font-size-3xl);
		}
	}
</style>
