---
import { getEmDashCollection } from "emdash";
import PostCard from "../../components/blog/PostCard.astro";
import PostGrid from "../../components/blog/PostGrid.astro";
import Base from "../../layouts/Base.astro";

const { entries: posts, error, cacheHint } = await getEmDashCollection("posts", {
	orderBy: { published_at: "desc" },
});

if (error) console.error("Failed to load blog posts:", error);
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// Newest first, with unpublished dates last.
const sortedPosts = posts.toSorted(
	(a, b) => (b.data.publishedAt?.getTime() ?? 0) - (a.data.publishedAt?.getTime() ?? 0),
);
const [latest, ...earlier] = sortedPosts;
---

<Base title="Blog" description="Release announcements and product updates for EmDash CMS.">
	<section class="blog" aria-labelledby="blog-title">
		<div class="blog-container container">
			<header class="blog-header">
				<div>
					<p class="blog-eyebrow"><span class="blog-eyebrow-dash" aria-hidden="true"></span>Blog</p>
					<h1 id="blog-title" class="blog-title">
						<span class="blog-title-lead">Release notes and product updates from</span> EmDash
					</h1>
				</div>
				<div class="blog-intro-group">
					<p class="blog-intro">
						This is where we announce new releases, notable improvements, and major changes to EmDash CMS.
					</p>
					<a href="/blog/tags" class="blog-tags-link">Browse by tag</a>
				</div>
			</header>

			{
				latest ? (
					<>
						<PostCard post={latest} layout="feature" headingLevel={2} priority />
						{earlier.length > 0 && (
							<section class="blog-earlier" aria-labelledby="blog-earlier-title">
								<h2 id="blog-earlier-title" class="blog-section-title">
									Earlier posts
								</h2>
								<PostGrid posts={earlier} />
							</section>
						)}
					</>
				) : (
					<div class="blog-empty">
						<h2>No posts yet</h2>
						<p>Publish your first release post in the admin.</p>
						<a href="/_emdash/admin/content/posts/new" class="btn btn-primary">
							Write a post
						</a>
					</div>
				)
			}
		</div>
	</section>
</Base>

<style>
	.blog {
		min-height: calc(100vh - 200px);
		padding: 8.5rem 0 var(--spacing-5xl);
		background: color-mix(in srgb, var(--color-bg) 50%, var(--color-surface));
	}

	.blog-container {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-2xl);
	}

	/* A zero minimum lets long words wrap instead of widening the page. */
	.blog-header {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: var(--spacing-md);
	}

	.blog-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-bottom: var(--spacing-md);
		color: var(--color-text);
		font-size: var(--font-size-sm);
		font-weight: 600;
		line-height: 1;
	}

	.blog-eyebrow-dash {
		width: 0.875rem;
		height: 2px;
		background: var(--color-primary);
		border-radius: var(--radius-full);
	}

	.blog-title {
		max-width: 36rem;
		color: var(--color-text);
		font-size: var(--font-size-3xl);
		font-weight: 700;
		line-height: 1.08;
		letter-spacing: -0.04em;
		text-wrap: balance;
	}

	.blog-title-lead {
		color: color-mix(in srgb, var(--color-text) 52%, transparent);
	}

	.blog-intro {
		max-width: 26rem;
		color: color-mix(in srgb, var(--color-text) 72%, transparent);
		font-size: var(--font-size-base);
		line-height: 1.6;
		text-wrap: pretty;
	}

	.blog-intro-group {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-md);
	}

	.blog-tags-link {
		color: color-mix(in srgb, var(--color-primary) 72%, #000);
		font-size: var(--font-size-sm);
		font-weight: 650;
		border-radius: var(--radius-sm);
	}

	:global(:root.dark) .blog-tags-link {
		color: var(--color-primary);
	}

	@media (prefers-color-scheme: dark) {
		:global(:root:not(.light)) .blog-tags-link {
			color: var(--color-primary);
		}
	}

	.blog-earlier {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-lg);
		margin-top: var(--spacing-md);
	}

	.blog-section-title {
		color: var(--color-text);
		font-size: var(--font-size-sm);
		font-weight: 600;
		line-height: 1;
		letter-spacing: 0;
	}

	.blog-empty {
		padding: var(--spacing-3xl) var(--spacing-xl);
		text-align: center;
		background: var(--color-surface);
		border: 1px dashed var(--color-border);
		border-radius: 18px;
	}

	.blog-empty h2 {
		margin-bottom: var(--spacing-sm);
		font-size: var(--font-size-xl);
		font-weight: 600;
	}

	.blog-empty p {
		margin-bottom: var(--spacing-lg);
		color: color-mix(in srgb, var(--color-text) 72%, transparent);
	}

	@media (min-width: 640px) {
		.blog-title {
			font-size: var(--font-size-4xl);
		}
	}

	@media (min-width: 1024px) {
		.blog {
			padding-top: 10rem;
		}

		.blog-container {
			gap: var(--spacing-3xl);
		}

		.blog-header {
			grid-template-columns: minmax(0, 1.75fr) minmax(0, 1fr);
			align-items: end;
			gap: var(--spacing-2xl);
		}

		.blog-intro-group {
			justify-self: end;
		}
	}

	@media (max-width: 639.98px) {
		.blog {
			padding-top: 7.5rem;
		}
	}
</style>
