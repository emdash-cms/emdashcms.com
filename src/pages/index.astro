---
import { getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import MarketingBlocks from "../components/MarketingBlocks.astro";
import { faqItems, withCapabilities } from "../lib/home";
import { negotiatedMarkdown, varyOnAccept } from "../lib/markdown";

// Agents that prefer Markdown get the page's twin at this same URL.
const markdown = await negotiatedMarkdown(Astro.request, Astro.url.pathname, (path) => Astro.rewrite(path));
if (markdown) return markdown;
varyOnAccept(Astro.response.headers);

const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

Astro.response.headers.set(
	"Link",
	[
		'<https://docs.emdashcms.com/>; rel="service-doc"',
		'</index.md>; rel="alternate"; type="text/markdown"',
		'</llms.txt>; rel="describedby"; type="text/plain"; title="llms.txt"',
		'<https://docs.emdashcms.com/llms.txt>; rel="describedby"; type="text/plain"',
		'</start.md>; rel="describedby"; type="text/markdown"; title="Build a site with EmDash"',
		'</.well-known/ai-catalog.json>; rel="ai-catalog"; type="application/ai-catalog+json"',
	].join(", "),
);

const pageTitle = page?.data.title;
const description = "An open source Astro CMS built for humans and agents.";

const pageContent = withCapabilities(page?.data.content);

const siteUrl = new URL("/", Astro.site ?? Astro.url).href;
const faq = faqItems(pageContent);
const structuredData: Record<string, unknown>[] = [
	{
		"@type": "SoftwareApplication",
		"@id": `${siteUrl}#software`,
		name: "EmDash",
		alternateName: "EmDash CMS",
		description:
			"An open source, full-stack TypeScript CMS for Astro and the spiritual successor to WordPress, with an MCP server on every site and sandboxed plugins.",
		url: siteUrl,
		applicationCategory: "DeveloperApplication",
		applicationSubCategory: "Content management system",
		operatingSystem: "Cloudflare Workers, Node.js",
		license: "https://opensource.org/licenses/MIT",
		isAccessibleForFree: true,
		offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
		downloadUrl: "https://www.npmjs.com/package/emdash",
		installUrl: "https://docs.emdashcms.com",
		softwareHelp: { "@type": "CreativeWork", url: "https://docs.emdashcms.com" },
		sameAs: ["https://github.com/emdash-cms/emdash", "https://www.npmjs.com/package/emdash"],
		publisher: { "@id": `${siteUrl}#organization` },
	},
	...(faq.length > 0
		? [
				{
					"@type": "FAQPage",
					"@id": `${siteUrl}#faq`,
					mainEntity: faq.map((item) => ({
						"@type": "Question",
						name: item.question,
						acceptedAnswer: { "@type": "Answer", text: item.answer },
					})),
				},
			]
		: []),
];
---

<Base
	title={pageTitle !== "Home" ? pageTitle : undefined}
	description={description}
	content={page ? { collection: "pages", id: page.data.id, slug: page.id } : undefined}
	markdown="/index.md"
	structuredData={structuredData}
>
	{
		pageContent ? (
			<MarketingBlocks value={pageContent} />
		) : (
			<div class="empty-state">
				<h1>Welcome to EmDash CMS</h1>
				<p>Edit the home page content in the admin to get started.</p>
				<a href="/_emdash/admin" class="btn btn-primary">
					Open Admin
				</a>
			</div>
		)
	}
</Base>

<style>
	.empty-state {
		text-align: center;
		padding: var(--spacing-5xl) var(--spacing-lg);
		max-width: var(--max-width);
		margin: 0 auto;
	}

	.empty-state h1 {
		margin-bottom: var(--spacing-md);
	}

	.empty-state p {
		color: var(--color-muted);
		margin-bottom: var(--spacing-xl);
	}
</style>
