---
import { getEmDashEntry, type PortableTextBlock } from "emdash";
import Base from "../layouts/Base.astro";
import MarketingBlocks from "../components/MarketingBlocks.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const pageTitle = page?.data.title;

// Home content created before the capabilities block existed does not contain
// one. Until an editor inserts it, render the default section directly before
// the first features block. Once the block is in the content, its position
// and headline come from the CMS. Because the fallback re-applies whenever the
// block is absent, removing the section from the page also means deleting
// this helper; it can go once production content includes the block.
function withCapabilities(content: PortableTextBlock[] | undefined) {
	if (!content || content.some((block) => block._type === "marketing.capabilities")) return content;
	const featuresIndex = content.findIndex((block) => block._type === "marketing.features");
	if (featuresIndex < 0) return content;
	const capabilities: PortableTextBlock = { _type: "marketing.capabilities", _key: "capabilities" };
	return [...content.slice(0, featuresIndex), capabilities, ...content.slice(featuresIndex)];
}

const pageContent = withCapabilities(page?.data.content);
---

<Base
	title={pageTitle !== "Home" ? pageTitle : undefined}
	description="An open source Astro CMS built for humans and agents."
>
	{
		pageContent ? (
			<MarketingBlocks value={pageContent} />
		) : (
			<div class="empty-state">
				<h1>Welcome to EmDash CMS</h1>
				<p>Edit the home page content in the admin to get started.</p>
				<a href="/_emdash/admin" class="btn btn-primary">
					Open Admin
				</a>
			</div>
		)
	}
</Base>

<style>
	.empty-state {
		text-align: center;
		padding: var(--spacing-5xl) var(--spacing-lg);
		max-width: var(--max-width);
		margin: 0 auto;
	}

	.empty-state h1 {
		margin-bottom: var(--spacing-md);
	}

	.empty-state p {
		color: var(--color-muted);
		margin-bottom: var(--spacing-xl);
	}
</style>
