---
import Base from "../layouts/Base.astro";
---

<Base
	title="Media Library"
	description="Organize images and files alongside your content in EmDash. Add alt text, inspect supported usage references, and work with media from the admin or an agent."
	image="https://emdashcms.com/social/media-library.png"
	imageAlt="EmDash media library folders, image cards, and file details."
>
	<section class="media-hero">
		<div class="media-container">
			<nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">EmDash</a><span aria-hidden="true">/</span><span>Media library</span></nav>
			<div class="hero-copy">
				<p class="eyebrow">Media library</p>
				<h1>A media library for the whole story.</h1>
				<p class="hero-lead">Upload, organize, and describe your files next to the content that uses them. EmDash gives editors a clear library and agents the same media workflow through its APIs.</p>
				<div class="hero-actions">
					<a class="btn btn-primary btn-lg" href="https://try.emdashcms.com/">Try the playground <span aria-hidden="true">↗</span></a>
					<a class="text-link" href="https://docs.emdashcms.com/guides/media-library/">Read the media guide <span aria-hidden="true">↗</span></a>
				</div>
			</div>
			<figure class="media-stage">
				<div class="library-window" aria-hidden="true">
					<div class="window-bar"><span class="window-brand"><span class="brand-mark">▤</span> Media Library</span><span class="window-upload">＋ Upload Files</span></div>
					<div class="library-body">
						<div class="library-filters"><span class="library-search"><svg viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg> Search by filename...</span><span class="library-type">All types ⌄</span><span class="library-view">▦</span></div>
						<div class="library-folders"><div class="folder-heading"><strong>Folders</strong><span>＋ Add new folder</span></div><div class="folder-tiles"><span class="folder-tile"><svg viewBox="0 0 20 20" fill="none"><path d="M2.5 5.5h5l1.5 1.8h8.5v8.2H2.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg> Campaign</span><span class="folder-tile"><svg viewBox="0 0 20 20" fill="none"><path d="M2.5 5.5h5l1.5 1.8h8.5v8.2H2.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg> Editorial</span><span class="folder-tile"><svg viewBox="0 0 20 20" fill="none"><path d="M2.5 5.5h5l1.5 1.8h8.5v8.2H2.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg> Brand</span></div></div>
						<div class="asset-area"><div class="asset-toolbar"><strong>Files</strong><span>4 files</span></div>
							<div class="asset-grid">
								<div class="asset"><svg viewBox="0 0 190 134" preserveAspectRatio="xMidYMid slice"><rect width="190" height="134" fill="#e8ddd0"/><circle cx="148" cy="30" r="13" fill="#ff7840"/><path d="M0 106 59 49l38 41 29-30 64 60v14H0Z" fill="#aaa897"/><path d="M0 117 51 76l48 43 42-28 49 39v4H0Z" fill="#606e62"/></svg><span>landscape.jpg</span></div>
								<div class="asset"><svg viewBox="0 0 190 134" preserveAspectRatio="xMidYMid slice"><rect width="190" height="134" fill="#d9d9c7"/><rect x="16" y="15" width="158" height="104" rx="3" fill="#f3eee4"/><path d="M16 89h158v30H16Z" fill="#303e32"/><path d="M30 40h75M30 52h55" stroke="#334b39" stroke-width="5"/><circle cx="139" cy="53" r="19" fill="#ff7439"/></svg><span>launch-cover.png</span></div>
								<div class="asset"><svg viewBox="0 0 190 134" preserveAspectRatio="xMidYMid slice"><rect width="190" height="134" fill="#bec3b5"/><rect x="22" y="13" width="146" height="108" rx="50" fill="#506558"/><path d="M44 77c35-60 67-46 102-12M39 99c35-60 67-46 102-12" stroke="#f1d4a7" stroke-width="4" fill="none"/><circle cx="135" cy="40" r="11" fill="#ff7840"/></svg><span>detail.webp</span></div>
								<div class="asset"><svg viewBox="0 0 190 134" preserveAspectRatio="xMidYMid slice"><rect width="190" height="134" fill="#eacbb6"/><path d="M0 97c34-53 67-13 96-65 31 59 53 30 94 80v22H0Z" fill="#b8684b"/><path d="M0 119c35-39 70-21 91-53 38 42 60 17 99 54v14H0Z" fill="#724e49"/></svg><span>cover-02.jpg</span></div>
							</div></div>
					</div>
				</div>
				<div class="detail-card" aria-hidden="true"><div class="detail-top"><span class="detail-icon">▧</span><span>landscape.jpg</span><span class="detail-more">•••</span></div><div class="detail-image"><svg viewBox="0 0 260 102" preserveAspectRatio="xMidYMid slice"><rect width="260" height="102" fill="#e8ddd0"/><circle cx="212" cy="20" r="12" fill="#ff7840"/><path d="M0 90 79 24l49 45 53-35 79 63v5H0Z" fill="#a8a999"/><path d="M0 98 64 54l62 44 66-27 68 31H0Z" fill="#5e7262"/></svg></div><div class="detail-label">ALT TEXT</div><div class="detail-alt">Mountain ridge at sunset</div><div class="detail-usage"><span class="usage-light"></span><span>Used in <strong>2 content entries</strong></span><span>↗</span></div></div>
				<figcaption>An illustration of an EmDash media workflow, not a screenshot of the admin.</figcaption>
			</figure>
		</div>
	</section>

	<section class="media-details" aria-labelledby="details-heading">
		<div class="media-container">
			<header class="section-heading"><p class="eyebrow">More than storage</p><h2 id="details-heading">The file is only half the story.</h2><p>A useful library holds the information people need to find, understand, and safely reuse an asset.</p></header>
			<div class="detail-grid">
				<article class="detail-feature detail-feature--wide"><div class="organize-copy"><span class="feature-kicker">01 / Organize</span><h3>Find the right file.</h3><p>Keep assets in folders, browse the library, and filter by filename or file type. Images and documents belong in the same place as your content.</p></div><div class="organize-scene" aria-hidden="true"><div class="organize-filter"><svg viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="m13 13 4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg><span>landscape</span><span>All types ⌄</span></div><div class="organize-flow"><span class="organize-folder"><svg viewBox="0 0 20 20" fill="none"><path d="M2.5 5.5h5l1.5 1.8h8.5v8.2H2.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg> Campaign</span><svg class="organize-wire" viewBox="0 0 120 40" fill="none"><path d="M3 20h111m-8-7 8 7-8 7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span class="organize-result"><svg viewBox="0 0 70 56" preserveAspectRatio="xMidYMid slice"><rect width="70" height="56" fill="#e8ddd0"/><circle cx="54" cy="13" r="7" fill="#ff7840"/><path d="M0 46 22 18l17 20 12-14 19 23v9H0Z" fill="#667665"/></svg><span><strong>landscape.jpg</strong><small>Image</small></span></span></div></div></article>
				<article class="detail-feature"><span class="feature-kicker">02 / Describe</span><h3>Make every image useful.</h3><p>Add alt text and captions as part of the media workflow—not as an afterthought in each page.</p><div class="alt-illustration" aria-hidden="true"><span>ALT TEXT</span><strong>Mountain ridge at sunset</strong><span class="alt-caret"></span></div></article>
				<article class="detail-feature"><span class="feature-kicker">03 / Trace</span><h3>See where it appears.</h3><p>Check supported content references and site settings before replacing or removing an image. Usage coverage is shown in the admin so you know when the index is incomplete.</p><div class="usage-illustration" aria-hidden="true"><span>landscape.jpg</span><svg viewBox="0 0 220 66" fill="none"><path d="M10 0v40q0 8 8 8h190M10 18h198" stroke="currentColor" stroke-width="1.5"/><circle cx="208" cy="18" r="5" fill="currentColor"/><circle cx="208" cy="48" r="5" fill="currentColor"/></svg><span>About page &nbsp;·&nbsp; Launch post</span></div></article>
			</div>
		</div>
	</section>

	<section class="agent-section" aria-labelledby="agent-heading"><div class="media-container agent-layout"><div class="agent-copy"><p class="eyebrow">One library, two collaborators</p><h2 id="agent-heading">An editor can see it. An agent can work with it.</h2><p>EmDash exposes media operations through its API and MCP tools. An agent can browse files, upload an image, and update metadata while editors keep a visual place to manage the same assets.</p><a class="text-link" href="https://docs.emdashcms.com/guides/ai-tools/">Explore agent workflows <span aria-hidden="true">↗</span></a></div><div class="agent-diagram" aria-hidden="true"><div class="diagram-side"><span class="diagram-icon">◎</span><strong>Editor</strong><span>Visual library</span></div><svg viewBox="0 0 320 120" preserveAspectRatio="none" fill="none"><path d="M0 60h320" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 7"/><circle cx="160" cy="60" r="5" fill="currentColor"/></svg><div class="diagram-center">▧<span>Media item</span></div><div class="diagram-side"><span class="diagram-icon">✳</span><strong>Agent</strong><span>API + MCP</span></div></div></div></section>

	<section class="media-faq" aria-labelledby="faq-heading"><div class="media-container"><div class="faq-heading"><p class="eyebrow">Questions</p><h2 id="faq-heading">The practical details.</h2></div><div class="faq-list"><details><summary>What can I keep in the media library?</summary><p>Images and other supported file types, including documents. The allowed MIME types and upload size depend on your site configuration.</p></details><details><summary>Can I organize assets into folders?</summary><p>Yes. EmDash supports creating, renaming, and deleting media folders, and filtering the library by folder.</p></details><details><summary>Can I tell which content uses an image?</summary><p>The usage view reports references in supported EmDash fields and selected site settings. It also reports coverage status, so an incomplete index is not mistaken for “unused.” References in custom code or external sites are outside that index.</p></details></div></div></section>
	<section class="media-cta"><div class="media-container"><div><p class="eyebrow">Build with EmDash</p><h2>Content and media, finally in the same workflow.</h2></div><a class="btn btn-primary btn-lg" href="https://try.emdashcms.com/">Try the playground <span aria-hidden="true">↗</span></a></div></section>
</Base>

<style>
	.media-container { width: min(calc(100% - 3rem), var(--wide-width)); margin-inline: auto; }
	.media-hero { overflow: hidden; padding: 8.75rem 0 clamp(2.5rem, 4vw, 4rem); background: color-mix(in srgb, var(--color-bg) 68%, var(--color-surface)); }
	.media-hero .media-container { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); align-items: center; column-gap: clamp(2rem, 4vw, 4rem); }
	.breadcrumbs { display: flex; grid-column: 1 / -1; align-items: center; gap: 0.8rem; color: var(--color-muted); font-size: 0.78rem; }
	.breadcrumbs a { color: inherit; }
	.breadcrumbs a:hover { color: var(--color-primary); }
	.hero-copy { display: grid; min-width: 0; gap: 1.5rem; margin: clamp(3rem, 6vw, 5rem) 0; }
	.eyebrow { color: var(--color-primary); font-size: 0.76rem; font-weight: 650; letter-spacing: 0.045em; text-transform: uppercase; }
	h1, h2, h3 { font-weight: 600; letter-spacing: -0.05em; text-wrap: balance; }
	h1 { font-size: clamp(3rem, 5vw, 5.2rem); line-height: 1.03; }
	.hero-lead { max-width: 32rem; color: var(--color-muted); font-size: clamp(1.08rem, 1.4vw, 1.2rem); line-height: 1.6; }
	.hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.75rem; margin-top: 0.5rem; }
	.hero-actions .btn { display: inline-flex; align-items: center; gap: 0.7rem; }
	.text-link { display: inline-flex; align-items: center; gap: 0.5rem; color: var(--color-text); font-size: 0.9rem; font-weight: 600; text-decoration: none; }
	.text-link:hover { color: var(--color-primary); }
	.text-link:focus-visible, .breadcrumbs a:focus-visible { outline: 2px solid var(--color-primary); outline-offset: 5px; border-radius: 2px; }
	.media-stage { position: relative; min-width: 0; min-height: 35rem; margin: 0; padding: 3rem 2rem 5rem; overflow: hidden; border: 1px solid var(--color-border); border-radius: 1.25rem; background: radial-gradient(ellipse at 72% 45%, var(--heat-12), transparent 54%), var(--color-surface); }
	.media-stage::before { position: absolute; inset: 0; background-image: radial-gradient(color-mix(in srgb, var(--color-text) 12%, transparent) 0.7px, transparent 0.7px); background-size: 19px 19px; content: ""; mask-image: linear-gradient(90deg, transparent, black 50%, transparent); }
	.library-window { position: relative; width: 76%; min-height: 28rem; overflow: hidden; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.8rem; box-shadow: 0 24px 80px color-mix(in srgb, var(--color-text) 11%, transparent); }
	.window-bar, .asset-toolbar, .detail-top { display: flex; align-items: center; gap: 0.7rem; }
	.window-bar { height: 3.2rem; padding-inline: 1.2rem; border-bottom: 1px solid var(--color-border); font-size: 0.76rem; }
	.window-brand { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 650; }
	.brand-mark { display: grid; width: 1.35rem; height: 1.35rem; place-items: center; color: var(--color-primary); background: var(--heat-8); border-radius: 0.3rem; }
	.window-upload { margin-inline-start: auto; padding: 0.35rem 0.6rem; color: var(--button-primary-fg); background: var(--heat-100); border-radius: 0.35rem; font-size: 0.68rem; font-weight: 600; }
	.library-body { display: flex; min-height: 25rem; flex-direction: column; gap: 1.1rem; padding: 1rem; }
	.library-filters { display: flex; align-items: center; gap: 0.45rem; color: var(--color-muted); font-size: 0.65rem; }
	.library-search, .library-type, .library-view { display: flex; height: 2rem; align-items: center; padding: 0 0.55rem; border: 1px solid var(--color-border); border-radius: 0.35rem; white-space: nowrap; }
	.library-search { min-width: 0; flex: 1; gap: 0.35rem; overflow: hidden; }
	.library-search svg { width: 0.9rem; flex: none; }
	.library-type, .library-view { flex: none; }
	.library-view { color: var(--color-text); font-size: 0.95rem; }
	.folder-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; font-size: 0.72rem; }
	.folder-heading span { color: var(--color-muted); font-size: 0.61rem; }
	.folder-tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.45rem; }
	.folder-tile { display: flex; min-width: 0; align-items: center; gap: 0.3rem; overflow: hidden; padding: 0.7rem 0.5rem; border: 1px solid var(--color-border); border-radius: 0.35rem; font-size: 0.65rem; font-weight: 600; white-space: nowrap; }
	.folder-tile svg { width: 1rem; flex: none; color: var(--color-primary); }
	.asset-area { min-width: 0; }
	.asset-toolbar { justify-content: space-between; margin-bottom: 0.65rem; font-size: 0.76rem; }
	.asset-toolbar span { color: var(--color-muted); font-size: 0.68rem; }
	.asset-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
	.asset { min-width: 0; overflow: hidden; background: var(--color-bg); border: 1px solid var(--color-border); border-radius: 0.55rem; }
	.asset svg { display: block; width: 100%; aspect-ratio: 190 / 134; object-fit: cover; }
	.asset > span { display: block; overflow: hidden; padding: 0.65rem; font-size: 0.68rem; font-weight: 550; text-overflow: ellipsis; white-space: nowrap; }
	.detail-card { position: absolute; top: 22%; right: 3.5%; width: 32%; min-width: 15rem; overflow: hidden; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.8rem; box-shadow: 0 27px 80px color-mix(in srgb, var(--color-text) 16%, transparent); transform: rotate(3deg); }
	.detail-top { padding: 0.85rem; border-bottom: 1px solid var(--color-border); font-size: 0.72rem; font-weight: 650; }
	.detail-icon { color: var(--color-primary); font-size: 1.1rem; }
	.detail-more { margin-inline-start: auto; color: var(--color-muted); }
	.detail-image { margin: 1rem 1rem 0; overflow: hidden; border-radius: 0.35rem; }
	.detail-image svg { display: block; width: 100%; }
	.detail-label { margin: 1rem 1rem 0.35rem; color: var(--color-muted); font-size: 0.59rem; font-weight: 650; letter-spacing: 0.06em; }
	.detail-alt { margin: 0 1rem 1rem; padding: 0.65rem; border: 1px solid var(--color-border); border-radius: 0.35rem; font-size: 0.68rem; }
	.detail-usage { display: flex; align-items: center; gap: 0.45rem; padding: 0.9rem 1rem; border-top: 1px solid var(--color-border); font-size: 0.65rem; }
	.detail-usage > span:last-child { margin-inline-start: auto; color: var(--color-primary); }
	.usage-light { width: 0.42rem; height: 0.42rem; background: var(--color-primary); border-radius: 50%; }
	.media-stage figcaption { position: absolute; bottom: 1.25rem; left: 3rem; color: var(--color-muted); font-size: 0.67rem; }
	.media-details { padding: clamp(3.5rem, 6vw, 6rem) 0 clamp(5rem, 9vw, 9rem); }
	.media-faq { padding: clamp(5rem, 9vw, 9rem) 0; }
	.section-heading { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.7fr); align-items: end; gap: 1rem 4rem; margin-bottom: 3rem; }
	.section-heading .eyebrow { grid-column: 1 / -1; }
	h2 { max-width: 40rem; font-size: clamp(2.6rem, 5vw, 5rem); line-height: 1.07; }
	.section-heading > p:last-child { max-width: 30rem; color: var(--color-muted); font-size: 1.05rem; line-height: 1.6; }
	.detail-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
	.detail-feature { display: flex; min-height: 24rem; flex-direction: column; overflow: hidden; padding: clamp(1.6rem, 3vw, 2.5rem); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
	.detail-feature--wide { display: grid; grid-column: 1 / -1; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: stretch; gap: 2rem; min-height: 22rem; }
	.feature-kicker { color: var(--color-primary); font-family: ui-monospace, SFMono-Regular, monospace; font-size: 0.68rem; }
	h3 { margin-top: 1.3rem; font-size: clamp(1.7rem, 3vw, 2.6rem); line-height: 1.12; }
	.detail-feature > p { max-width: 31rem; margin-top: 0.7rem; color: var(--color-muted); font-size: 0.94rem; line-height: 1.6; }
	.organize-copy p { max-width: 31rem; margin-top: 0.7rem; color: var(--color-muted); font-size: 0.94rem; line-height: 1.6; }
	.organize-scene { display: flex; min-width: 0; min-height: 17rem; flex-direction: column; gap: 1rem; padding: 1.2rem; background: radial-gradient(ellipse at 68% 65%, var(--heat-8), transparent 65%), var(--color-bg); border: 1px solid var(--color-border); border-radius: 0.75rem; }
	.organize-filter { display: flex; min-width: 0; height: 2.5rem; align-items: center; gap: 0.55rem; padding: 0 0.7rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.4rem; color: var(--color-muted); font-size: 0.7rem; }
	.organize-filter svg { width: 1rem; flex: none; }
	.organize-filter span:nth-child(2) { min-width: 0; flex: 1; overflow: hidden; color: var(--color-text); text-overflow: ellipsis; white-space: nowrap; }
	.organize-filter span:last-child { padding-inline-start: 0.6rem; border-inline-start: 1px solid var(--color-border); white-space: nowrap; }
	.organize-flow { display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; margin-block: auto; }
	.organize-folder, .organize-result { display: flex; align-items: center; gap: 0.5rem; padding: 0.75rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.55rem; box-shadow: 0 12px 28px color-mix(in srgb, var(--color-text) 5%, transparent); }
	.organize-folder { flex: none; font-size: 0.77rem; font-weight: 600; transform: rotate(-3deg); }
	.organize-folder svg { width: 1.3rem; color: var(--color-primary); }
	.organize-wire { min-width: 1rem; max-width: 7rem; flex: 1; color: var(--color-primary); }
	.organize-result { min-width: 0; transform: rotate(2deg); }
	.organize-result > svg { width: 3.5rem; flex: none; border-radius: 0.3rem; }
	.organize-result > span { display: flex; min-width: 0; flex-direction: column; gap: 0.25rem; }
	.organize-result strong { overflow: hidden; font-size: 0.72rem; text-overflow: ellipsis; white-space: nowrap; }
	.organize-result small { color: var(--color-muted); font-size: 0.62rem; white-space: nowrap; }
	.alt-illustration, .usage-illustration { display: flex; min-height: 9rem; flex-direction: column; justify-content: center; margin-top: auto; padding-top: 2rem; }
	.alt-illustration span:first-child { color: var(--color-muted); font-size: 0.64rem; font-weight: 600; letter-spacing: 0.06em; }
	.alt-illustration strong { width: fit-content; max-width: 100%; margin-top: 0.6rem; padding: 0.85rem 1rem; background: var(--color-bg); border: 1px solid var(--heat-40); border-radius: 0.5rem; font-size: 0.8rem; font-weight: 550; }
	.alt-caret { width: 1px; height: 1.2rem; margin-top: -1.9rem; margin-inline-start: min(15.6rem, 85%); background: var(--color-primary); }
	.usage-illustration { align-items: flex-start; color: var(--color-muted); font-family: ui-monospace, SFMono-Regular, monospace; font-size: 0.69rem; }
	.usage-illustration svg { width: min(15rem, 100%); height: 3rem; margin: 0.6rem 0; color: var(--color-primary); }
	.agent-section { padding: clamp(5rem, 8vw, 8rem) 0; background: color-mix(in srgb, var(--color-bg) 55%, var(--color-surface)); border-block: 1px solid var(--color-border); }
	.agent-layout { display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); align-items: center; gap: clamp(3rem, 7vw, 8rem); }
	.agent-copy h2 { margin: 1.2rem 0; }
	.agent-copy > p:not(.eyebrow) { max-width: 33rem; color: var(--color-muted); font-size: 1.05rem; line-height: 1.65; }
	.agent-copy .text-link { margin-top: 2rem; }
	.agent-diagram { position: relative; display: flex; min-height: 21rem; align-items: end; justify-content: space-between; padding: 2rem; overflow: hidden; background: radial-gradient(ellipse at center, var(--heat-12), transparent 60%), var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
	.agent-diagram svg { position: absolute; top: 39%; left: 15%; width: 70%; height: 5rem; color: var(--color-primary); }
	.diagram-side, .diagram-center { z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 0.25rem; background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 0.7rem; }
	.diagram-side { width: 8rem; padding: 1rem 0.5rem; }
	.diagram-side strong { font-size: 0.76rem; }
	.diagram-side > span:last-child { color: var(--color-muted); font-size: 0.66rem; }
