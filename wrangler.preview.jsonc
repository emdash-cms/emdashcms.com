{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "emdashcms-com-redesign-preview",
	"main": "./dist/server/entry.mjs",
	"no_bundle": true,
	"rules": [
		{
			"type": "ESModule",
			"globs": [
				"**/*.js",
				"**/*.mjs"
			]
		}
	],
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"account_id": "1f74638c495bc9f0330ce5c8e64c1b6b",
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist/client"
	},
	"placement": {
		"region": "aws:us-east-1"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "4cf02f7023864d6c88572b59a20dd7ab"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "emdashcms-com",
			"database_id": "bf5bdaf9-ea37-45b1-bca4-b40e4e8e729f"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "emdashcms-com-media"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	]
}
